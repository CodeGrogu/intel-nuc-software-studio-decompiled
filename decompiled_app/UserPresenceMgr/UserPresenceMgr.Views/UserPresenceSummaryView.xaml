<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="UserPresenceMgr.Views.UserPresenceSummaryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:UserPresenceMgr.Views" xmlns:controls="clr-namespace:Infrastructure.Controls;assembly=Infrastructure" xmlns:prism="http://prismlibrary.com/" ViewModelLocator.AutoWireViewModel="True">
  <Grid Background="{StaticResource CardBackgroundBrush}">
    <ItemsControl Style="{StaticResource CardGridItemsStyle}">
      <controls:CardTitleBarControl Grid.Row="1" Grid.Column="1" IconCanvas="{StaticResource SystemCardIcon}" TitleText="{StaticResource UserPresenceTitleString}" CustomIcon="{Binding DataContext.CustomIconSource, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}" OpenDetailView="{Binding Path=DataContext.OpenDetailView, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
      <Viewbox Grid.Row="3" Grid.Column="1" VerticalAlignment="Top">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <local:HumanPresenceWalControl DataContext="{Binding LockFeatures}" />
          <local:HumanPresenceWoaControl Grid.Row="2" HorizontalContentAlignment="Stretch" DataContext="{Binding WakeFeatures}" />
          <local:HumanPresenceNlopControl Grid.Row="4" HorizontalContentAlignment="Stretch" DataContext="{Binding NoLockOnPresenceFeatures}" />
        </Grid>
      </Viewbox>
    </ItemsControl>
  </Grid>
</UserControl>