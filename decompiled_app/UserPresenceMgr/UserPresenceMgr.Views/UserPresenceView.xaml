<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="UserPresenceMgr.Views.UserPresenceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:UserPresenceMgr.Views" xmlns:controls="clr-namespace:Infrastructure.Controls;assembly=Infrastructure" xmlns:prism="http://prismlibrary.com/" ViewModelLocator.AutoWireViewModel="True">
  <Grid Background="{StaticResource CardBackgroundBrush}">
    <ItemsControl Style="{StaticResource DetailCardGridItemsStyle}">
      <controls:DetailCardTitleBarControl Grid.Column="1" Grid.Row="1" IconCanvas="{StaticResource SystemCardIcon}" TitleText="{StaticResource UserPresenceTitleString}" CustomIcon="{Binding DataContext.CustomIconSource, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}" />
      <Rectangle Grid.Column="1" Grid.Row="3" Style="{StaticResource HorizontalSeparator}" />
      <Viewbox Grid.Column="1" Grid.Row="5" VerticalAlignment="Top" HorizontalAlignment="Left">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="40" />
            <ColumnDefinition />
            <ColumnDefinition Width="40" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <local:HumanPresenceWalControl DataContext="{Binding LockFeatures}" />
          <local:HumanPresenceWoaControl Grid.Column="2" DataContext="{Binding WakeFeatures}" />
          <local:HumanPresenceNlopControl Grid.Column="4" DataContext="{Binding NoLockOnPresenceFeatures}" />
        </Grid>
      </Viewbox>
    </ItemsControl>
  </Grid>
</UserControl>