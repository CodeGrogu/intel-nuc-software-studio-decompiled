<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:MobileDisplayModeMgr.Converters">
  <converters:MatchingModesConverter x:Key="MatchingModesConverter" />
  <converters:ModeTypeToStringConverter x:Key="ModeTypeToStringConverter" />
  <Style x:Key="DisplayModeMainText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource KcAppTitleText}">
    <Setter Property="FontSize" Value="28" />
  </Style>
  <ControlTemplate x:Key="DisplayModeSlider" TargetType="{x:Type Slider}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" MinHeight="{TemplateBinding FrameworkElement.MinHeight}" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TickBar Name="TopTick" SnapsToDevicePixels="True" Placement="Top" Height="4" Visibility="Collapsed">
        <TickBar.Fill>
          <SolidColorBrush Color="{StaticResource TertiaryColor}" />
        </TickBar.Fill>
      </TickBar>
      <Border Name="TrackBackground" Background="#00FFFFFF" BorderThickness="1" Grid.Row="1" Height="10" CornerRadius="10" Style="{StaticResource SliderBackgroundBorder}">
        <Border.BorderBrush>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientBrush.GradientStops>
              <GradientStopCollection>
                <GradientStop Color="{DynamicResource SliderShadowColor}" Offset="0.15" />
                <GradientStop Color="Transparent" Offset="1.0" />
              </GradientStopCollection>
            </GradientBrush.GradientStops>
          </LinearGradientBrush>
        </Border.BorderBrush>
      </Border>
      <Track Name="PART_Track" Grid.Row="1">
        <Track.DecreaseRepeatButton>
          <RepeatButton Command="Slider.DecreaseLarge" Margin="0,0,-2,0">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type RepeatButton}" BasedOn="{StaticResource SliderButtonStyle}">
                <Setter Property="Background" Value="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Slider, Mode=FindAncestor}}" />
                <Style.Triggers>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource DisableSliderBarFill}" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </RepeatButton>
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb Name="Thumb" Style="{StaticResource KCSliderThumbStyle}" />
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderButtonStyle}" Background="{Binding Path=Background, RelativeSource={RelativeSource AncestorType=Slider, Mode=FindAncestor}}" />
        </Track.IncreaseRepeatButton>
      </Track>
      <TickBar Name="BottomTick" SnapsToDevicePixels="True" Grid.Row="2" Fill="{TemplateBinding Control.Foreground}" Placement="Bottom" Height="4" Visibility="Collapsed" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="Slider.TickPlacement" Value="TopLeft">
        <Setter TargetName="TopTick" Property="UIElement.Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="Slider.TickPlacement" Value="BottomRight">
        <Setter TargetName="BottomTick" Property="UIElement.Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="Slider.TickPlacement" Value="Both">
        <Setter TargetName="TopTick" Property="UIElement.Visibility" Value="Visible" />
        <Setter TargetName="BottomTick" Property="UIElement.Visibility" Value="Visible" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="MobileDisplaySlider" TargetType="{x:Type Slider}">
    <Setter Property="Focusable" Value="True" />
    <Setter Property="Slider.IsMoveToPointEnabled" Value="True" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="Slider.TickFrequency" Value="1" />
    <Setter Property="Slider.IsSnapToTickEnabled" Value="True" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Foreground" Value="{DynamicResource KCSliderForegroundBrush}" />
    <Style.Triggers>
      <Trigger Property="Slider.Orientation" Value="Horizontal">
        <Setter Property="Template" Value="{StaticResource DisplayModeSlider}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="NavButton" TargetType="{x:Type Button}">
    <Setter Property="FontFamily" Value="Intel Clear" />
    <Setter Property="FontSize" Value="25" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="ButtonBorder">
            <Viewbox>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition MinWidth="10" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition MinWidth="10" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="25" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="25" />
                </Grid.RowDefinitions>
                <ContentControl Grid.Column="1" Grid.Row="1" HorizontalContentAlignment="Left" HorizontalAlignment="Left" Width="500" VerticalContentAlignment="Center" VerticalAlignment="Center">
                  <ContentControl.Content>
                    <Grid>
                      <TextBlock Name="ModeType" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Grid>
                  </ContentControl.Content>
                </ContentControl>
              </Grid>
            </Viewbox>
          </Border>
          <ControlTemplate.Triggers>
            <DataTrigger Value="True">
              <DataTrigger.Binding>
                <MultiBinding Converter="{StaticResource MatchingModesConverter}">
                  <Binding Path="." />
                  <Binding Path="DataContext.CurrentMode" RelativeSource="{RelativeSource AncestorType=UserControl, AncestorLevel=1}" />
                </MultiBinding>
              </DataTrigger.Binding>
              <Setter TargetName="ButtonBorder" Value="{DynamicResource MainBackgroundBrush}" Property="Border.Background" />
              <Setter TargetName="ModeType" Value="{DynamicResource KCSliderForegroundBrush}" Property="TextBlock.Foreground" />
            </DataTrigger>
            <Trigger Property="UIElement.IsMouseOver" Value="False">
              <Setter Value="{DynamicResource CardBackgroundBrush}" Property="Background" />
              <Setter Value="{DynamicResource TransparentButtonDefaultTextBrush}" Property="Foreground" />
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="ModeType" Value="{DynamicResource KCSliderForegroundBrush}" Property="TextBlock.Foreground" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ButtonBorder" Value="{DynamicResource DisableControlBackground}" Property="Border.Background" />
              <Setter Value="{DynamicResource DisableControlForeground}" Property="Foreground" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <DataTemplate x:Key="SliderAndTextBlockTemplate">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="10" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Slider Style="{StaticResource MobileDisplaySlider}" />
      <TextBlock Text="Test" Grid.Column="2" />
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="MobileDisplayModeListBoxItemTemplate">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition Height="10" />
      </Grid.RowDefinitions>
      <RadioButton Foreground="{DynamicResource TitleBarLogoBrush}" FontSize="22" Style="{StaticResource RadioButtonControlBlue}" Content="{Binding Type, Converter={StaticResource ModeTypeToStringConverter}}" IsChecked="{Binding Path=IsSelected, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="MobileDisplayModeNavBarTemplate">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition />
      </Grid.RowDefinitions>
      <Button Style="{StaticResource NavButton}" Tag="{Binding Type, Converter={StaticResource ModeTypeToStringConverter}}" Command="{Binding DataContext.SelectMode, RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=1}}" CommandParameter="{Binding .}" />
    </Grid>
  </DataTemplate>
</ResourceDictionary>