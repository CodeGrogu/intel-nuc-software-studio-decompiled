<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="NucSoftwareStudio.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:prism="http://prismlibrary.com/" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:viewsInfr="clr-namespace:Infrastructure.Views;assembly=Infrastructure" ViewModelLocator.AutoWireViewModel="True" WindowStartupLocation="CenterOwner" WindowStyle="None" WindowState="Normal" AllowsTransparency="True" ResizeMode="CanResize" xmlns:views="clr-namespace:NucSoftwareStudio.Views;assembly=NucSoftwareStudio" Title="{Binding AppNameString}" Width="{Binding WindowWidth}" Height="{Binding WindowHeight}" SourceInitialized="WindowSetToForeground" Loaded="Window_Loaded">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="46" ResizeBorderThickness="10" CornerRadius="0" GlassFrameThickness="0" />
  </WindowChrome.WindowChrome>
  <Border>
    <FrameworkElement.Style>
      <Style TargetType="{x:Type Border}">
        <Setter Property="BorderBrush" Value="{DynamicResource WindowBorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
          <DataTrigger Value="Maximized" Binding="{Binding Path=WindowState, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}">
            <Setter Property="BorderThickness" Value="6" />
            <Setter Property="BorderBrush" Value="{DynamicResource TitleBarBackgroundBrush}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </FrameworkElement.Style>
    <Grid Background="{DynamicResource TitleBarBackgroundBrush}">
      <Grid.RowDefinitions>
        <RowDefinition Height="46" />
        <RowDefinition Height="10*" />
      </Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Viewbox HorizontalAlignment="Left">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="20" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="10" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="10" />
            </Grid.RowDefinitions>
            <Viewbox Grid.Row="1" Grid.Column="1" Width="36" Child="{StaticResource IntelLogo}" Visibility="{Binding ShowIntelLogo, Converter={StaticResource BoolToVis}}" />
            <Image Grid.Row="1" Grid.Column="1" Width="36" Margin="5" Source="{Binding AppLogo}" Visibility="{Binding ShowIntelLogo, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
            <TextBlock Grid.Column="3" Grid.Row="1" FontSize="22" Text="{Binding AppNameString}">
              <FrameworkElement.Style>
                <Style BasedOn="{StaticResource AppTitleText}" TargetType="{x:Type TextBlock}">
                  <Style.Triggers>
                    <DataTrigger Value="False" Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}">
                      <Setter Property="Foreground" Value="{DynamicResource DisableControlForeground}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </TextBlock>
          </Grid>
        </Viewbox>
        <Viewbox HorizontalAlignment="Right" Grid.Column="1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Row="1" Style="{StaticResource SettingsButton}" IsEnabled="{Binding ShowEula, Converter={StaticResource InverseBooleanConverter}}" Command="{Binding ShowSettings}" />
            <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource MinimizeButton}" Click="MinimizeButton_Click" />
            <Button Name="MaximizeButton" Grid.Row="1" Grid.Column="2" Style="{StaticResource MaximizeButton}" Click="MaximizeRestoreButton_Click" />
            <Button Name="RestoreButton" Grid.Row="1" Grid.Column="2" Style="{StaticResource RestoreButton}" Click="MaximizeRestoreButton_Click" />
            <Button Grid.Row="1" Grid.Column="3" Style="{StaticResource CloseAppButton}" Click="CloseButton_Click" />
          </Grid>
        </Viewbox>
      </Grid>
      <ContentControl prism:RegionManager.RegionName="MainContentRegion" Grid.Row="1" />
      <viewsInfr:MessagePrompt Name="ErrorPrompt" Grid.Row="1" Visibility="Collapsed" />
      <Rectangle Grid.Row="1" Fill="#FF000000" Opacity="0.75" Visibility="{Binding ShowEula, Converter={StaticResource BoolToVis}}" />
      <Grid Row="1" Visibility="{Binding ShowEula, Converter={StaticResource BoolToVis}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="3*" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition />
          <RowDefinition Height="4*" />
          <RowDefinition />
        </Grid.RowDefinitions>
        <Grid Column="1" Row="1" Background="{DynamicResource CardBackgroundBrush}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.05*" />
            <ColumnDefinition />
            <ColumnDefinition Width="0.05*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="0.1*" />
            <RowDefinition />
            <RowDefinition Height="0.1*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="0.1*" />
          </Grid.RowDefinitions>
          <RichTextBox Name="EulaTextBox" Grid.Column="1" Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource EulaTextBrush}" Focusable="False" VerticalScrollBarVisibility="Visible" Loaded="EulaTextBox_Loaded" ScrollViewer.ScrollChanged="EulaTextBox_Scroll">
            <FrameworkElement.Resources>
              <ResourceDictionary>
                <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource CustomScrollBar}" />
              </ResourceDictionary>
            </FrameworkElement.Resources>
            <FrameworkElement.Style>
              <Style TargetType="{x:Type RichTextBox}">
                <Style.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="False">
                    <Setter Property="BorderBrush" Value="#00FFFFFF" />
                    <Setter Property="BorderThickness" Value="0" />
                  </Trigger>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#00FFFFFF" />
                    <Setter Property="BorderThickness" Value="0" />
                  </Trigger>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="BorderBrush" Value="#00FFFFFF" />
                    <Setter Property="BorderThickness" Value="0" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </RichTextBox>
          <Grid Column="1" Row="3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Right">
              <Button Width="100" Height="25" Tag="{DynamicResource Close}" Style="{StaticResource RectangleButton}" Command="{Binding CloseEula}" />
            </Viewbox>
            <Viewbox Grid.Column="2" StretchDirection="DownOnly" HorizontalAlignment="Left">
              <Button Name="AcceptButton" Width="100" Height="25" Tag="{DynamicResource AcceptEula}" IsEnabled="True" Style="{StaticResource RectangleButton}" Command="{Binding AcceptEula}" />
            </Viewbox>
          </Grid>
        </Grid>
      </Grid>
      <Rectangle Grid.Row="1" Fill="#FF000000" Opacity="0.75" Visibility="{Binding SettingsVisible, Converter={StaticResource BoolToVis}}" />
      <Grid Row="1" Visibility="{Binding SettingsVisible, Converter={StaticResource BoolToVis}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="1*" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition />
          <RowDefinition Height="1*" />
          <RowDefinition />
        </Grid.RowDefinitions>
        <Grid Column="1" Row="1" Background="{DynamicResource CardBackgroundBrush}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.05*" />
            <ColumnDefinition />
            <ColumnDefinition Width="0.05*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="0.15*" />
            <RowDefinition />
            <RowDefinition Height="0.1*" />
            <RowDefinition />
            <RowDefinition Height="0.1*" />
          </Grid.RowDefinitions>
          <Button HorizontalAlignment="Right" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,6,0" Style="{StaticResource CloseButton}" Command="{Binding CloseSettings}" />
          <Viewbox Grid.Column="1" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" StretchDirection="DownOnly">
            <TextBlock Style="{StaticResource ColorPickerTitleText}" Text="{Binding Version}" />
          </Viewbox>
          <Viewbox Grid.Column="1" Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" StretchDirection="DownOnly">
            <TextBlock>
              <Hyperlink Style="{StaticResource HyperlinkText}" Command="{Binding LicensesClicked}">
                <TextBlock Text="{Binding Licenses}" />
              </Hyperlink>
            </TextBlock>
          </Viewbox>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>