<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="DeprecatedConfigNames" type="System.Configuration.NameValueSectionHandler" />
  </configSections>
  <DeprecatedConfigNames>
    <add key="WSDualHttpBinding_ISystemMonitorServiceContract" value="2/18/2022" />
    <add key="NetNamedPipeBinding_ISystemMonitorServiceContract" value="" />
  </DeprecatedConfigNames>
  <startup></startup>
  <appSettings>
    <!-- Just using the first 2 characters of the following BIOS IDs -->
    <!-- Bishop County: BCTGLV57, BCTGL357 -->
    <!-- Elk Bay (Camden County): EBTGL357, EBTGLMIV -->
    <!-- Panther: PATGL357 -->
    <!-- Phantom: PHTGL579 -->
    <!-- Beast Canyon: DBTGL579, DBTGLX70 -->
    <!-- King County: KCCML357, KCTGL357 -->
    <!-- DC and DC Pro: EDADL579, EDADLMIV -->
    <!-- Rooks County: RCADL357, RCADLV57 ...Not supported right now!-->
    <!-- Alder County: ACADL357 ...Not supported right now!-->
    <!-- Shrike Bay(Raptor Canyon): SBRPL579 -->
    <add key="NssServiceSupportedBiosIds" value="          BC,          EB,          PA,          PH,          DB,          ED,   SN,   HB,   SB     " />
    <add key="UniwillSupportedBiosIds" value="          KC     " />
  </appSettings>
  <system.serviceModel>
    <bindings>
      <netNamedPipeBinding>
        <binding name="NetNamedPipeBinding_ISystemMonitorServiceContract" />
      </netNamedPipeBinding>
      <wsDualHttpBinding>
        <binding name="WSDualHttpBinding_ISystemMonitorServiceContract" />
      </wsDualHttpBinding>
      <wsHttpBinding>
        <binding name="WSHttpBinding_IAppSettingsServiceContract" />
        <binding name="WSHttpBinding_IAlexaSettingsServiceContract" />
        <binding name="WSHttpBinding_IAlexaStateServiceContract" />
        <binding name="WSHttpBinding_INucLedServiceContract" />
        <binding name="WSHttpBinding_IArduinoServiceContract" />
        <binding name="WSHttpBinding_IPerformanceTuningServiceContract" maxReceivedMessageSize="10485760" />
        <binding name="WSHttpBinding_IEneServiceContract" />
      </wsHttpBinding>
      <netHttpBinding>
        <binding name="NetHttpBinding_IUniwillService">
          <webSocketSettings transportUsage="Always" />
        </binding>
      </netHttpBinding>
    </bindings>
    <client>
      <endpoint address="ws://localhost:58594/UniwillService" binding="netHttpBinding" bindingConfiguration="NetHttpBinding_IUniwillService" contract="UniwillService.IUniwillService" name="NetHttpBinding_IUniwillService" />
      <endpoint address="http://localhost:43564/NssService/service/AppSettings" binding="wsHttpBinding" bindingConfiguration="WSHttpBinding_IAppSettingsServiceContract" contract="AppSettingsService.IAppSettingsServiceContract" name="WSHttpBinding_IAppSettingsServiceContract" />
      <endpoint address="http://localhost:43562/NssService/service/AlexaSettings" binding="wsHttpBinding" bindingConfiguration="WSHttpBinding_IAlexaSettingsServiceContract" contract="AlexaSettingsService.IAlexaSettingsServiceContract" name="WSHttpBinding_IAlexaSettingsServiceContract" />
      <endpoint address="http://localhost:43563/NssService/service/AlexaState" binding="wsHttpBinding" bindingConfiguration="WSHttpBinding_IAlexaStateServiceContract" contract="AlexaStateService.IAlexaStateServiceContract" name="WSHttpBinding_IAlexaStateServiceContract" />
      <endpoint address="http://localhost:43565/NssService/service/NucLed" binding="wsHttpBinding" bindingConfiguration="WSHttpBinding_INucLedServiceContract" contract="NucLedService.INucLedServiceContract" name="WSHttpBinding_INucLedServiceContract" />
      <endpoint address="http://localhost:43566/NssService/service/SystemMonitor" binding="wsDualHttpBinding" bindingConfiguration="WSDualHttpBinding_ISystemMonitorServiceContract" contract="SystemMonitorService.ISystemMonitorServiceContract" name="WSDualHttpBinding_ISystemMonitorServiceContract" />
      <endpoint address="net.pipe://localhost/NssService/service/SystemMonitor" binding="netNamedPipeBinding" bindingConfiguration="NetNamedPipeBinding_ISystemMonitorServiceContract" contract="SystemMonitorService.ISystemMonitorServiceContract" name="NetNamedPipeBinding_ISystemMonitorServiceContract" />
      <endpoint address="http://localhost:43567/NssService/service/Arduino" binding="wsHttpBinding" bindingConfiguration="WSHttpBinding_IArduinoServiceContract" contract="ArduinoService.IArduinoServiceContract" name="WSHttpBinding_IArduinoServiceContract" />
      <endpoint address="http://localhost:43568/NssService/service/PerformanceTuning" bindingConfiguration="WSHttpBinding_IPerformanceTuningServiceContract" contract="PerformanceTuningService.IPerformanceTuningServiceContract" name="WSHttpBinding_IPerformanceTuningServiceContract" binding="wsHttpBinding" />
      <endpoint address="http://localhost:43569/NssService/service/Ene" bindingConfiguration="WSHttpBinding_IEneServiceContract" contract="EneService.IEneServiceContract" name="WSHttpBinding_IEneServiceContract" binding="wsHttpBinding" />
    </client>
  </system.serviceModel>
