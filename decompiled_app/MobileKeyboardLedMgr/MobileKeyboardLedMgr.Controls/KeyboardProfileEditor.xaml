<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="MobileKeyboardLedMgr.Controls.KeyboardProfileEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:models="clr-namespace:Infrastructure.Models;assembly=Infrastructure" xmlns:converters="clr-namespace:Infrastructure.Converters;assembly=Infrastructure" xmlns:prism="http://prismlibrary.com/" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:controls="clr-namespace:MobileKeyboardLedMgr.Controls;assembly=MobileKeyboardLedMgr">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
      <converters:NewProfileEnabledConverter x:Key="NewProfileEnabledConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Viewbox>
    <Grid Background="{DynamicResource CardBackgroundBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="10" />
        <ColumnDefinition />
        <ColumnDefinition Width="10" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="10" />
        <RowDefinition />
        <RowDefinition Height="10" />
        <RowDefinition />
        <RowDefinition Height="10" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="10" />
        <RowDefinition Height="50" />
        <RowDefinition Height="20" />
        <RowDefinition Height="20" />
        <RowDefinition Height="10" />
      </Grid.RowDefinitions>
      <Viewbox Grid.Column="1" Grid.Row="1" Width="200" HorizontalAlignment="Left">
        <TextBlock Text="{StaticResource ManageProfilesString}" Style="{StaticResource CardTitleText}" />
      </Viewbox>
      <ScrollViewer Name="ProfilesScrollViewer" Grid.Column="1" Grid.Row="3" Height="150" Width="350" Style="{StaticResource CustomScrollViewer}">
        <ItemsControl ItemsSource="{Binding Profiles, UpdateSourceTrigger=PropertyChanged}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="20" />
                  <RowDefinition Height="1" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition />
                  <ColumnDefinition Width="10" />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="1" Style="{StaticResource CustomCheckBox}" VerticalAlignment="Center" IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding Default, Converter={StaticResource InverseBooleanConverter}}">
                  <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Checked">
                      <models:SetFocusTrigger TargetName="NameBox" />
                      <i:InvokeCommandAction Command="{Binding Path=DataContext.UpdateSelection, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                    </i:EventTrigger>
                    <i:EventTrigger EventName="Unchecked">
                      <i:InvokeCommandAction Command="{Binding Path=DataContext.UpdateSelection, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                    </i:EventTrigger>
                  </i:Interaction.Triggers>
                </CheckBox>
                <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="4" Foreground="#FFFFFFFF" Background="#00FFFFFF" FontSize="10" Style="{StaticResource TextInputNotEditable}" Text="{Binding Name}" IsEnabled="{Binding Default, Converter={StaticResource InverseBooleanConverter}}">
                  <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDown">
                      <i:InvokeCommandAction Command="{Binding SelectItem}" />
                    </i:EventTrigger>
                  </i:Interaction.Triggers>
                </TextBlock>
                <TextBox Name="NameBox" Grid.Column="3" MaxLength="15" Style="{StaticResource TextInput}" HorizontalContentAlignment="Left" FontSize="10" Text="{Binding Name, Mode=TwoWay}" Visibility="{Binding Selected, Converter={StaticResource BoolToHidden}}" IsEnabled="{Binding Default, Converter={StaticResource InverseBooleanConverter}}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <Grid Column="1" Row="5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <ToggleButton Name="NewProfileButton" HorizontalAlignment="Left" Background="{Binding Path=Background, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
          <Control.Template>
            <ControlTemplate TargetType="{x:Type ToggleButton}">
              <Border Name="ToggleBorder" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0.5, 0.5, 0.5, 0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="5" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Name="Label" Grid.Column="1" Text="{StaticResource NewProfileString}" Foreground="{DynamicResource TransparentButtonDefaultTextBrush}" />
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Label" Value="{DynamicResource TransparentButtonHoverTextBrush}" Property="TextBlock.Foreground" />
                </Trigger>
                <Trigger Property="ToggleButton.IsChecked" Value="False">
                  <Setter TargetName="ToggleBorder" Property="Border.BorderBrush" Value="#00FFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Control.Template>
        </ToggleButton>
        <Grid Column="1" Visibility="{Binding ElementName=NewProfileButton, Path=IsChecked, Converter={StaticResource BoolToVis}}">
          <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0, 0, 0, 0.5" />
        </Grid>
      </Grid>
      <Viewbox Grid.Column="1" Grid.Row="7" HorizontalAlignment="Left" Margin="5, 0" MaxHeight="40" Visibility="{Binding ElementName=NewProfileButton, Path=IsChecked, Converter={StaticResource BoolToCollapsed}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="true" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="20" />
            <RowDefinition Height="5" />
            <RowDefinition Height="20" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Column="0" Text="{StaticResource ProfileNameString}" Foreground="#FFFFFFFF" Background="#00FFFFFF" FontSize="12" Style="{StaticResource TextInputNotEditable}" VerticalAlignment="Center" />
          <TextBox Name="NewProfileTextBox" Grid.Column="2" Style="{StaticResource TextInput}" MaxLength="15" HorizontalContentAlignment="Left" FontSize="10" Text="{Binding NewProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <Button Tag="{StaticResource SaveProfileString}" Width="50" Grid.Column="6" Grid.Row="2" HorizontalAlignment="Right" Style="{StaticResource RectangleButton}" Command="{Binding AddProfile}" IsEnabled="{Binding NewProfileName, Converter={StaticResource NewProfileEnabledConverter}}" />
          <TextBlock Grid.Column="0" Grid.Row="2" Text="{StaticResource CopyFromProfileString}" Foreground="#FFFFFFFF" Background="#00FFFFFF" FontSize="12" Style="{StaticResource TextInputNotEditable}" VerticalAlignment="Center" />
          <ComboBox Width="150" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="6" HorizontalAlignment="Left" DisplayMemberPath="Name" Style="{StaticResource ComboBoxStyle}" ItemsSource="{Binding Profiles}" SelectedItem="{Binding NewProfileBase}">
            <ItemsControl.ItemContainerStyle>
              <Style TargetType="{x:Type ComboBoxItem}">
                <Setter Property="Template" Value="{StaticResource BlueDropDownTemplate}" />
              </Style>
            </ItemsControl.ItemContainerStyle>
          </ComboBox>
        </Grid>
      </Viewbox>
      <Grid Column="1" Row="9">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Button Name="DeleteButton" Grid.Column="0" Tag="{StaticResource DeleteProfileString}" Style="{StaticResource RectangleButton}" Command="{Binding DeleteSelectedProfiles}" IsEnabled="{Binding ProfilesSelected}" />
        <Button Grid.Column="2" Tag="{StaticResource CloseProfileString}" Style="{StaticResource RectangleButton}" Command="{Binding CloseEditor}" />
      </Grid>
    </Grid>
  </Viewbox>
</UserControl>