<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="MobileKeyboardLedMgr.Controls.KeyGroupEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:MobileKeyboardLedMgr.Controls" xmlns:converters="clr-namespace:Infrastructure.Converters;assembly=Infrastructure">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
      <converters:NewProfileEnabledConverter x:Key="NewProfileEnabledConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Viewbox>
    <Grid Background="{DynamicResource CardBackgroundBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="50" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="50" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="30" />
        <RowDefinition />
        <RowDefinition Height="30" />
        <RowDefinition Height="120" />
        <RowDefinition Height="10" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="20" />
        <RowDefinition Height="300" />
        <RowDefinition Height="20" />
        <RowDefinition Height="30" />
        <RowDefinition Height="30" />
      </Grid.RowDefinitions>
      <Grid Row="1" Column="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="20" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{StaticResource GroupNameString}" Style="{StaticResource ColorPickerTitleText}" />
        <TextBox Name="NewKeyGroupName" Grid.Column="2" Height="30" Width="250" Style="{StaticResource TextInput}" MaxLength="20" HorizontalContentAlignment="Left" FontWeight="Normal" FontSize="18" Text="{Binding KeyGroupToEdit.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      </Grid>
      <local:KeyboardLedsColorPicker HorizontalAlignment="Left" Grid.Row="3" Grid.Column="1" DataContext="{Binding SelectedColor, FallbackValue={StaticResource DefaultColor}}" />
      <TextBlock Text="{StaticResource ClickKeysString}" Style="{StaticResource ColorPickerSubtitleText}" Grid.Row="5" Grid.Column="1" />
      <Viewbox Name="KeyGroupKeyboardControlViewBox" Grid.Row="7" Grid.Column="1">
        <local:KeyboardControl x:Name="KeyGroupKeyboardControlUi" DataContext="{Binding KeyGroupToEdit.KeyboardUiData}" />
      </Viewbox>
      <Grid Column="1" Row="9" HorizontalAlignment="Right">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="20" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Width="150" Tag="{StaticResource CancelString}" Style="{StaticResource RectangleButton}" Command="{Binding DataContext.CloseKeyGroupsEditor, RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=2}}" />
        <Button Grid.Column="2" Width="150" Tag="{StaticResource SaveString}" Style="{StaticResource RectangleButton}" Command="{Binding DataContext.SaveKeyGroup, RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=2}}" />
      </Grid>
    </Grid>
  </Viewbox>
</UserControl>