<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="MobileKeyboardLedMgr.Controls.KeyboardLedsColorPicker" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:prism="http://prismlibrary.com/" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ViewModelLocator.AutoWireViewModel="True" xmlns:controls="clr-namespace:MobileKeyboardLedMgr.Controls;assembly=MobileKeyboardLedMgr">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <DataTemplate x:Key="ColorPickerSquare">
        <Border>
          <Grid>
            <Rectangle Name="ColorRectangle" Width="30" Height="30">
              <Shape.Fill>
                <SolidColorBrush Color="{Binding FallbackValue={StaticResource DefaultColor}}" />
              </Shape.Fill>
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseDown">
                  <i:InvokeCommandAction Command="{Binding DataContext.SelectColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl, AncestorLevel=1}}" CommandParameter="{Binding .}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </Rectangle>
            <Rectangle Width="{Binding ElementName=ColorRectangle, Path=Width}" Height="{Binding ElementName=ColorRectangle, Path=Height}" Margin="{Binding ElementName=ColorRectangle, Path=Margin}">
              <Shape.Fill>
                <SolidColorBrush Color="LightGray" Opacity="{Binding Path=IsEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}, Converter={StaticResource ReverseBoolToOpacityConverter}}" />
              </Shape.Fill>
              <FrameworkElement.Style>
                <Style TargetType="{x:Type Rectangle}">
                  <Style.Triggers>
                    <DataTrigger Value="True" Binding="{Binding Path=IsEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}}">
                      <Setter Property="Fill" Value="#00FFFFFF" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </Rectangle>
            <i:Interaction.Triggers>
              <i:EventTrigger EventName="MouseDown">
                <i:InvokeCommandAction Command="{Binding DataContext.SelectColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl, AncestorLevel=1}}" CommandParameter="{Binding .}" />
              </i:EventTrigger>
            </i:Interaction.Triggers>
          </Grid>
          <FrameworkElement.Style>
            <Style TargetType="{x:Type Border}">
              <Setter Property="BorderThickness" Value="1" />
              <Setter Property="Margin" Value="4" />
              <Setter Property="BorderBrush" Value="#00FFFFFF" />
              <Style.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="BorderBrush" Value="{DynamicResource HoverControlForeground}" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </Border>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Viewbox VerticalAlignment="Top">
      <Grid Name="ColorPickerGrid" VerticalAlignment="Top" IsEnabled="{Binding Path=IsEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="60" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="60" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition>
            <FrameworkContentElement.Style>
              <Style TargetType="{x:Type RowDefinition}">
                <Setter Property="Height" Value="Auto" />
                <Style.Triggers>
                  <DataTrigger Value="Hidden" Binding="{Binding Path=Visibility, ElementName=StandardColorsLabel, NotifyOnSourceUpdated=True}">
                    <Setter Property="Height" Value="0" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkContentElement.Style>
          </RowDefinition>
          <RowDefinition>
            <FrameworkContentElement.Style>
              <Style TargetType="{x:Type RowDefinition}">
                <Setter Property="Height" Value="30" />
                <Style.Triggers>
                  <DataTrigger Value="Hidden" Binding="{Binding Path=Visibility, ElementName=StandardColorsLabel, NotifyOnSourceUpdated=True}">
                    <Setter Property="Height" Value="0" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkContentElement.Style>
          </RowDefinition>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="20" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{StaticResource CurrentColorString}" Style="{StaticResource ColorPickerTitleText}" FontSize="35" />
        <Rectangle Name="CurrentColor" Grid.Row="2" Width="300" Height="30" HorizontalAlignment="Left">
          <Shape.Fill>
            <SolidColorBrush Color="{Binding SelectedColor, FallbackValue={StaticResource DefaultColor}}" />
          </Shape.Fill>
        </Rectangle>
        <Rectangle Grid.Row="2" Width="{Binding ElementName=CurrentColor, Path=Width}" Height="{Binding ElementName=CurrentColor, Path=Height}" Margin="{Binding ElementName=CurrentColor, Path=Margin}">
          <Shape.Fill>
            <SolidColorBrush Color="LightGray" Opacity="{Binding Path=IsEnabled, ElementName=CurrentColor, Converter={StaticResource ReverseBoolToOpacityConverter}}" />
          </Shape.Fill>
          <FrameworkElement.Style>
            <Style TargetType="{x:Type Rectangle}">
              <Style.Triggers>
                <DataTrigger Value="True" Binding="{Binding Path=IsEnabled, ElementName=CurrentColor}">
                  <Setter Property="Fill" Value="#00FFFFFF" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </Rectangle>
        <TextBlock Name="StandardColorsLabel" Grid.Column="2" Text="{StaticResource StandardColorsString}" Style="{StaticResource ColorPickerTitleText}" FontSize="35" />
        <ItemsControl Name="StandardColorsList" Grid.Column="2" Grid.Row="2" Margin="-4,0" ItemTemplate="{StaticResource ColorPickerSquare}" ItemsSource="{Binding StandardColors}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <TextBlock Grid.Column="4" Text="{StaticResource RecentColorsString}" Style="{StaticResource ColorPickerTitleText}" FontSize="35" />
        <ItemsControl Grid.Column="4" Grid.Row="2" Margin="-4,0" ItemTemplate="{StaticResource ColorPickerSquare}" Width="{Binding ElementName=StandardColorsList, Path=ActualWidth}" ItemsSource="{Binding RecentColors}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <Grid Column="4" Row="4" Margin="0,0,40,0" IsEnabled="{Binding Path=IsEnabled, ElementName=CurrentColor}">
          <Button Style="{StaticResource TransparentButton}" HorizontalAlignment="Right" Tag="{StaticResource MoreColorsString}" Height="35" Command="{Binding DataContext.OpenColorPicker, RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=1}}" />
        </Grid>
      </Grid>
    </Viewbox>
  </Grid>
</UserControl>