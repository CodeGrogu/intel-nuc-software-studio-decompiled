<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="MobileKeyboardLedMgr.Controls.PaintModeEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:MobileKeyboardLedMgr.Controls" xmlns:converters="clr-namespace:Infrastructure.Converters;assembly=Infrastructure">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
      <converters:NewProfileEnabledConverter x:Key="NewProfileEnabledConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Viewbox>
    <Grid Background="{DynamicResource CardBackgroundBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="30" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="30" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="30" />
        <RowDefinition />
        <RowDefinition Height="30" />
        <RowDefinition />
        <RowDefinition Height="30" />
        <RowDefinition Height="100" />
        <RowDefinition Height="150" />
        <RowDefinition Height="25" />
        <RowDefinition Height="30" />
      </Grid.RowDefinitions>
      <Grid Row="1" Column="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{StaticResource PaintModeString}" Style="{StaticResource ColorPickerTitleText}" FontWeight="Medium" VerticalAlignment="Bottom" />
        <TextBlock Text="{StaticResource CurrentProfileString}" Style="{StaticResource ColorPickerSubtitleText}" FontSize="15" Grid.Column="2" VerticalAlignment="Top" />
        <TextBlock Style="{StaticResource ColorPickerSubtitleText}" FontSize="15" Grid.Column="3" Margin="5,0" VerticalAlignment="Top" Text="{Binding SelectedProfile.Name}" />
      </Grid>
      <TextBlock Text="{StaticResource PaintModeInstructionsString}" Style="{StaticResource ColorPickerSubtitleText}" TextWrapping="Wrap" Width="600" FontSize="15" VerticalAlignment="Bottom" Grid.Row="3" Grid.Column="1" />
      <local:KeyboardLedsColorPicker HorizontalAlignment="Left" Grid.Row="5" Grid.Column="1" DataContext="{Binding SelectedColor, FallbackValue={StaticResource DefaultColor}}" />
      <Grid Column="1" Row="7">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="125" />
          <ColumnDefinition Width="30" />
          <ColumnDefinition Width="125" />
          <ColumnDefinition />
          <ColumnDefinition Width="125" />
        </Grid.ColumnDefinitions>
        <Button Tag="{StaticResource UndoString}" Style="{StaticResource RectangleButton}" Command="{Binding UndoPaintChanges}" />
        <Button Grid.Column="2" Tag="{StaticResource DiscardString}" Style="{StaticResource RectangleButton}" Command="{Binding DiscardPaintChanges}" />
        <Button Grid.Column="4" Tag="{StaticResource SaveString}" Style="{StaticResource RectangleButton}" Command="{Binding SaveProfileButtonClick}" />
      </Grid>
    </Grid>
  </Viewbox>
</UserControl>