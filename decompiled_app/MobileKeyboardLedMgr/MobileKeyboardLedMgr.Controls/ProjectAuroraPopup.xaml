<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="MobileKeyboardLedMgr.Controls.ProjectAuroraPopup" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:MobileKeyboardLedMgr.Controls">
  <Viewbox VerticalAlignment="Center" HorizontalAlignment="Center" Margin="50">
    <Border>
      <Grid Margin="100" Background="{DynamicResource CardBackgroundBrush}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="30" />
          <ColumnDefinition Width="300" />
          <ColumnDefinition Width="30" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="30" />
          <RowDefinition />
          <RowDefinition />
          <RowDefinition />
          <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        <TextBlock Text="{StaticResource ProjectAuroraManagementString}" TextWrapping="Wrap" Style="{StaticResource CardTitleText}" Width="225" HorizontalAlignment="Left" FontSize="18" Grid.Row="1" Grid.Column="1" />
        <Rectangle Margin="0,10,0,10" Grid.Row="2" Grid.Column="1" Style="{StaticResource HorizontalSeparator}" />
        <Button Height="30" Width="175" Style="{StaticResource RectangleButton}" FontWeight="Bold" FontSize="14" Tag="{StaticResource OpenAuroraString}" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Margin="0,20,0,0" Command="{Binding LaunchAurora}" />
      </Grid>
      <UIElement.Effect>
        <DropShadowEffect Color="Black" Opacity=".4" />
      </UIElement.Effect>
    </Border>
  </Viewbox>
</UserControl>