  <Style x:Key="EyeToggle" TargetType="{x:Type ToggleButton}">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="ToggleButton.IsChecked" Value="{Binding Selected}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Name="TextBorder" Grid.Column="0" Grid.Row="1">
              <Grid Name="IconHolder" Background="#00FFFFFF">
                <Viewbox Name="OpenEye" Stretch="Fill" StretchDirection="DownOnly" Child="{StaticResource OpenEye}" />
                <Viewbox Name="ClosedEye" Stretch="Fill" StretchDirection="DownOnly" Child="{StaticResource ClosedEye}" />
              </Grid>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="OpenEye" Property="Visibility" Value="Visible" />
              <Setter TargetName="ClosedEye" Property="Visibility" Value="Hidden" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="False">
              <Setter TargetName="OpenEye" Property="Visibility" Value="Hidden" />
              <Setter TargetName="ClosedEye" Property="Visibility" Value="Visible" />
            </Trigger>
            <DataTrigger Value="True" Binding="{Binding ElementName=IconHolder, Path=IsMouseOver}">
              <Setter TargetName="OpenEye" Property="UIElement.BitmapEffect">
                <Setter.Value>
                  <DropShadowBitmapEffect Color="White" Direction="360" ShadowDepth="1" Softness="0.7" Opacity="1" />
                </Setter.Value>
              </Setter>
              <Setter TargetName="ClosedEye" Property="UIElement.BitmapEffect">
                <Setter.Value>
                  <DropShadowBitmapEffect Color="White" Direction="360" ShadowDepth="1" Softness="0.7" Opacity="1" />
                </Setter.Value>
              </Setter>
            </DataTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="ToggleButton.IsChecked" Value="False" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <DropShadowEffect x:Key="KeyDropShadow" BlurRadius="8" ShadowDepth="0" Color="{Binding LedColor, UpdateSourceTrigger=PropertyChanged}" Opacity="{Binding On, UpdateSourceTrigger=PropertyChanged, Mode=Default, Converter={StaticResource BoolToOpacityConverter}}" />
  <DropShadowEffect x:Key="KeyDropShadowOff" BlurRadius="0" ShadowDepth="0" Direction="270" Color="{Binding LedColor, UpdateSourceTrigger=PropertyChanged}" Opacity="{Binding On, UpdateSourceTrigger=PropertyChanged, Mode=Default, Converter={StaticResource BoolToOpacityConverter}}" />
  <Style x:Key="KeyToggleButton" TargetType="{x:Type ToggleButton}">
    <Setter Property="Background" Value="{DynamicResource KeyboardKeyBackgroundBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="6" />
    <Setter Property="Margin" Value="{Binding Margin, RelativeSource={RelativeSource Self}}" />
    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource Self}}" />
    <Setter Property="Width" Value="{Binding Width, RelativeSource={RelativeSource Self}}" />
    <Setter Property="Height" Value="{Binding Height, RelativeSource={RelativeSource Self}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Border Name="ButtonBorder" Background="{DynamicResource KeyboardKeyBackgroundBrush}" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource TemplatedParent}}">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Border}">
                <Setter Property="UIElement.Effect" Value="{StaticResource KeyDropShadow}" />
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding SecondRow}">
                    <Setter Property="UIElement.Effect" Value="{StaticResource KeyDropShadowOff}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0">
              <ContentControl Content="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource KeyLabelToIconConverter}}" />
            </Viewbox>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="False">
              <Setter TargetName="ButtonBorder" Value="{DynamicResource KeyboardKeyBackgroundBrush}" Property="Border.Background" />
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="ButtonBorder" Value="{DynamicResource KeyboardKeyBackgroundHoverBrush}" Property="Border.Background" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="ButtonBorder" Value="{DynamicResource KeyboardKeyBackgroundSelectedBrush}" Property="Border.Background" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="KeyColorToggleButton" TargetType="{x:Type ToggleButton}">
    <Setter Property="Height" Value="50" />
    <Setter Property="Width" Value="100" />
    <Setter Property="Background" Value="{DynamicResource KeyboardKeyBackgroundBrush}" />
    <Setter Property="Margin" Value="10" />
    <Setter Property="FontFamily" Value="Intel Clear" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="8" />
