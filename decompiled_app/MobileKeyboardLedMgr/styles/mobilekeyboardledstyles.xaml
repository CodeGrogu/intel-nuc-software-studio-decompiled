        <ToggleButton VerticalAlignment="Center" IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource EyeToggle}">
              <Style.Triggers>
                <DataTrigger Value="false" Binding="{Binding IsSelectable}">
                  <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </ToggleButton>
      </Viewbox>
      <Border Grid.Row="1" Grid.Column="2">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type Border}">
            <Setter Property="BorderThickness" Value="4" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="BorderBrush" Value="#00FFFFFF" />
            <Style.Triggers>
              <Trigger Property="UIElement.IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource HoverControlForeground}" />
              </Trigger>
              <DataTrigger Value="True">
                <DataTrigger.Binding>
                  <MultiBinding Converter="{StaticResource IsSelectedConverter}">
                    <Binding Path="." UpdateSourceTrigger="PropertyChanged" />
                    <Binding Path="DataContext.SelectedColor" UpdateSourceTrigger="PropertyChanged" RelativeSource="{RelativeSource AncestorType=UserControl, Mode=FindAncestor}" />
                  </MultiBinding>
                </DataTrigger.Binding>
                <Setter Property="BorderBrush" Value="{DynamicResource IconBrush}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
        <Grid>
          <i:Interaction.Triggers>
            <i:EventTrigger EventName="MouseLeftButtonDown">
              <i:InvokeCommandAction Command="{Binding DataContext.SwitchColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" CommandParameter="{Binding .}" />
            </i:EventTrigger>
          </i:Interaction.Triggers>
          <Rectangle Name="CurrentColor" Height="25" HorizontalAlignment="Stretch">
            <Shape.Fill>
              <SolidColorBrush Color="{Binding SelectedColor, FallbackValue={StaticResource DefaultColor}}" />
            </Shape.Fill>
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Rectangle}">
                <Style.Triggers>
                  <DataTrigger Value="False" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                    <Setter Property="IsEnabled" Value="False" />
                  </DataTrigger>
                  <DataTrigger Value="True" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                    <Setter Property="IsEnabled" Value="True" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </Rectangle>
          <Rectangle HorizontalAlignment="Stretch" Grid.Row="1" Grid.Column="2" Width="{Binding ElementName=CurrentColor, Path=Width}" Height="{Binding ElementName=CurrentColor, Path=Height}" Margin="{Binding ElementName=CurrentColor, Path=Margin}">
            <Shape.Fill>
              <SolidColorBrush Color="LightGray" Opacity="{Binding Path=IsEnabled, ElementName=CurrentColor, Converter={StaticResource ReverseBoolToOpacityConverter}}" />
            </Shape.Fill>
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Rectangle}">
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding Path=IsEnabled, ElementName=CurrentColor}">
                    <Setter Property="Fill" Value="#00FFFFFF" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </Rectangle>
        </Grid>
      </Border>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="DirectionsListBoxItemTemplate">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition Height="10" />
      </Grid.RowDefinitions>
      <RadioButton Foreground="{DynamicResource TitleBarLogoBrush}" FontSize="24" Style="{StaticResource RadioButtonControlBlue}" IsChecked="{Binding Path=IsSelected, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
        <ContentControl.Content>
          <MultiBinding Converter="{StaticResource DirectionAndEffectToStringMultiConverter}">
            <Binding Path="." />
            <Binding Path="DataContext.SelectedEffect" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBox}}" />
          </MultiBinding>
        </ContentControl.Content>
      </RadioButton>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="KeyGroupTemplate">
    <Grid Width="300">
      <Grid.RowDefinitions>
        <RowDefinition Height="25" />
        <RowDefinition Height="5" />
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <Grid HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource ColorPickerSubtitleText}" Text="{Binding Name}" />
        <Viewbox Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Viewbox.Child>
            <Border Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0">
              <ContentPresenter Content="{StaticResource EditIcon}" />
            </Border>
          </Viewbox.Child>
          <FrameworkElement.Style>
            <Style TargetType="{x:Type Viewbox}">
              <Style.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="UIElement.BitmapEffect">
                    <Setter.Value>
                      <DropShadowBitmapEffect Color="White" Direction="360" ShadowDepth="1" Softness="0.7" Opacity="1" />
                    </Setter.Value>
                  </Setter>
                </Trigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
          <i:Interaction.Triggers>
            <i:EventTrigger EventName="MouseDown">
              <i:InvokeCommandAction Command="{Binding DataContext.OpenKeyGroupsEditor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" CommandParameter="{Binding .}" />
            </i:EventTrigger>
          </i:Interaction.Triggers>
        </Viewbox>
        <Viewbox Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Viewbox.Child>
            <Border Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0">
              <ContentPresenter Content="{StaticResource TrashIcon}" />
            </Border>
          </Viewbox.Child>
          <FrameworkElement.Style>
            <Style TargetType="{x:Type Viewbox}">
              <Style.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="UIElement.BitmapEffect">
                    <Setter.Value>
                      <DropShadowBitmapEffect Color="White" Direction="360" ShadowDepth="1" Softness="0.7" Opacity="1" />
                    </Setter.Value>
                  </Setter>
                </Trigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
          <i:Interaction.Triggers>
            <i:EventTrigger EventName="MouseDown">
              <i:InvokeCommandAction Command="{Binding DataContext.ConfirmDeleteKeyGroup, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" CommandParameter="{Binding .}" />
            </i:EventTrigger>
          </i:Interaction.Triggers>
        </Viewbox>
      </Grid>
      <Viewbox Grid.Row="2" HorizontalAlignment="Left">
        <Border Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0">
          <controls:KeyboardControl DataContext="{Binding KeyboardUiData}" />
        </Border>
        <FrameworkElement.Style>
          <Style TargetType="{x:Type Viewbox}">
            <Style.Triggers>
              <Trigger Property="UIElement.IsMouseOver" Value="True">
                <Setter Property="UIElement.BitmapEffect">
                  <Setter.Value>
                    <DropShadowBitmapEffect Color="White" Direction="360" ShadowDepth="1" Softness="0.7" Opacity="1" />
                  </Setter.Value>
                </Setter>
              </Trigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
        <i:Interaction.Triggers>
          <i:EventTrigger EventName="MouseDown">
            <i:InvokeCommandAction Command="{Binding ApplyKeyGroup}" />
          </i:EventTrigger>
        </i:Interaction.Triggers>
      </Viewbox>
      <Rectangle Grid.Row="3" Margin="0,20,0,20" Style="{StaticResource HorizontalSeparator}" />
    </Grid>
  </DataTemplate>
</ResourceDictionary>