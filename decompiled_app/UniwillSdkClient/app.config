<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <system.serviceModel>
        <bindings>
            <netHttpBinding>
                <binding name="NetHttpBinding_IUniwillService">
                    <webSocketSettings transportUsage="Always" />
                </binding>
            </netHttpBinding>
        </bindings>
        <client>
            <endpoint address="ws://localhost:58594/UniwillService" binding="netHttpBinding"
                bindingConfiguration="NetHttpBinding_IUniwillService" contract="UniwillService.IUniwillService"
                name="NetHttpBinding_IUniwillService" />
        </client>
    </system.serviceModel>
</configuration>