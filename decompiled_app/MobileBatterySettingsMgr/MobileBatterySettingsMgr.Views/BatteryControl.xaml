<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="MobileBatterySettingsMgr.Views.BatteryControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:MobileBatterySettingsMgr.Views" xmlns:converters="clr-namespace:Infrastructure.Converters;assembly=Infrastructure" xmlns:local_converters="clr-namespace:MobileBatterySettingsMgr.Converters" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:h="clr-namespace:Infrastructure.Helpers;assembly=Infrastructure">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <local_converters:BatteryChargeLimitToYConverter x:Key="BatteryChargeLimitToYConverter" />
      <converters:PercentageToValueConverter x:Key="PercentageToValueConverter" />
      <converters:SumConverter x:Key="SumConverter" />
      <Style x:Key="OptimalTextblock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource KcAppText}">
        <Setter Property="Visibility" Value="Hidden" />
        <Setter Property="FontSize" Value="24" />
      </Style>
      <Style x:Key="BatterySliderThumb" TargetType="{x:Type Thumb}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Thumb}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="385" />
                  <ColumnDefinition Width="15" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <local:SliderArm VerticalAlignment="Center" Height="{Binding BatterySliderArmHeight}" />
                <Grid Column="2">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock h:ViewBoxHelper.DisableScaling="True" VerticalAlignment="Center" Style="{StaticResource KcAppText}" Text="{Binding BatteryChargeLimitString}" />
                  <TextBlock Name="OptimizedLabel" VerticalAlignment="Top" Grid.Row="1" h:ViewBoxHelper.DisableScaling="True" Text="{StaticResource OptimalString}">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource OptimalTextblock}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Value="65" Binding="{Binding BatteryChargeLimit}">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </TextBlock>
                </Grid>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <ControlTemplate x:Key="ThumbTemplate" TargetType="{x:Type Slider}">
        <Track xmlns:sys="clr-namespace:System;assembly=mscorlib" Name="PART_Track" IsDirectionReversed="False" Grid.Row="1">
          <Track.Thumb>
            <Thumb Style="{StaticResource BatterySliderThumb}">
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="DragCompleted">
                  <i:InvokeCommandAction Command="{Binding SetBatteryChargingLevel}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </Thumb>
          </Track.Thumb>
        </Track>
      </ControlTemplate>
      <Style x:Key="BatterySlider" TargetType="{x:Type Slider}">
        <Setter Property="Height">
          <Setter.Value>
            <MultiBinding Converter="{StaticResource SumConverter}">
              <Binding Path="BatteryChargeHalfMaxHeight" />
              <Binding Path="BatterySliderArmHeight" />
            </MultiBinding>
          </Setter.Value>
        </Setter>
        <Setter Property="Slider.Orientation" Value="Vertical" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="RangeBase.Minimum" Value="{Binding BatteryChargeLimitMin}" />
        <Setter Property="RangeBase.Maximum" Value="{Binding BatteryChargeLimitMax}" />
        <Setter Property="RangeBase.Value" Value="{Binding BatteryChargeLimit, Mode=TwoWay}" />
        <Setter Property="Slider.TickFrequency" Value="{Binding BatteryChargeLimitInterval}" />
        <Setter Property="Template" Value="{StaticResource ThumbTemplate}" />
        <Setter Property="UIElement.IsHitTestVisible" Value="True" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
