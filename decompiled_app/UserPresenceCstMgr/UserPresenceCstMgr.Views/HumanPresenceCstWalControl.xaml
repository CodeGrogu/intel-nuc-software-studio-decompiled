    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition />
      <ColumnDefinition Width="10" />
      <ColumnDefinition Width="200" />
    </Grid.ColumnDefinitions>
    <TextBlock Text="{StaticResource WalTitle}" Style="{StaticResource ColorPickerTitleText}" />
    <ToggleButton Grid.Column="2" HorizontalAlignment="Right" IsChecked="{Binding WalEnabled}">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource OnOffToggle}" TargetType="{x:Type ToggleButton}">
          <Style.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter Property="Content" Value="{StaticResource ToggleOnString}" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="False">
              <Setter Property="Content" Value="{StaticResource ToggleOffString}" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </ToggleButton>
    <Rectangle Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource HorizontalSeparator}" />
    <TextBlock Grid.Row="4" Text="{StaticResource EnableWithExternalMonitor}" Style="{StaticResource ColorPickerTitleText}" FontSize="20" />
    <ToggleButton Grid.Row="4" Grid.Column="2" HorizontalAlignment="Right" IsEnabled="{Binding WalEnabled}" IsChecked="{Binding EnableLockWithExternalMonitor}">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource OnOffToggle}" TargetType="{x:Type ToggleButton}">
          <Style.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter Property="Content" Value="{StaticResource ToggleOnString}" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="False">
              <Setter Property="Content" Value="{StaticResource ToggleOffString}" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </ToggleButton>
    <TextBlock Grid.Row="6" Text="{StaticResource TimeToDim}" Style="{StaticResource ColorPickerTitleText}" FontSize="20" />
    <Grid Row="6" Column="2" IsEnabled="{Binding WalEnabled}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="50" />
      </Grid.ColumnDefinitions>
      <Slider Name="PreDimSlider" Focusable="True" Style="{StaticResource HorizontalSliderStyle}" TickFrequency="30000" Value="{Binding PreDimInterval}" Minimum="{Binding TimeIntervalMin}" Maximum="{Binding TimeIntervalMax}" />
      <Viewbox Grid.Column="2" StretchDirection="DownOnly">
        <TextBlock Style="{StaticResource ColorPickerTitleText}" FontSize="18" Text="{Binding ElementName=PreDimSlider, Path=Value, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource MillisecondIntervalConverter}}" />
      </Viewbox>
    </Grid>
    <TextBlock Grid.Row="8" Text="{StaticResource WaitInterval}" Style="{StaticResource ColorPickerTitleText}" FontSize="20" Visibility="{Binding DataContext.Summary, Converter={StaticResource InverseBooleanToVisibilityConverter}, ConverterParameter=Collapsed, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl, AncestorLevel=2}}" />
    <Grid Row="8" Column="2" IsEnabled="{Binding WalEnabled}" Visibility="{Binding DataContext.Summary, Converter={StaticResource InverseBooleanToVisibilityConverter}, ConverterParameter=Collapsed, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl, AncestorLevel=2}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="50" />
      </Grid.ColumnDefinitions>
      <Slider Name="WaitSlider" Style="{StaticResource HorizontalSliderStyle}" Value="{Binding WaitInterval}" Minimum="{Binding TimeIntervalMin}" Maximum="{Binding TimeIntervalMax}" />
      <Viewbox Grid.Column="2" StretchDirection="DownOnly">
        <TextBlock Style="{StaticResource ColorPickerTitleText}" FontSize="18" Text="{Binding ElementName=WaitSlider, Path=Value, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource MillisecondIntervalConverter}}" />
      </Viewbox>
    </Grid>
    <TextBlock Grid.Row="10" Text="{StaticResource DimScreen}" Style="{StaticResource ColorPickerTitleText}" FontSize="20" Visibility="{Binding DataContext.Summary, Converter={StaticResource InverseBooleanToVisibilityConverter}, ConverterParameter=Collapsed, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl, AncestorLevel=2}}" />
    <ToggleButton Grid.Row="10" Grid.Column="2" HorizontalAlignment="Right" IsEnabled="{Binding WalEnabled}" IsChecked="{Binding DimScreen}" Visibility="{Binding DataContext.Summary, Converter={StaticResource InverseBooleanToVisibilityConverter}, ConverterParameter=Collapsed, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl, AncestorLevel=2}}">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource OnOffToggle}" TargetType="{x:Type ToggleButton}">
          <Style.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter Property="Content" Value="{StaticResource ToggleOnString}" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="False">
              <Setter Property="Content" Value="{StaticResource ToggleOffString}" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </ToggleButton>
    <TextBlock Grid.Row="12" Text="{StaticResource PowerRequest}" Style="{StaticResource ColorPickerTitleText}" FontSize="20" Visibility="{Binding DataContext.Summary, Converter={StaticResource InverseBooleanToVisibilityConverter}, ConverterParameter=Collapsed, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl, AncestorLevel=2}}" />
    <ToggleButton Grid.Row="12" Grid.Column="2" HorizontalAlignment="Right" IsEnabled="{Binding WalEnabled}" IsChecked="{Binding PowerRequest}" Visibility="{Binding DataContext.Summary, Converter={StaticResource InverseBooleanToVisibilityConverter}, ConverterParameter=Collapsed, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl, AncestorLevel=2}}">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource OnOffToggle}" TargetType="{x:Type ToggleButton}">
          <Style.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter Property="Content" Value="{StaticResource ToggleOnString}" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="False">
              <Setter Property="Content" Value="{StaticResource ToggleOffString}" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </ToggleButton>
    <TextBlock Grid.Row="14" Text="{StaticResource LyncSDK}" Style="{StaticResource ColorPickerTitleText}" FontSize="20" Visibility="{Binding DataContext.Summary, Converter={StaticResource InverseBooleanToVisibilityConverter}, ConverterParameter=Collapsed, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl, AncestorLevel=2}}" />
    <ToggleButton Grid.Row="14" Grid.Column="2" HorizontalAlignment="Right" IsEnabled="{Binding WalEnabled}" IsChecked="{Binding UseLyncSDK}" Visibility="{Binding DataContext.Summary, Converter={StaticResource InverseBooleanToVisibilityConverter}, ConverterParameter=Collapsed, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl, AncestorLevel=2}}">
      <FrameworkElement.Style>
        <Style BasedOn="{StaticResource OnOffToggle}" TargetType="{x:Type ToggleButton}">
          <Style.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter Property="Content" Value="{StaticResource ToggleOnString}" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="False">
              <Setter Property="Content" Value="{StaticResource ToggleOffString}" />
            </Trigger>
          </Style.Triggers>
        </Style>
