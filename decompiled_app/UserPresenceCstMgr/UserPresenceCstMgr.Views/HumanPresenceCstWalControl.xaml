        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="50" />
      </Grid.ColumnDefinitions>
      <Slider Name="LockAfterDimSlider" Style="{StaticResource HorizontalSliderStyle}" Value="{Binding LockAfterDimInterval}" Minimum="{Binding TimeIntervalMin}" Maximum="{Binding TimeIntervalMax}" />
      <Viewbox Grid.Column="2" StretchDirection="DownOnly">
        <TextBlock Style="{StaticResource ColorPickerTitleText}" FontSize="18" Text="{Binding ElementName=LockAfterDimSlider, Path=Value, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource MillisecondIntervalConverter}}" />
      </Viewbox>
    </Grid>
    <TextBlock Grid.Row="18" Text="{StaticResource DisplayOffAfterLock}" Style="{StaticResource ColorPickerTitleText}" FontSize="20" Visibility="{Binding DataContext.Summary, Converter={StaticResource InverseBooleanToVisibilityConverter}, ConverterParameter=Collapsed, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl, AncestorLevel=2}}" />
    <ToggleButton Grid.Row="18" Grid.Column="2" HorizontalAlignment="Right" IsEnabled="{Binding WalEnabled}" IsChecked="{Binding DisplayOffAfterLock}" Visibility="{Binding DataContext.Summary, Converter={StaticResource InverseBooleanToVisibilityConverter}, ConverterParameter=Collapsed, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl, AncestorLevel=2}}">
