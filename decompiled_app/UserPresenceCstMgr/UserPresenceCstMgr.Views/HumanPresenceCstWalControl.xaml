      </Viewbox>
    </Grid>
    <TextBlock Grid.Row="22" Text="{StaticResource DimmingPercent}" Style="{StaticResource ColorPickerTitleText}" FontSize="20" Visibility="{Binding DataContext.Summary, Converter={StaticResource InverseBooleanToVisibilityConverter}, ConverterParameter=Collapsed, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl, AncestorLevel=2}}" />
