          <Setter Property="IsEnabled" Value="False" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="True" Binding="{Binding WalEnabled}" />
                <Condition Value="True" Binding="{Binding DimScreen}" />
              </MultiDataTrigger.Conditions>
              <Setter Property="IsEnabled" Value="True" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="50" />
      </Grid.ColumnDefinitions>
      <Slider Name="DimPercentSlider" Style="{StaticResource HorizontalSliderStyle}" Value="{Binding NotPresentDimTarget}" Minimum="{Binding PercentIntervalMin}" Maximum="{Binding PercentIntervalMax}" />
      <Viewbox Grid.Column="2" StretchDirection="DownOnly">
        <TextBlock Style="{StaticResource ColorPickerTitleText}" FontSize="18">
          <TextBlock.Text>
            <MultiBinding StringFormat="{}{0}{1}">
              <Binding ElementName="DimPercentSlider" Path="Value" UpdateSourceTrigger="PropertyChanged" />
              <Binding Source="{StaticResource PercentSymbol}" />
            </MultiBinding>
          </TextBlock.Text>
        </TextBlock>
      </Viewbox>
