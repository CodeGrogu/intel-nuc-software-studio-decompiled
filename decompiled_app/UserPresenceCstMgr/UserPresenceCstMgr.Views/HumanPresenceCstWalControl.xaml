    <TextBlock Grid.Row="16" Text="{StaticResource LockAfterDimInterval}" Style="{StaticResource ColorPickerTitleText}" FontSize="20" Visibility="{Binding DataContext.Summary, Converter={StaticResource InverseBooleanToVisibilityConverter}, ConverterParameter=Collapsed, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl, AncestorLevel=2}}" />
    <Grid Row="16" Column="2" IsEnabled="{Binding WalEnabled}" Visibility="{Binding DataContext.Summary, Converter={StaticResource InverseBooleanToVisibilityConverter}, ConverterParameter=Collapsed, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl, AncestorLevel=2}}">
      <Grid.ColumnDefinitions>
