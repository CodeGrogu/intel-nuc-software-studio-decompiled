<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PeripheralSettingsMgr.Views.DisplayModeSummaryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:PeripheralSettingsMgr.Views" xmlns:controls="clr-namespace:Infrastructure.Controls;assembly=Infrastructure" xmlns:prism="http://prismlibrary.com/" ViewModelLocator.AutoWireViewModel="True">
  <Grid Background="{StaticResource CardBackgroundBrush}">
    <ItemsControl Style="{StaticResource CardGridItemsStyle}">
      <controls:CardTitleBarControl Grid.Row="1" Grid.Column="1" IconCanvas="{StaticResource DisplayModeCardIcon}" TitleText="{StaticResource DisplayModeSummaryCardTitleString}" OpenDetailView="{Binding Path=DataContext.OpenDetailView, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
      <Viewbox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" StretchDirection="DownOnly" Margin="15">
        <ListBox Grid.Row="3" Grid.Column="1" Style="{StaticResource RadioButtonListBox}" ItemContainerStyle="{StaticResource RadioButtonItemContainerListBox}" ItemTemplate="{StaticResource DisplayModeListBoxItemTemplate}" ItemsSource="{Binding Modes}" SelectedItem="{Binding CurrentMode}" />
      </Viewbox>
    </ItemsControl>
  </Grid>
</UserControl>