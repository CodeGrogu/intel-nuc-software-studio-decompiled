<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PeripheralSettingsMgr.Views.ScheduledSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:Infrastructure.Converters;assembly=Infrastructure" xmlns:views="clr-namespace:PeripheralSettingsMgr.Views;assembly=PeripheralSettingsMgr">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <converters:BoolToCollapsedVisibilityConverter x:Key="BoolToCollapsedVisibilityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="{StaticResource CardBackgroundBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="50" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition />
      <RowDefinition />
    </Grid.RowDefinitions>
    <TextBlock Text="{StaticResource DateString}" Style="{StaticResource ColorPickerTitleText}" FontSize="20" />
    <TextBlock Grid.Column="2" Text="{StaticResource TimeString}" Style="{StaticResource ColorPickerTitleText}" FontSize="20" />
    <Viewbox Grid.Row="1" Grid.RowSpan="5" Stretch="Uniform" HorizontalAlignment="Left" Margin="10,0,0,0">
      <Calendar SelectedDate="{Binding SelectedDateTime}" />
    </Viewbox>
    <Grid Row="1" Column="2" Margin="10,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="75" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="75" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="20" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Text="{StaticResource HourString}" Style="{StaticResource AppTitleText}" />
      <ComboBox Grid.Column="2" Style="{StaticResource ComboBoxStyle}" Height="30" HorizontalAlignment="Stretch" ItemsSource="{Binding Hours}" SelectedItem="{Binding SelectedHour}">
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Template" Value="{StaticResource BlueDropDownTemplate}" />
          </Style>
        </ItemsControl.ItemContainerStyle>
      </ComboBox>
      <TextBlock Grid.Column="4" Text="{StaticResource MinuteString}" Style="{StaticResource AppTitleText}" HorizontalAlignment="Center" />
      <ComboBox Grid.Column="6" Style="{StaticResource ComboBoxStyle}" HorizontalAlignment="Stretch" Height="30" ItemsSource="{Binding Minutes}" SelectedItem="{Binding SelectedMinute}">
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Template" Value="{StaticResource BlueDropDownTemplate}" />
          </Style>
        </ItemsControl.ItemContainerStyle>
      </ComboBox>
      <TextBlock Grid.Row="2" Text="{StaticResource RepeatString}" Style="{StaticResource AppTitleText}" />
      <ComboBox Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="5" Style="{StaticResource ComboBoxStyle}" Height="30" HorizontalAlignment="Stretch" ItemsSource="{Binding RepeatTypes}" SelectedItem="{Binding SelectedRepeat}">
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Template" Value="{StaticResource BlueDropDownTemplate}" />
          </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding ., Converter={StaticResource EnumDescriptionConverter}}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ComboBox>
    </Grid>
    <TextBlock Grid.Row="3" Grid.Column="2" Text="{StaticResource SleepTimer}" Style="{StaticResource AppTitleText}" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10,0" Visibility="{Binding Sleep, Converter={StaticResource BoolToCollapsedVisibilityConverter}}" />
    <Grid Column="2" Row="5" Margin="10,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Slider Width="230" Minimum="0" Maximum="60" TickFrequency="1" Style="{StaticResource HorizontalSliderStyle}" HorizontalAlignment="Left" VerticalAlignment="Center" Value="{Binding SleepInactivity}" Visibility="{Binding Sleep, Converter={StaticResource BoolToCollapsedVisibilityConverter}}" />
      <TextBlock Grid.Column="2" Margin="5" Style="{StaticResource ColorPickerTitleText}" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding SleepInactivity}" Visibility="{Binding Sleep, Converter={StaticResource BoolToCollapsedVisibilityConverter}}" />
    </Grid>
  </Grid>
</UserControl>