<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PeripheralSettingsMgr.Views.DisplayModeControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:PeripheralSettingsMgr.Views">
  <Viewbox>
    <Grid Background="{Binding Path=Background, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="5" />
        <RowDefinition Height="32" />
        <RowDefinition Height="13" />
        <RowDefinition Height="39" />
        <RowDefinition Height="39" />
        <RowDefinition Height="32" />
        <RowDefinition Height="13" />
        <RowDefinition Height="39" />
        <RowDefinition Height="39" />
        <RowDefinition Height="32" />
        <RowDefinition Height="13" />
        <RowDefinition Height="39" />
        <RowDefinition Height="5" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="570" />
        <ColumnDefinition Width="36" />
        <ColumnDefinition Width="72" />
        <ColumnDefinition Width="70" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="70" />
        <ColumnDefinition Width="570" />
        <ColumnDefinition Width="36" />
        <ColumnDefinition Width="72" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Row="1" Grid.Column="0" Text="{StaticResource DisplayModeBrightnessString}" Style="{StaticResource ColorPickerTitleText}" />
      <Slider Name="BrightnessSlider" Grid.Row="3" Grid.Column="0" Style="{StaticResource HorizontalSliderStyle}" IsEnabled="{Binding BrightnessSupported}" Value="{Binding Brightness}" Minimum="{Binding BrightnessMin}" Maximum="{Binding BrightnessMax}" />
      <TextBlock Grid.Row="5" Grid.Column="0" Text="{StaticResource DisplayModeContrastString}" Style="{StaticResource ColorPickerTitleText}" />
      <Slider Name="ContrastSlider" Grid.Row="7" Grid.Column="0" Style="{StaticResource HorizontalSliderStyle}" IsEnabled="{Binding ContrastSupported}" Value="{Binding Contrast}" Minimum="{Binding ContrastMin}" Maximum="{Binding ContrastMax}" />
      <TextBlock Grid.Row="9" Grid.Column="0" Text="{StaticResource DisplayModeColorTempString}" Style="{StaticResource ColorPickerTitleText}" />
      <Slider Name="ColorTempSlider" Grid.Row="11" Grid.Column="0" Style="{StaticResource HorizontalSliderStyle}" IsEnabled="{Binding ColorTemperatureSupported}" Value="{Binding ColorTemperature}" Minimum="{Binding ColorTempMin}" Maximum="{Binding ColorTempMax}" />
      <Viewbox Grid.Row="11" Grid.Column="2" StretchDirection="DownOnly">
        <TextBlock VerticalAlignment="Center" Style="{StaticResource ColorPickerTitleText}" Text="{Binding ColorTempType, Converter={StaticResource EnumDescriptionConverter}}" />
      </Viewbox>
      <Rectangle Grid.Column="4" Grid.RowSpan="13" Style="{StaticResource VerticalSeparator}" />
      <TextBlock Grid.Row="1" Grid.Column="6" Text="{StaticResource DisplayModeRedString}" Style="{StaticResource ColorPickerTitleText}" />
      <Slider Name="RedSlider" Grid.Row="3" Grid.Column="6" Style="{StaticResource HorizontalSliderStyle}" Foreground="{StaticResource RedBrush}" IsEnabled="{Binding GammaRampSupported}" Value="{Binding Red}" Minimum="{Binding ColorMin}" Maximum="{Binding ColorMax}" />
      <TextBlock Grid.Row="3" Grid.Column="8" Style="{StaticResource ColorPickerTitleText}" Text="{Binding ElementName=RedSlider, Path=Value, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Grid.Row="5" Grid.Column="6" Text="{StaticResource DisplayModeGreenString}" Style="{StaticResource ColorPickerTitleText}" />
      <Slider Name="GreenSlider" Grid.Row="7" Grid.Column="6" Style="{StaticResource HorizontalSliderStyle}" Foreground="{StaticResource GreenBrush}" IsEnabled="{Binding GammaRampSupported}" Value="{Binding Green}" Minimum="{Binding ColorMin}" Maximum="{Binding ColorMax}" />
      <TextBlock Grid.Row="7" Grid.Column="8" Style="{StaticResource ColorPickerTitleText}" Text="{Binding ElementName=GreenSlider, Path=Value, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Grid.Row="9" Grid.Column="6" Text="{StaticResource DisplayModeBlueString}" Style="{StaticResource ColorPickerTitleText}" />
      <Slider Name="BlueSlider" Grid.Row="11" Grid.Column="6" Style="{StaticResource HorizontalSliderStyle}" Foreground="{StaticResource BlueBrush}" IsEnabled="{Binding GammaRampSupported}" Value="{Binding Blue}" Minimum="{Binding ColorMin}" Maximum="{Binding ColorMax}" />
      <TextBlock Grid.Row="11" Grid.Column="8" Style="{StaticResource ColorPickerTitleText}" Text="{Binding ElementName=BlueSlider, Path=Value, UpdateSourceTrigger=PropertyChanged}" />
    </Grid>
  </Viewbox>
</UserControl>