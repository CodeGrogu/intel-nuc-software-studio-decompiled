<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PeripheralSettingsMgr.Views.GammaRampControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:PeripheralSettingsMgr.Views">
  <Grid Background="{Binding Path=Background, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}}">
    <Grid.RowDefinitions>
      <RowDefinition Height="5" />
      <RowDefinition Height="32" />
      <RowDefinition Height="13" />
      <RowDefinition Height="39" />
      <RowDefinition Height="39" />
      <RowDefinition Height="32" />
      <RowDefinition Height="13" />
      <RowDefinition Height="39" />
      <RowDefinition Height="39" />
      <RowDefinition Height="32" />
      <RowDefinition Height="13" />
      <RowDefinition Height="39" />
      <RowDefinition Height="5" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="570" />
      <ColumnDefinition Width="36" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <TextBlock Grid.Row="1" Text="{StaticResource DisplayModeRedString}" Style="{StaticResource ColorPickerTitleText}" />
    <Slider Name="RedSlider" Grid.Row="3" Style="{StaticResource HorizontalSliderStyle}" Foreground="{StaticResource RedBrush}" Value="{Binding Red}" Minimum="{Binding ColorMin}" Maximum="{Binding ColorMax}" />
    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource ColorPickerTitleText}" Text="{Binding ElementName=RedSlider, Path=Value, UpdateSourceTrigger=PropertyChanged}" />
    <TextBlock Grid.Row="5" Text="{StaticResource DisplayModeGreenString}" Style="{StaticResource ColorPickerTitleText}" />
    <Slider Name="GreenSlider" Grid.Row="7" Style="{StaticResource HorizontalSliderStyle}" Foreground="{StaticResource GreenBrush}" Value="{Binding Green}" Minimum="{Binding ColorMin}" Maximum="{Binding ColorMax}" />
    <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource ColorPickerTitleText}" Text="{Binding ElementName=GreenSlider, Path=Value, UpdateSourceTrigger=PropertyChanged}" />
    <TextBlock Grid.Row="9" Text="{StaticResource DisplayModeBlueString}" Style="{StaticResource ColorPickerTitleText}" />
    <Slider Name="BlueSlider" Grid.Row="11" Style="{StaticResource HorizontalSliderStyle}" Foreground="{StaticResource BlueBrush}" Value="{Binding Blue}" Minimum="{Binding ColorMin}" Maximum="{Binding ColorMax}" />
    <TextBlock Grid.Row="11" Grid.Column="2" Style="{StaticResource ColorPickerTitleText}" Text="{Binding ElementName=BlueSlider, Path=Value, UpdateSourceTrigger=PropertyChanged}" />
  </Grid>
</UserControl>