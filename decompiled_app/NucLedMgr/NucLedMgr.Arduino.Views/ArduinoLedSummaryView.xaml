<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NucLedMgr.Arduino.Views.ArduinoLedSummaryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:converters="clr-namespace:Infrastructure.Converters;assembly=Infrastructure" xmlns:local_converts="clr-namespace:NucLedMgr.Arduino.Converters" xmlns:controls="clr-namespace:Infrastructure.Controls;assembly=Infrastructure" xmlns:style="clr-namespace:NucLedMgr.Styles" xmlns:enums="clr-namespace:FeatureMgr.Enums;assembly=FeatureMgr" xmlns:prism="http://prismlibrary.com/" x:Name="ArduinoLedSummaryCard" ViewModelLocator.AutoWireViewModel="True" xmlns:views="clr-namespace:NucLedMgr.Arduino.Views">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
      <converters:BoolToCollapsedVisibilityConverter x:Key="BoolToCollapsedVisibilityConverter" />
      <local_converts:MatchingObjectToVisibilityConverter x:Key="NucVisibilityConverter" />
      <local_converts:InverseMatchingObjectToVisibilityConverter x:Key="InverseNucVisibilityConverter" />
      <local_converts:MatchingObjectToCollapsedConverter x:Key="NucCollapsedConverter" />
      <local_converts:InverseMatchingObjectToCollapsedConverter x:Key="InverseNucCollapsedConverter" />
      <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
      <converters:InverseVisibilityConverter x:Key="InverseVisibilityConverter" />
      <converters:InverseBooleanConverter x:Key="InverseBool" />
      <converters:NullHiddenConverter x:Key="NullHiddenConverter" />
      <converters:NullHiddenInverseConverter x:Key="NullHiddenInverseConverter" />
      <local_converts:ArduinoPatternToName x:Key="ArduinoPatternToName" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="{StaticResource CardBackgroundBrush}">
    <ItemsControl Style="{StaticResource CardGridItemsStyle}">
      <controls:CardTitleBarControl Grid.Row="1" Grid.Column="1" IconCanvas="{StaticResource LedCardIcon}" TitleText="{StaticResource ChassisLedCardTitleString}" OpenDetailView="{Binding Path=DataContext.OpenDetailView, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" Visibility="{Binding LedsAvailable, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
      <Grid Row="1" Column="1" Visibility="{Binding SerialPortError, Mode=OneWay, Converter={StaticResource NullHiddenConverter}}">
        <controls:CardTitleBarControlDisable Grid.Row="1" Grid.Column="1" IconCanvas="{StaticResource LedCardIcon}" TitleText="{StaticResource ChassisLedCardTitleString}" OpenErrorMessageBox="{Binding Path=DataContext.OpenErrorMessageBox, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" OpenDetailView="{Binding Path=DataContext.OpenDetailView, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
      </Grid>
      <Grid Row="3" Column="1" Visibility="{Binding SerialPortError, Mode=OneWay, Converter={StaticResource NullHiddenInverseConverter}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="50" />
          <RowDefinition>
            <FrameworkContentElement.Style>
              <Style TargetType="{x:Type RowDefinition}">
                <Setter Property="Height" Value="*" />
                <Style.Triggers>
                  <DataTrigger Value="True">
                    <DataTrigger.Binding>
                      <MultiBinding Converter="{StaticResource FirstIsGreaterOrEqualConverter}">
                        <Binding ElementName="ArduinoLedSummaryCard" Path="ActualWidth" />
                        <Binding ElementName="ArduinoLedSummaryCard" Path="ActualHeight" />
                      </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Height" Value="30" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkContentElement.Style>
          </RowDefinition>
        </Grid.RowDefinitions>
        <Viewbox Stretch="Uniform" Grid.Row="0" Visibility="{Binding NucType, Converter={StaticResource InverseNucCollapsedConverter}, ConverterParameter={x:Static enums:NucType.Panther}}">
          <Grid>
            <style:ClickableMonsterCove VerticalContentAlignment="Center" Visibility="{Binding NucType, Converter={StaticResource NucCollapsedConverter}, ConverterParameter={x:Static enums:NucType.Beast}}" />
            <style:ClickableMonsterCove VerticalContentAlignment="Center" Visibility="{Binding NucType, Converter={StaticResource NucCollapsedConverter}, ConverterParameter={x:Static enums:NucType.Dragon}}" />
          </Grid>
        </Viewbox>
        <Grid Row="0" VerticalAlignment="Top" Visibility="{Binding NucType, Converter={StaticResource NucCollapsedConverter}, ConverterParameter={x:Static enums:NucType.Panther}}">
          <style:ClickablePantherSummary VerticalAlignment="Center" Visibility="{Binding NucType, Converter={StaticResource NucVisibilityConverter}, ConverterParameter={x:Static enums:NucType.Panther}}" />
          <TextBlock Name="ErrorMessage2" Text="{StaticResource ProductErrorString}" Style="{StaticResource ColorPickerTitleText}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding NucType, Converter={StaticResource NucVisibilityConverter}, ConverterParameter={x:Static enums:NucType.Error}}" />
          <Rectangle Fill="#00FFFFFF" />
        </Grid>
        <Viewbox Grid.Row="1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="4*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <ComboBox Style="{StaticResource ComboBoxStyle}" HorizontalAlignment="Left" Width="200" Height="25" ItemsSource="{Binding Profiles, Mode=OneWay}" SelectedValue="{Binding SelectedProfile, Mode=TwoWay}" IsEnabled="{Binding ElementName=ErrorMessage, Path=IsVisible, Converter={StaticResource InverseBool}}">
              <ItemsControl.ItemContainerStyle>
                <Style TargetType="{x:Type ComboBoxItem}">
                  <Setter Property="Template" Value="{StaticResource BlueDropDownTemplate}" />
                </Style>
              </ItemsControl.ItemContainerStyle>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding ., Converter={StaticResource ArduinoPatternToName}}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ComboBox>
            <Separator Grid.Column="1" Background="#00FFFFFF" Width="100" />
            <TextBlock Text="{StaticResource EffectsString}" Margin="0,-5,5,0" Style="{StaticResource NUCAppTitleText}" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="2" />
            <ToggleButton HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="3" Width="80" Height="25" IsChecked="{Binding On, Mode=TwoWay}" IsEnabled="{Binding ElementName=ErrorMessage, Path=IsVisible, Converter={StaticResource InverseBool}}">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type ToggleButton}">
                  <Setter Property="Template" Value="{StaticResource BasicToggleButton}" />
                  <Style.Triggers>
                    <Trigger Property="ToggleButton.IsChecked" Value="True">
                      <Setter Property="Content" Value="{StaticResource ToggleOnString}" />
                    </Trigger>
                    <Trigger Property="ToggleButton.IsChecked" Value="False">
                      <Setter Property="Content" Value="{StaticResource ToggleOffString}" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </ToggleButton>
          </Grid>
        </Viewbox>
      </Grid>
    </ItemsControl>
  </Grid>
</UserControl>