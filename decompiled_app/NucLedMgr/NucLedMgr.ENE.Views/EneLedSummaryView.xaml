<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NucLedMgr.ENE.Views.EneLedSummaryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:prism="http://prismlibrary.com/" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:controls="clr-namespace:Infrastructure.Controls;assembly=Infrastructure" xmlns:converters="clr-namespace:Infrastructure.Converters;assembly=Infrastructure" xmlns:Loader="clr-namespace:Infrastructure.ApplicationLoader;assembly=Infrastructure" xmlns:led_converters="clr-namespace:NucLedMgr.Converters" xmlns:local_converts="clr-namespace:NucLedMgr.ENE.Converters" xmlns:style="clr-namespace:NucLedMgr.Styles" xmlns:local="clr-namespace:NucLedMgr.ENE.Views" x:Name="EneLedSummaryCard" ViewModelLocator.AutoWireViewModel="True">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <led_converters:ColorCountToWidthConverter x:Key="ColorCountToWidthConverter" />
      <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
      <converters:InverseVisibilityConverter x:Key="InverseVisibilityConverter" />
      <converters:InverseBooleanConverter x:Key="InverseBool" />
      <converters:NullHiddenConverter x:Key="NullHiddenConverter" />
      <converters:NullHiddenInverseConverter x:Key="NullHiddenInverseConverter" />
      <led_converters:SelectedZoneConverter x:Key="SelectedZoneConverter" />
      <local_converts:EnePatternToName x:Key="EnePatternToName" />
      <Style x:Key="LEDListRadioButton" TargetType="{x:Type RadioButton}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type RadioButton}">
              <Border Name="ButtonBorder" Margin="0,5,0,0" CornerRadius="2,0,0,2" BorderThickness="3, 3, 3, 3" BorderBrush="{StaticResource SeparatorBrush}">
                <ContentControl Content="{Binding Path=Content, RelativeSource={RelativeSource TemplatedParent}}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                  <Setter TargetName="ButtonBorder" Property="Border.BorderBrush" Value="{StaticResource SeparatorBrush}" />
                  <Setter TargetName="ButtonBorder" Property="Border.Background" Value="{StaticResource TabSelectedBackgroundBrushRN}" />
                  <Setter Property="Foreground" Value="{StaticResource MainTextBrush}" />
                </Trigger>
                <Trigger Property="ToggleButton.IsChecked" Value="False">
                  <Setter TargetName="ButtonBorder" Property="Border.BorderBrush" Value="{StaticResource SeparatorBrush}" />
                  <Setter TargetName="ButtonBorder" Property="Border.Background" Value="{StaticResource TabSelectedBackgroundBrushRN}" />
                  <Setter Property="Foreground" Value="{StaticResource MainTextBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="{StaticResource CardBackgroundBrush}">
    <ItemsControl Style="{StaticResource CardGridItemsStyle}">
      <controls:CardTitleBarControl Grid.Row="1" Grid.Column="1" IconCanvas="{StaticResource LedCardIcon}" TitleText="{StaticResource ChassisLedCardTitleString}" OpenDetailView="{Binding Path=DataContext.OpenDetailView, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" Visibility="{Binding LedsAvailable, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
      <Grid Row="1" Column="1" Visibility="{Binding SerialPortError, Mode=OneWay, Converter={StaticResource NullHiddenConverter}}">
        <controls:CardTitleBarControlDisable Grid.Row="1" Grid.Column="1" IconCanvas="{StaticResource LedCardIcon}" TitleText="{StaticResource ChassisLedCardTitleString}" OpenErrorMessageBox="{Binding Path=DataContext.OpenErrorMessageBox, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" OpenDetailView="{Binding Path=DataContext.OpenDetailView, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
      </Grid>
      <Grid Row="3" Column="1" Visibility="{Binding SerialPortError, Mode=OneWay, Converter={StaticResource NullHiddenInverseConverter}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="20" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Viewbox Grid.Row="0" VerticalAlignment="Top">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="4*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{StaticResource LedProfileString}" Style="{StaticResource NUCAppTitleText}" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="0" />
            <Separator Grid.Column="1" Background="#00FFFFFF" Width="20" />
            <ComboBox Style="{StaticResource ComboBoxStyle}" HorizontalAlignment="Left" Width="300" Height="25" Grid.Column="2" ItemsSource="{Binding Profiles, Mode=OneWay}" SelectedValue="{Binding SelectedProfile, Mode=TwoWay}" IsEnabled="{Binding ElementName=ErrorMessage, Path=IsVisible, Converter={StaticResource InverseBool}}">
              <ItemsControl.ItemContainerStyle>
                <Style TargetType="{x:Type ComboBoxItem}">
                  <Setter Property="Template" Value="{StaticResource BlueDropDownTemplate}" />
                </Style>
              </ItemsControl.ItemContainerStyle>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding ., Converter={StaticResource EnePatternToName}}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ComboBox>
          </Grid>
        </Viewbox>
        <Grid Row="2" VerticalAlignment="Top" HorizontalAlignment="Stretch">
          <Viewbox HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <ItemsControl Name="NavBar" Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" ItemsSource="{Binding EneZones}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <RadioButton GroupName="LedZone">
                    <FrameworkElement.Style>
                      <Style BasedOn="{StaticResource LEDListRadioButton}" TargetType="{x:Type RadioButton}" />
                    </FrameworkElement.Style>
                    <Grid Margin="0,30,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="75" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="500" />
                        <ColumnDefinition Width="500" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="15" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height=".0" />
                        <RowDefinition Height="55" />
                        <RowDefinition Height="15" />
                      </Grid.RowDefinitions>
                      <TextBlock FontSize="50" FontWeight="SemiBold" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" VerticalAlignment="Top" HorizontalAlignment="Left" Text="{Binding Name}" />
                      <Viewbox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" Visibility="Collapsed">
                        <Viewbox Child="{StaticResource LedActiveIcon}" Margin="0 5 0 0" />
                      </Viewbox>
                      <Viewbox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" Visibility="Collapsed">
                        <Viewbox Child="{StaticResource LedInactiveIcon}" Margin="0 5 0 0" />
                      </Viewbox>
                      <TextBlock Margin="60,0,0,0" FontWeight="SemiBold" FontSize="40" Foreground="{StaticResource DefaultControlText}" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" HorizontalAlignment="Left" Text="{Binding SelectedPattern, Converter={StaticResource StringToLocalizedLabelConverter}}" />
                      <Rectangle Width="250" Height="100" VerticalAlignment="Center" Grid.Column="5" Grid.Row="0" Grid.RowSpan="4" Visibility="{Binding Rainbow, Converter={StaticResource BoolToVis}}">
                        <Shape.Fill>
                          <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="Red" Offset="0.0" />
                            <GradientStop Color="Yellow" Offset="0.2" />
                            <GradientStop Color="Green" Offset="0.4" />
                            <GradientStop Color="Cyan" Offset="0.6" />
                            <GradientStop Color="Blue" Offset="0.8" />
                            <GradientStop Color="Purple" Offset="1.0" />
                          </LinearGradientBrush>
                        </Shape.Fill>
                      </Rectangle>
                      <ItemsControl VerticalAlignment="Center" Grid.Column="5" Grid.Row="0" Grid.RowSpan="4" Visibility="{Binding Rainbow, Converter={StaticResource InverseBooleanToVisibilityConverter}}" ItemsSource="{Binding ColorPickerData}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Rectangle Margin="0,0,-1,0" Height="100" Width="{Binding DataContext.ColorPickerData, Converter={StaticResource ColorCountToWidthConverter}, ConverterParameter=EneLedSummaryView, RelativeSource={RelativeSource AncestorType=ItemsControl, Mode=FindAncestor}}" Visibility="{Binding EnableColor, Converter={StaticResource BoolToVis}}">
                              <Shape.Fill>
                                <SolidColorBrush Color="{Binding SelectedColor, FallbackValue={StaticResource DefaultColor}}" />
                              </Shape.Fill>
                            </Rectangle>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Rectangle VerticalAlignment="Center" Grid.Column="5" Grid.Row="0" Grid.RowSpan="4" Width="257" Height="110" Visibility="{Binding DataContext.On, Converter={StaticResource InverseBooleanToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}">
                        <Shape.Fill>
                          <SolidColorBrush Color="#3d546b" Opacity="1" />
                        </Shape.Fill>
                      </Rectangle>
                    </Grid>
                  </RadioButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Viewbox>
        </Grid>
        <Grid Row="3" HorizontalAlignment="Right" VerticalAlignment="Top">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{StaticResource RestoreDefaultsString}" Foreground="{StaticResource TransparentButtonDefaultTextBrush}" Grid.Column="4" FontSize="12" VerticalAlignment="Center" Margin="0,15,0,0" FontWeight="Bold">
            <UIElement.InputBindings>
              <MouseBinding MouseAction="LeftClick" Command="{Binding Reset}" />
            </UIElement.InputBindings>
            <FrameworkElement.Style>
              <Style TargetType="{x:Type TextBlock}">
                <Style.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter Property="UIElement.BitmapEffect">
                      <Setter.Value>
                        <DropShadowBitmapEffect Color="White" Direction="360" ShadowDepth="1" Softness="0.7" Opacity="1" />
                      </Setter.Value>
                    </Setter>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </TextBlock>
        </Grid>
        <Viewbox Grid.Row="4" VerticalAlignment="Bottom">
          <Grid Row="4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Separator Grid.Column="0" Background="#00FFFFFF" Width="300" />
            <TextBlock Text="{StaticResource ChassisLedEnableString}" Margin="0,5,10,0" FontSize="14" Style="{StaticResource NUCAppTitleText}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Grid.Column="1" />
            <ToggleButton HorizontalAlignment="Right" VerticalAlignment="Bottom" Grid.Column="3" Width="70" Height="21" IsChecked="{Binding On, Mode=TwoWay}" IsEnabled="{Binding ElementName=ErrorMessage, Path=IsVisible, Converter={StaticResource InverseBool}}">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type ToggleButton}">
                  <Setter Property="Template" Value="{StaticResource BasicToggleButton}" />
                  <Style.Triggers>
                    <Trigger Property="ToggleButton.IsChecked" Value="True">
                      <Setter Property="Content" Value="{StaticResource ToggleOnString}" />
                    </Trigger>
                    <Trigger Property="ToggleButton.IsChecked" Value="False">
                      <Setter Property="Content" Value="{StaticResource ToggleOffString}" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </ToggleButton>
          </Grid>
        </Viewbox>
      </Grid>
    </ItemsControl>
  </Grid>
</UserControl>