<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NucLedMgr.ENE.Views.EneLedControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:NucLedMgr.ENE.Views" xmlns:converters="clr-namespace:Infrastructure.Converters;assembly=Infrastructure" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions" xmlns:local_converts="clr-namespace:NucLedMgr.ENE.Converters" xmlns:controls="clr-namespace:NucLedMgr.ENE.Controls;assembly=">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <local_converts:PatternToHeightConverter x:Key="PatternToHeightConverter" />
      <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="{StaticResource TabSelectedBackgroundBrushRN}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1*" />
      <ColumnDefinition Width="7*" />
      <ColumnDefinition Width="1*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height=".2*" />
      <RowDefinition Height=".2*" />
      <RowDefinition Height="2.2*" />
      <RowDefinition Height=".2*" />
    </Grid.RowDefinitions>
    <Grid Row="0" VerticalAlignment="Top" Margin="10,10,0,0" HorizontalAlignment="Left" ColumnSpan="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width=".5*" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="1.6*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="3.5*" />
        <RowDefinition Height="1*" />
      </Grid.RowDefinitions>
      <Viewbox HorizontalAlignment="Left" Child="{StaticResource LedActiveIcon}" Grid.Column="0" Visibility="{Binding IsLedActive, Converter={StaticResource BoolToVis}}" />
      <Viewbox Child="{StaticResource LedInactiveIcon}" MaxWidth="18" Grid.Column="0" Visibility="{Binding IsLedActive, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
      <Viewbox Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" MaxHeight="22">
        <TextBlock Text="{StaticResource LedDetectedString}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" FontWeight="SemiBold" Foreground="{StaticResource MainTextBrush}" Visibility="{Binding IsLedActive, Converter={StaticResource BoolToVis}}" />
      </Viewbox>
      <Viewbox Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left">
        <TextBlock Text="{StaticResource LedNotDetectedString}" Foreground="{StaticResource DefaultControlText}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" FontWeight="SemiBold" Visibility="{Binding IsLedActive, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
      </Viewbox>
    </Grid>
    <Grid Column="1" Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width=".5*" />
        <ColumnDefinition Width=".7*" />
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width=".7*" />
        <ColumnDefinition Width="1*" />
        <ColumnDefinition Width="0" />
        <ColumnDefinition Width="1.8*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="1*" />
        <RowDefinition Height="40" />
        <RowDefinition Height="6*" />
        <RowDefinition Height=".5*" />
        <RowDefinition Height="25" />
        <RowDefinition Height=".5*" />
        <RowDefinition Height="10" />
      </Grid.RowDefinitions>
      <Viewbox Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left">
        <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top" Text="{StaticResource LedPatternString}" Style="{StaticResource ColorPickerTitleText}" />
      </Viewbox>
      <Viewbox Grid.Row="0" Grid.Column="2" HorizontalAlignment="Left">
        <ComboBox Grid.Row="0" Grid.Column="2" Margin="0,5,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Top" Style="{StaticResource ComboBoxStyle}" Height="30" Width="300" FontSize="18" ItemsSource="{Binding Patterns}" SelectedItem="{Binding SelectedPattern}">
          <ItemsControl.ItemContainerStyle>
            <Style TargetType="{x:Type ComboBoxItem}">
              <Setter Property="Template" Value="{StaticResource BlueDropDownTemplate}" />
            </Style>
          </ItemsControl.ItemContainerStyle>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding ., Converter={StaticResource EnumDescriptionConverter}}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ComboBox>
      </Viewbox>
      <Grid Row="0" Column="4" HorizontalAlignment="Left" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <Viewbox Grid.Row="0" Grid.Column="2" HorizontalAlignment="Left">
          <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top" Text="{StaticResource LedRainbowString}" Style="{StaticResource ColorPickerTitleText}" />
        </Viewbox>
      </Grid>
      <Grid Row="0" Column="6" HorizontalAlignment="Left" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Viewbox Grid.Row="0" Grid.Column="2" HorizontalAlignment="Left">
          <ToggleButton HorizontalAlignment="Left" Width="100" Height="30" IsChecked="{Binding Rainbow}" IsEnabled="{Binding RainbowSupported}">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type ToggleButton}">
                <Setter Property="Template" Value="{StaticResource BasicToggleButton}" />
                <Style.Triggers>
                  <Trigger Property="ToggleButton.IsChecked" Value="True">
                    <Setter Property="Content" Value="{StaticResource ToggleOnString}" />
                  </Trigger>
                  <Trigger Property="ToggleButton.IsChecked" Value="False">
                    <Setter Property="Content" Value="{StaticResource ToggleOffString}" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </ToggleButton>
        </Viewbox>
      </Grid>
      <Grid Name="EneColorPicker" Row="2" HorizontalAlignment="Left" VerticalAlignment="Top" Column="0" ColumnSpan="3">
        <Viewbox>
          <ItemsControl ItemsSource="{Binding ColorPickerData}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <controls:EneColorPicker DataContext="{Binding ., FallbackValue={StaticResource DefaultColor}}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Viewbox>
      </Grid>
      <Grid VerticalAlignment="Top" Column="4" Row="2" RowSpan="3">
        <Viewbox VerticalAlignment="Top" Grid.Column="3" Grid.ColumnSpan="2" Grid.Row="2" Visibility="{Binding ButtonStatus, Converter={StaticResource BoolToVis}}">
          <Rectangle VerticalAlignment="Top" Grid.Column="4" Grid.ColumnSpan="2" Grid.Row="2" Grid.RowSpan="3" Width="4" Height="4" HorizontalAlignment="Left" Visibility="{Binding Rainbow, Converter={StaticResource BoolToVis}}">
            <Shape.Fill>
              <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="Red" Offset="0.0" />
                <GradientStop Color="Yellow" Offset="0.2" />
                <GradientStop Color="Green" Offset="0.4" />
                <GradientStop Color="Cyan" Offset="0.6" />
                <GradientStop Color="Blue" Offset="0.8" />
                <GradientStop Color="Purple" Offset="1.0" />
              </LinearGradientBrush>
            </Shape.Fill>
          </Rectangle>
        </Viewbox>
        <Viewbox VerticalAlignment="Top" Grid.Column="3" Grid.ColumnSpan="2" Grid.Row="2" Visibility="{Binding Rainbow, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
          <ItemsControl VerticalAlignment="Center" Grid.Column="5" Grid.Row="1" Grid.RowSpan="3" Visibility="{Binding Rainbow, Converter={StaticResource InverseBooleanToVisibilityConverter}}" ItemsSource="{Binding ColorPickerData}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Rectangle Width="4" Height="{Binding DataContext.ColorPickerData, Converter={StaticResource PatternToHeightConverter}, RelativeSource={RelativeSource AncestorType=ItemsControl, Mode=FindAncestor}}" Visibility="{Binding EnableColor, Converter={StaticResource BoolToVis}}">
                  <Shape.Fill>
                    <SolidColorBrush Color="{Binding SelectedColor, FallbackValue={StaticResource DefaultColor}}" />
                  </Shape.Fill>
                </Rectangle>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Viewbox>
        <Viewbox VerticalAlignment="Top" Grid.Column="4" Grid.ColumnSpan="2" Grid.Row="2" Grid.RowSpan="3" Visibility="{Binding ButtonStatus, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
          <Rectangle VerticalAlignment="Top" Grid.Column="4" Grid.ColumnSpan="2" Grid.Row="2" Grid.RowSpan="3" Width="4.1" Height="4.1" HorizontalAlignment="Left" Fill="#3d546b" Visibility="{Binding ButtonStatus, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
        </Viewbox>
      </Grid>
      <Viewbox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Center">
        <TextBlock Grid.Row="4" Grid.Column="0" Text="{StaticResource LedBrightnessString}" Style="{StaticResource ColorPickerTitleText}" />
      </Viewbox>
      <Viewbox Grid.Row="3" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center">
        <Slider Name="BrightnessSlider" Grid.Row="4" Grid.Column="2" Margin="40,0,0,0" Style="{StaticResource HorizontalSliderStyle}" Width="250" Visibility="Visible" HorizontalAlignment="Stretch" Value="{Binding Brightness}" Minimum="{Binding BrightnessMin}" Maximum="{Binding BrightnessMax}" IsEnabled="{Binding BrightnessSupported}">
          <i:Interaction.Triggers>
            <i:EventTrigger EventName="PreviewMouseUp">
              <core:CallMethodAction xmlns:core="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" MethodName="BrightnessSelectionChanged" TargetObject="{Binding}" />
            </i:EventTrigger>
          </i:Interaction.Triggers>
        </Slider>
      </Viewbox>
      <Viewbox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Center">
        <TextBlock Grid.Row="4" Grid.Column="0" Text="{StaticResource LedFrequencyString}" Style="{StaticResource ColorPickerTitleText}" Visibility="Visible" />
      </Viewbox>
      <Viewbox Grid.Row="5" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center">
        <Slider Grid.Row="4" Grid.Column="2" Margin="40,0,0,0" Style="{StaticResource HorizontalSliderStyle}" Width="250" Visibility="Visible" HorizontalAlignment="Stretch" Value="{Binding Speed}" Minimum="{Binding SpeedMin}" Maximum="{Binding SpeedMax}" IsEnabled="{Binding SpeedSupported}">
          <i:Interaction.Triggers>
            <i:EventTrigger EventName="PreviewMouseUp">
              <CallMethodAction MethodName="SpeedSelectionChanged" TargetObject="{Binding}" xmlns="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" />
            </i:EventTrigger>
          </i:Interaction.Triggers>
        </Slider>
      </Viewbox>
    </Grid>
  </Grid>
</UserControl>