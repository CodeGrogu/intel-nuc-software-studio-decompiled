<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NucLedMgr.WMI.Views.EthernetControlView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:enums="clr-namespace:FeatureMgr.Enums;assembly=FeatureMgr" xmlns:controls="clr-namespace:NucLedMgr.WMI.Controls" xmlns:local_converters="clr-namespace:NucLedMgr.WMI.Converters" xmlns:models="clr-namespace:NucLedMgr.WMI.Models" xmlns:views="clr-namespace:NucLedMgr.WMI.Views">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <local_converters:IndicatorBehaviorToBoolConverter x:Key="IndicatorBehaviorToBoolConverter" />
      <local_converters:InverseMatchingObjectToVisibilityConverter x:Key="InverseNucToVisConverter" />
      <local_converters:StandardColorsArrayConverter x:Key="StandardColorsArrayConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="{StaticResource TabSelectedBackgroundBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="10" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition MaxWidth="50" />
      <ColumnDefinition Width="10" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="100" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Viewbox Grid.Row="1" Grid.Column="1" VerticalAlignment="Top">
      <controls:ColorPicker DataContext="{Binding SelectedColors[0], FallbackValue={StaticResource DefaultColor}}" DisplayRecentColors="{Binding DataContext.NucType, Converter={StaticResource InverseNucToVisConverter}, ConverterParameter={x:Static enums:NucType.Panther}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorLevel=3, AncestorType=UserControl}}" />
    </Viewbox>
    <StackPanel Orientation="Horizontal" Grid.Row="4" Grid.Column="3" Grid.RowSpan="4" HorizontalAlignment="Left" Visibility="{Binding DataContext.NucType, Converter={StaticResource InverseNucToVisConverter}, ConverterParameter={x:Static enums:NucType.Phantom}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorLevel=3, AncestorType=UserControl}}">
      <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" BorderThickness="1" BorderBrush="{StaticResource SeparatorBrush}" />
    </StackPanel>
    <Grid Row="1" Column="5" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="40,0,0,0" Visibility="{Binding DataContext.NucType, Converter={StaticResource InverseNucToVisConverter}, ConverterParameter={x:Static enums:NucType.Phantom}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorLevel=3, AncestorType=UserControl}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="20" />
        <RowDefinition Height="*" />
        <RowDefinition Height="30" />
        <RowDefinition Height="*" />
        <RowDefinition Height="10" />
        <RowDefinition Height="*" />
        <RowDefinition Height="10" />
        <RowDefinition Height="*" />
        <RowDefinition Height="30" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Column="1" Text="{StaticResource LedStyleString}" Style="{StaticResource ColorPickerTitleText}" />
      <RadioButton Grid.Column="1" Grid.Row="4" Style="{StaticResource RadioButtonControlBlue}" IsChecked="{Binding SelectedBehavior, Converter={StaticResource IndicatorBehaviorToBoolConverter}, ConverterParameter={x:Static models:Behaviors.LAN1}}">
        <TextBlock Text="{StaticResource Lan1String}" Style="{StaticResource NavBarText}" />
      </RadioButton>
      <RadioButton Grid.Column="1" Grid.Row="6" Style="{StaticResource RadioButtonControlBlue}" IsChecked="{Binding SelectedBehavior, Converter={StaticResource IndicatorBehaviorToBoolConverter}, ConverterParameter={x:Static models:Behaviors.LAN2}}">
        <TextBlock Text="{StaticResource Lan2String}" Style="{StaticResource NavBarText}" />
      </RadioButton>
      <RadioButton Grid.Column="1" Grid.Row="8" Style="{StaticResource RadioButtonControlBlue}" IsChecked="{Binding SelectedBehavior, Converter={StaticResource IndicatorBehaviorToBoolConverter}, ConverterParameter={x:Static models:Behaviors.LAN1and2}}">
        <TextBlock Text="{StaticResource Lan1and2String}" Style="{StaticResource NavBarText}" />
      </RadioButton>
    </Grid>
  </Grid>
</UserControl>