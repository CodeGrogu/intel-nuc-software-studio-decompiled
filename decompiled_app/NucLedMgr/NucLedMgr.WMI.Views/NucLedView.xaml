            <ColumnDefinition Width="30" />
            <ColumnDefinition Width="20" />
          </Grid.ColumnDefinitions>
          <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Right">
            <TextBlock Text="{StaticResource LoadingString}" Style="{StaticResource AppTitleText}" FontSize="5" />
          </Viewbox>
          <TextBlock Style="{StaticResource AppTitleText}" HorizontalAlignment="Left" FontSize="5" Grid.Column="1">
            <FrameworkElement.Triggers>
              <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                  <Storyboard RepeatBehavior="Forever">
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Text">
                      <DiscreteObjectKeyFrame KeyTime="0:0:0" Value=" . . ." />
                      <DiscreteObjectKeyFrame KeyTime="0:0:1" Value=" ." />
                      <DiscreteObjectKeyFrame KeyTime="0:0:2" Value=" . ." />
                      <DiscreteObjectKeyFrame KeyTime="0:0:3" Value=" " />
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </FrameworkElement.Triggers>
          </TextBlock>
        </Grid>
      </Viewbox>
    </ItemsControl>
    <ItemsControl Style="{StaticResource DetailCardGridItemsStyle}" Visibility="{Binding Path=DataContext.NucType, Converter={StaticResource NucCollapsedConverter}, ConverterParameter={x:Static NucTypeEnum:NucType.Serpent}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}">
      <Viewbox Grid.Column="1" Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="700" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
