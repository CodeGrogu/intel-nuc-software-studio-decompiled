          <Viewbox Grid.Row="2" MaxWidth="400" VerticalAlignment="Top" Stretch="Uniform">
            <ItemsControl Name="NavBar" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" ItemsSource="{Binding Leds}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <RadioButton GroupName="LedZone" Command="{Binding DataContext.SelectedLedChanged, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}" CommandParameter="{Binding .}">
                    <FrameworkElement.Style>
                      <Style BasedOn="{StaticResource LEDListRadioButton}" TargetType="{x:Type RadioButton}">
                        <Setter Property="ToggleButton.IsChecked">
                          <Setter.Value>
                            <MultiBinding Converter="{StaticResource SelectedZoneConverter}">
                              <Binding Path="." />
                              <Binding Path="DataContext.SelectedLed" RelativeSource="{RelativeSource AncestorType=UserControl, Mode=FindAncestor}" />
                            </MultiBinding>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </FrameworkElement.Style>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="75" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition MinWidth="225" />
                        <ColumnDefinition Width="65" />
                        <ColumnDefinition Width="75" />
                        <ColumnDefinition Width="10" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
