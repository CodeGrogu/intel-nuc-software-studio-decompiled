                      <Style BasedOn="{StaticResource LEDListRadioButtonSerpent}" TargetType="{x:Type RadioButton}">
                        <Setter Property="ToggleButton.IsChecked">
                          <Setter.Value>
                            <MultiBinding Converter="{StaticResource SelectedZoneConverter}">
                              <Binding Path="." />
                              <Binding Path="DataContext.SelectedLed" RelativeSource="{RelativeSource AncestorType=UserControl, Mode=FindAncestor}" />
                            </MultiBinding>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </FrameworkElement.Style>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition MinWidth="225" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="0" />
                        <ColumnDefinition Width="10" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="15" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height=".0" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="15" />
                      </Grid.RowDefinitions>
                      <Viewbox HorizontalAlignment="Center" VerticalAlignment="Bottom" Grid.Column="1" Grid.Row="1" Grid.RowSpan="1" Child="{StaticResource PowerButtonIcon}" Visibility="{Binding LedType, Converter={StaticResource LedTypeToVisibilityConverter}, ConverterParameter={x:Static enums:LedType.PowerButton}}" />
                      <Viewbox HorizontalAlignment="Center" VerticalAlignment="Bottom" Grid.Column="1" Grid.Row="1" Grid.RowSpan="1" Child="{StaticResource MultipurposeIcon}" Visibility="{Binding LedType, Converter={StaticResource LedTypeToVisibilityConverter}, ConverterParameter={x:Static enums:LedType.Hdd}}" />
                      <Viewbox HorizontalAlignment="Center" VerticalAlignment="Bottom" Grid.Column="1" Grid.Row="1" Grid.RowSpan="1" Child="{StaticResource SkullIcon}" Visibility="{Binding LedType, Converter={StaticResource LedTypeToVisibilityConverter}, ConverterParameter={x:Static enums:LedType.Skull}}" />
                      <Viewbox HorizontalAlignment="Center" VerticalAlignment="Bottom" Grid.Column="1" Grid.Row="1" Grid.RowSpan="1" Child="{StaticResource WhitePowerButtonIcon}">
                        <UIElement.Visibility>
                          <MultiBinding Converter="{StaticResource LedIsCheckedMultiConverter}" ConverterParameter="{x:Static enums:LedType.PowerButton}">
                            <Binding Path="." />
                            <Binding Path="DataContext.SelectedLed" RelativeSource="{RelativeSource AncestorType=UserControl, Mode=FindAncestor}" />
                            <Binding Path="LedType" />
                          </MultiBinding>
                        </UIElement.Visibility>
                      </Viewbox>
                      <Viewbox HorizontalAlignment="Center" Grid.Column="1" Grid.Row="1" Grid.RowSpan="1" Margin="0,12,0,0" Child="{StaticResource WhiteMultipurposeIcon}">
                        <UIElement.Visibility>
                          <MultiBinding Converter="{StaticResource LedIsCheckedMultiConverter}" ConverterParameter="{x:Static enums:LedType.Hdd}">
                            <Binding Path="." />
                            <Binding Path="DataContext.SelectedLed" RelativeSource="{RelativeSource AncestorType=UserControl, Mode=FindAncestor}" />
                            <Binding Path="LedType" />
                          </MultiBinding>
                        </UIElement.Visibility>
                      </Viewbox>
                      <Viewbox HorizontalAlignment="Center" Grid.Column="1" Grid.Row="1" Grid.RowSpan="1" Child="{StaticResource WhiteSkullIcon}">
                        <UIElement.Visibility>
                          <MultiBinding Converter="{StaticResource LedIsCheckedMultiConverter}" ConverterParameter="{x:Static enums:LedType.Skull}">
                            <Binding Path="." />
                            <Binding Path="DataContext.SelectedLed" RelativeSource="{RelativeSource AncestorType=UserControl, Mode=FindAncestor}" />
                            <Binding Path="LedType" />
                          </MultiBinding>
                        </UIElement.Visibility>
                      </Viewbox>
                      <TextBlock FontSize="25" Grid.Row="1" Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Name}" />
                      <TextBlock FontSize="20" Foreground="{StaticResource DefaultControlText}" Grid.Row="3" Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Top" Text="{Binding IndicatorName}" />
                    </Grid>
                  </RadioButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Viewbox>
          <Border BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0, 2, 2, 2" Grid.Column="1">
            <local:WmiLedControlSerpant VerticalAlignment="Stretch" HorizontalAlignment="Stretch" DataContext="{Binding SelectedLed}" />
          </Border>
        </Grid>
      </Grid>
      <Rectangle Grid.Row="0" Grid.RowSpan="9" Grid.ColumnSpan="3" Fill="#FF000000" Opacity="0.75" Visibility="{Binding Open, Converter={StaticResource BoolToVis}}">
        <i:Interaction.Triggers>
          <i:EventTrigger EventName="MouseDown">
            <i:InvokeCommandAction Command="{Binding CloseEditor}" />
          </i:EventTrigger>
        </i:Interaction.Triggers>
      </Rectangle>
      <controls:ProfileEditor Name="ProfEditor1" Grid.Row="0" Grid.RowSpan="6" Grid.ColumnSpan="2" Margin="40" Visibility="{Binding Open, Converter={StaticResource BoolToVisibilityConverter}}" />
      <Rectangle Grid.Row="0" Grid.RowSpan="6" Grid.ColumnSpan="2" Fill="#FF000000" Opacity="0.25" Visibility="{Binding SmallLoadScreen, Converter={StaticResource BoolToVisibilityConverter}}" />
      <Viewbox Grid.Row="0" Grid.RowSpan="6" Grid.ColumnSpan="2" Margin="0,0,0,75" Visibility="{Binding SmallLoadScreen, Converter={StaticResource BoolToVisibilityConverter}}">
        <Grid Margin="120" Width="{Binding ElementName=ProfEditor1, Path=Width}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30" />
            <ColumnDefinition Width="20" />
          </Grid.ColumnDefinitions>
          <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Right">
            <TextBlock Text="{StaticResource LoadingString}" Style="{StaticResource AppTitleText}" FontSize="5" />
          </Viewbox>
          <TextBlock Style="{StaticResource AppTitleText}" HorizontalAlignment="Left" FontSize="5" Grid.Column="1">
            <FrameworkElement.Triggers>
              <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                  <Storyboard RepeatBehavior="Forever">
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Text">
                      <DiscreteObjectKeyFrame KeyTime="0:0:0" Value=" . . ." />
                      <DiscreteObjectKeyFrame KeyTime="0:0:1" Value=" ." />
                      <DiscreteObjectKeyFrame KeyTime="0:0:2" Value=" . ." />
                      <DiscreteObjectKeyFrame KeyTime="0:0:3" Value=" " />
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </FrameworkElement.Triggers>
          </TextBlock>
        </Grid>
      </Viewbox>
    </ItemsControl>
    <Grid Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="1*" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="1*" />
      </Grid.RowDefinitions>
      <Rectangle Fill="#FF000000" Opacity="0.5" Grid.RowSpan="4" Grid.ColumnSpan="2" />
      <Viewbox Child="{StaticResource IntelLogo}" Grid.Row="1" Visibility="{Binding ShowIntelLogo, Converter={StaticResource BoolToVis}}" />
      <Image Grid.Row="1" Source="{Binding AppLogo}" Visibility="{Binding ShowIntelLogo, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
      <Grid Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Viewbox HorizontalAlignment="Right" Margin="0,20,0,0" StretchDirection="DownOnly">
          <TextBlock Text="{StaticResource LoadingString}" Style="{StaticResource AppTitleText}" />
        </Viewbox>
        <TextBlock Style="{StaticResource AppTitleText}" HorizontalAlignment="Left" Grid.Column="1" Margin="0,20,0,0">
          <FrameworkElement.Triggers>
            <EventTrigger RoutedEvent="Loaded">
              <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                  <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Text">
                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value=" . . ." />
                    <DiscreteObjectKeyFrame KeyTime="0:0:1" Value=" ." />
                    <DiscreteObjectKeyFrame KeyTime="0:0:2" Value=" . ." />
                    <DiscreteObjectKeyFrame KeyTime="0:0:3" Value=" " />
                  </ObjectAnimationUsingKeyFrames>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </FrameworkElement.Triggers>
        </TextBlock>
      </Grid>
    </Grid>
    <Grid Visibility="{Binding LedsAvailable, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="1*" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="1*" />
      </Grid.RowDefinitions>
      <Rectangle Fill="#FF000000" Opacity="0.5" Grid.RowSpan="4" Grid.ColumnSpan="2" />
      <Loader:LoaderAnimation VerticalAlignment="Center" Grid.Row="1" HorizontalAlignment="Center" Height="1" Width="1" />
    </Grid>
  </Grid>
</UserControl>