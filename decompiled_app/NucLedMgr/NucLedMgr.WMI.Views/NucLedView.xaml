      <local_converters:IndicatorToVisibilityConverter x:Key="IndicatorToVisibilityConverter" />
      <local_converters:IndicatorIsCheckedMultiConverter x:Key="IndicatorIsCheckedMultiConverter" />
      <local_converters:LedToColorConverter x:Key="LedToColorconverter" />
      <local_converters:LedProfileToName x:Key="LedProfileToName" />
      <local_converters:MatchingObjectToCollapsedConverter x:Key="NucCollapsedConverter" />
      <local_converters:InverseMatchingObjectToCollapsedConverter x:Key="InverseNucCollapsedConverter" />
      <local_converters:ColorPickerColorsToBrushConverter x:Key="ColorPickerConverter" />
      <local_converters:MatchingObjectToVisibilityConverter x:Key="NucVisibilityConverter" />
      <local_converters:LedTypeToVisibilityConverter x:Key="LedTypeToVisibilityConverter" />
      <local_converters:LedIsCheckedMultiConverter x:Key="LedIsCheckedMultiConverter" />
      <Style x:Key="LEDListRadioButton" TargetType="{x:Type RadioButton}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type RadioButton}">
              <Border Name="ButtonBorder" CornerRadius="2,0,0,2" BorderThickness="3, 3, 0, 3" BorderBrush="{StaticResource SeparatorBrush}">
                <ContentControl Content="{Binding Path=Content, RelativeSource={RelativeSource TemplatedParent}}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                  <Setter TargetName="ButtonBorder" Property="Border.BorderBrush" Value="{StaticResource SeparatorBrush}" />
                  <Setter TargetName="ButtonBorder" Property="Border.Background" Value="{StaticResource TabSelectedBackgroundBrush}" />
                  <Setter Property="Foreground" Value="{StaticResource MainTextBrush}" />
                </Trigger>
                <Trigger Property="ToggleButton.IsChecked" Value="False">
                  <Setter TargetName="ButtonBorder" Property="Border.BorderBrush" Value="{StaticResource SeparatorBrush}" />
                  <Setter TargetName="ButtonBorder" Property="Border.Background" Value="#00FFFFFF" />
                  <Setter Property="Foreground" Value="{StaticResource TransparentButtonDefaultTextBrush}" />
                  <Setter TargetName="ButtonBorder" Property="Border.BorderThickness" Value="3" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="LEDListRadioButtonSerpent" TargetType="{x:Type RadioButton}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type RadioButton}">
              <Border Name="ButtonBorder" CornerRadius="2,0,0,2" BorderThickness="3, 3, 0, 3" BorderBrush="{StaticResource SeparatorBrush}">
                <ContentControl Content="{Binding Path=Content, RelativeSource={RelativeSource TemplatedParent}}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                  <Setter TargetName="ButtonBorder" Property="Border.BorderBrush" Value="{StaticResource SeparatorBrush}" />
                  <Setter TargetName="ButtonBorder" Property="Border.Background" Value="{StaticResource TabSelectedBackgroundBrush}" />
                  <Setter Property="Foreground" Value="{StaticResource MainTextBrush}" />
                </Trigger>
                <Trigger Property="ToggleButton.IsChecked" Value="False">
                  <Setter TargetName="ButtonBorder" Property="Border.BorderBrush" Value="#00FFFFFF" />
                  <Setter TargetName="ButtonBorder" Property="Border.Background" Value="#00FFFFFF" />
                  <Setter Property="Foreground" Value="{StaticResource TransparentButtonDefaultTextBrush}" />
                  <Setter TargetName="ButtonBorder" Property="Border.BorderThickness" Value="0" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="{StaticResource CardBackgroundBrush}">
    <ItemsControl Style="{StaticResource DetailCardGridItemsStyle}" Visibility="{Binding Path=DataContext.NucType, Converter={StaticResource InverseNucCollapsedConverter}, ConverterParameter={x:Static NucTypeEnum:NucType.Serpent}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}">
      <Viewbox Grid.Column="1" Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="600" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="20" />
          </Grid.ColumnDefinitions>
          <controls:DetailCardTitleBarControl IconCanvas="{StaticResource LedCardIcon}" TitleText="{StaticResource LedProfileCardTitleString}" VerticalAlignment="Center" />
          <ComboBox Style="{StaticResource ComboBoxStyle}" Height="35" Width="300" FontSize="15" Grid.Column="2" VerticalAlignment="Center" Margin="0,15,0,0" ItemsSource="{Binding Profiles, Mode=OneWay}" SelectedValue="{Binding SelectedProfile, Mode=TwoWay}">
            <ItemsControl.ItemContainerStyle>
              <Style TargetType="{x:Type ComboBoxItem}">
                <Setter Property="Template" Value="{StaticResource BlueDropDownTemplate}" />
              </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding ., Converter={StaticResource LedProfileToName}}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ComboBox>
          <TextBlock Text="{StaticResource EditProfileString}" Foreground="{StaticResource TransparentButtonDefaultTextBrush}" Grid.Column="4" FontSize="18" VerticalAlignment="Center" Margin="0,15,0,0">
            <UIElement.InputBindings>
              <MouseBinding MouseAction="LeftClick" Command="{Binding OpenEditor}" />
            </UIElement.InputBindings>
            <FrameworkElement.Style>
              <Style TargetType="{x:Type TextBlock}">
                <Style.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter Property="UIElement.BitmapEffect">
                      <Setter.Value>
                        <DropShadowBitmapEffect Color="White" Direction="360" ShadowDepth="1" Softness="0.7" Opacity="1" />
                      </Setter.Value>
                    </Setter>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </TextBlock>
          <Button Height="35" MinWidth="100" Background="{StaticResource ToggleButtonTextBackgroundDefault}" BorderBrush="{StaticResource ToggleButtonTextBackgroundDefault}" Foreground="{StaticResource ToggleButtonTextDefault}" FontWeight="Bold" FontSize="18" Content="{StaticResource ResetLedString}" Padding="5,0,5,0" Grid.Column="6" VerticalAlignment="Center" Margin="0,15,0,0" Command="{Binding Reset}" />
          <TextBlock Name="OnOffToggle" Text="{StaticResource ChassisLedEnableString}" Foreground="{StaticResource MainTextBrush}" Style="{StaticResource ToggleButtonLabelText}" Grid.Column="8" FontSize="18" VerticalAlignment="Center" Margin="0,15,0,0" />
          <ToggleButton Name="EnabledToggle" Grid.Column="10" Width="100" Height="35" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,15,0,0" IsChecked="{Binding On, Mode=TwoWay}" IsEnabled="{Binding ProcessComplete}">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type ToggleButton}">
                <Setter Property="Template" Value="{StaticResource BasicToggleButton}" />
                <Style.Triggers>
                  <Trigger Property="ToggleButton.IsChecked" Value="True">
                    <Setter Property="Content" Value="{StaticResource ToggleOnString}" />
                  </Trigger>
                  <Trigger Property="ToggleButton.IsChecked" Value="False">
                    <Setter Property="Content" Value="{StaticResource ToggleOffString}" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </ToggleButton>
        </Grid>
      </Viewbox>
      <Rectangle Grid.Column="1" Grid.Row="3" Style="{StaticResource HorizontalSeparator}" />
