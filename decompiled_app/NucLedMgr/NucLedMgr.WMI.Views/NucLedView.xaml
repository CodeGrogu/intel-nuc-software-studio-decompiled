          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Viewbox Margin="0,0,0,20">
          <style:ClickablePhantom Visibility="{Binding NucType, Converter={StaticResource NucVisibilityConverter}, ConverterParameter={x:Static NucTypeEnum:NucType.Phantom}}" />
        </Viewbox>
        <Viewbox Margin="0,0,0,20">
          <style:ClickableHades Visibility="{Binding NucType, Converter={StaticResource NucVisibilityConverter}, ConverterParameter={x:Static NucTypeEnum:NucType.Hades}}" />
        </Viewbox>
        <Viewbox Margin="0,0,0,20">
          <style:ClickablePanther Visibility="{Binding NucType, Converter={StaticResource NucVisibilityConverter}, ConverterParameter={x:Static NucTypeEnum:NucType.Panther}}" />
        </Viewbox>
        <Viewbox Margin="0,0,0,20">
          <style:ClickableSerpent Visibility="{Binding NucType, Converter={StaticResource NucVisibilityConverter}, ConverterParameter={x:Static NucTypeEnum:NucType.Serpent}}" />
