<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NucLedMgr.WMI.Views.NucLedView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:prism="http://prismlibrary.com/" xmlns:controls="clr-namespace:Infrastructure.Controls;assembly=Infrastructure" xmlns:local="clr-namespace:NucLedMgr.WMI.Views" xmlns:style="clr-namespace:NucLedMgr.Styles" xmlns:enums="clr-namespace:NucLedMgr.WMI.Enums" xmlns:NucTypeEnum="clr-namespace:FeatureMgr.Enums;assembly=FeatureMgr" xmlns:led_converters="clr-namespace:NucLedMgr.Converters" xmlns:local_converters="clr-namespace:NucLedMgr.WMI.Converters" xmlns:Loader="clr-namespace:Infrastructure.ApplicationLoader;assembly=Infrastructure" xmlns:converters="clr-namespace:Infrastructure.Converters;assembly=Infrastructure" ViewModelLocator.AutoWireViewModel="True">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <led_converters:SelectedZoneConverter x:Key="SelectedZoneConverter" />
      <led_converters:ColorCountToHeightConverter x:Key="ColorCountToHeightConverter" />
      <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
