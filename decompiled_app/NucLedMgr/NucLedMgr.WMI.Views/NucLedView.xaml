          <ComboBox Style="{StaticResource ComboBoxStyle}" Height="35" Width="300" FontSize="15" Grid.Column="2" VerticalAlignment="Center" Margin="0,15,0,0" ItemsSource="{Binding Profiles, Mode=OneWay}" SelectedValue="{Binding SelectedProfile, Mode=TwoWay}">
            <ItemsControl.ItemContainerStyle>
              <Style TargetType="{x:Type ComboBoxItem}">
                <Setter Property="Template" Value="{StaticResource BlueDropDownTemplate}" />
              </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding ., Converter={StaticResource LedProfileToName}}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ComboBox>
          <TextBlock Text="{StaticResource EditProfileString}" Foreground="{StaticResource TransparentButtonDefaultTextBrush}" Grid.Column="4" FontSize="18" VerticalAlignment="Center" Margin="0,15,0,0">
            <UIElement.InputBindings>
