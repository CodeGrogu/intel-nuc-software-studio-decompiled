                        <RowDefinition Height="Auto" />
                        <RowDefinition Height=".0" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="15" />
                      </Grid.RowDefinitions>
                      <Viewbox HorizontalAlignment="Center" Grid.Column="1" Grid.Row="1" Grid.RowSpan="3" Child="{StaticResource PowerStateIcon}" Visibility="{Binding SelectedIndicator, Converter={StaticResource IndicatorToVisibilityConverter}, ConverterParameter={x:Static enums:IndicatorType.PowerState}}" />
                      <Viewbox HorizontalAlignment="Center" Grid.Column="1" Grid.Row="1" Grid.RowSpan="3" Child="{StaticResource PowerUsageIcon}" Visibility="{Binding SelectedIndicator, Converter={StaticResource IndicatorToVisibilityConverter}, ConverterParameter={x:Static enums:IndicatorType.PowerLimit}}" />
                      <Viewbox HorizontalAlignment="Center" Grid.Column="1" Grid.Row="1" Grid.RowSpan="3" Child="{StaticResource HardDriveIcon}" Visibility="{Binding SelectedIndicator, Converter={StaticResource IndicatorToVisibilityConverter}, ConverterParameter={x:Static enums:IndicatorType.HddActivity}}" />
                      <Viewbox HorizontalAlignment="Center" Grid.Column="1" Grid.Row="1" Grid.RowSpan="3" Child="{StaticResource WiFiIcon}" Visibility="{Binding SelectedIndicator, Converter={StaticResource IndicatorToVisibilityConverter}, ConverterParameter={x:Static enums:IndicatorType.Wifi}}" />
                      <Viewbox HorizontalAlignment="Center" Grid.Column="1" Grid.Row="1" Grid.RowSpan="3" Child="{StaticResource LANIcon}" Visibility="{Binding SelectedIndicator, Converter={StaticResource IndicatorToVisibilityConverter}, ConverterParameter={x:Static enums:IndicatorType.Ethernet}}" />
                      <Viewbox HorizontalAlignment="Center" Grid.Column="1" Grid.Row="1" Grid.RowSpan="3" Child="{StaticResource CPUIcon}" Visibility="{Binding SelectedIndicator, Converter={StaticResource IndicatorToVisibilityConverter}, ConverterParameter={x:Static enums:IndicatorType.Software}}" />
                      <Viewbox HorizontalAlignment="Center" Grid.Column="1" Grid.Row="1" Grid.RowSpan="3" Child="{StaticResource DisableIcon}" Visibility="{Binding SelectedIndicator, Converter={StaticResource IndicatorToVisibilityConverter}, ConverterParameter={x:Static enums:IndicatorType.Disable}}" />
                      <Viewbox HorizontalAlignment="Center" Grid.Column="1" Grid.Row="1" Grid.RowSpan="3" Child="{StaticResource WhitePowerStateIcon}">
                        <UIElement.Visibility>
                          <MultiBinding Converter="{StaticResource IndicatorIsCheckedMultiConverter}" ConverterParameter="{x:Static enums:IndicatorType.PowerState}">
                            <Binding Path="." />
                            <Binding Path="DataContext.SelectedLed" RelativeSource="{RelativeSource AncestorType=UserControl, Mode=FindAncestor}" />
                            <Binding Path="SelectedIndicator" />
                          </MultiBinding>
                        </UIElement.Visibility>
                      </Viewbox>
                      <Viewbox HorizontalAlignment="Center" Grid.Column="1" Grid.Row="1" Grid.RowSpan="3" Child="{StaticResource WhitePowerUsageIcon}">
                        <UIElement.Visibility>
                          <MultiBinding Converter="{StaticResource IndicatorIsCheckedMultiConverter}" ConverterParameter="{x:Static enums:IndicatorType.PowerLimit}">
                            <Binding Path="." />
                            <Binding Path="DataContext.SelectedLed" RelativeSource="{RelativeSource AncestorType=UserControl, Mode=FindAncestor}" />
                            <Binding Path="SelectedIndicator" />
                          </MultiBinding>
                        </UIElement.Visibility>
                      </Viewbox>
                      <Viewbox HorizontalAlignment="Center" Grid.Column="1" Grid.Row="1" Grid.RowSpan="3" Child="{StaticResource WhiteHardDriveIcon}">
                        <UIElement.Visibility>
                          <MultiBinding Converter="{StaticResource IndicatorIsCheckedMultiConverter}" ConverterParameter="{x:Static enums:IndicatorType.HddActivity}">
                            <Binding Path="." />
                            <Binding Path="DataContext.SelectedLed" RelativeSource="{RelativeSource AncestorType=UserControl, Mode=FindAncestor}" />
                            <Binding Path="SelectedIndicator" />
                          </MultiBinding>
                        </UIElement.Visibility>
                      </Viewbox>
                      <Viewbox HorizontalAlignment="Center" Grid.Column="1" Grid.Row="1" Grid.RowSpan="3" Child="{StaticResource WhiteWiFiIcon}">
                        <UIElement.Visibility>
                          <MultiBinding Converter="{StaticResource IndicatorIsCheckedMultiConverter}" ConverterParameter="{x:Static enums:IndicatorType.Wifi}">
                            <Binding Path="." />
                            <Binding Path="DataContext.SelectedLed" RelativeSource="{RelativeSource AncestorType=UserControl, Mode=FindAncestor}" />
                            <Binding Path="SelectedIndicator" />
                          </MultiBinding>
                        </UIElement.Visibility>
                      </Viewbox>
                      <Viewbox HorizontalAlignment="Center" Grid.Column="1" Grid.Row="1" Grid.RowSpan="3" Child="{StaticResource WhiteLANIcon}">
                        <UIElement.Visibility>
                          <MultiBinding Converter="{StaticResource IndicatorIsCheckedMultiConverter}" ConverterParameter="{x:Static enums:IndicatorType.Ethernet}">
                            <Binding Path="." />
                            <Binding Path="DataContext.SelectedLed" RelativeSource="{RelativeSource AncestorType=UserControl, Mode=FindAncestor}" />
                            <Binding Path="SelectedIndicator" />
                          </MultiBinding>
                        </UIElement.Visibility>
                      </Viewbox>
                      <Viewbox HorizontalAlignment="Center" Grid.Column="1" Grid.Row="1" Grid.RowSpan="3" Child="{StaticResource WhiteCPUIcon}">
                        <UIElement.Visibility>
                          <MultiBinding Converter="{StaticResource IndicatorIsCheckedMultiConverter}" ConverterParameter="{x:Static enums:IndicatorType.Software}">
                            <Binding Path="." />
                            <Binding Path="DataContext.SelectedLed" RelativeSource="{RelativeSource AncestorType=UserControl, Mode=FindAncestor}" />
                            <Binding Path="SelectedIndicator" />
                          </MultiBinding>
                        </UIElement.Visibility>
                      </Viewbox>
                      <Viewbox HorizontalAlignment="Center" Grid.Column="1" Grid.Row="1" Grid.RowSpan="3" Child="{StaticResource WhiteDisableIcon}">
                        <UIElement.Visibility>
                          <MultiBinding Converter="{StaticResource IndicatorIsCheckedMultiConverter}" ConverterParameter="{x:Static enums:IndicatorType.Disable}">
                            <Binding Path="." />
                            <Binding Path="DataContext.SelectedLed" RelativeSource="{RelativeSource AncestorType=UserControl, Mode=FindAncestor}" />
                            <Binding Path="SelectedIndicator" />
                          </MultiBinding>
                        </UIElement.Visibility>
                      </Viewbox>
                      <TextBlock FontSize="35" Grid.Row="1" Grid.Column="3" HorizontalAlignment="Left" Text="{Binding Name}" />
                      <TextBlock FontSize="30" Foreground="{StaticResource DefaultControlText}" Grid.Row="3" Grid.Column="3" HorizontalAlignment="Left" Text="{Binding IndicatorName}" />
                      <Rectangle Width="25" Height="55" Grid.Column="5" Grid.Row="1" Grid.RowSpan="3" Fill="{Binding SelectedColors, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ColorPickerConverter}}" />
                    </Grid>
                  </RadioButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Viewbox>
          <Border BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0, 2, 2, 2" Grid.Column="1">
            <local:WmiLedControl VerticalAlignment="Stretch" HorizontalAlignment="Stretch" DataContext="{Binding SelectedLed}" />
          </Border>
        </Grid>
      </Grid>
      <Rectangle Grid.Row="0" Grid.RowSpan="9" Grid.ColumnSpan="3" Fill="#FF000000" Opacity="0.75" Visibility="{Binding Open, Converter={StaticResource BoolToVis}}">
        <i:Interaction.Triggers>
          <i:EventTrigger EventName="MouseDown">
            <i:InvokeCommandAction Command="{Binding CloseEditor}" />
          </i:EventTrigger>
        </i:Interaction.Triggers>
      </Rectangle>
      <controls:ProfileEditor Name="ProfEditor" Grid.Row="0" Grid.RowSpan="6" Grid.ColumnSpan="2" Margin="40" Visibility="{Binding Open, Converter={StaticResource BoolToVisibilityConverter}}" />
      <Rectangle Grid.Row="0" Grid.RowSpan="6" Grid.ColumnSpan="2" Fill="#FF000000" Opacity="0.25" Visibility="{Binding SmallLoadScreen, Converter={StaticResource BoolToVisibilityConverter}}" />
      <Viewbox Grid.Row="0" Grid.RowSpan="6" Grid.ColumnSpan="2" Margin="0,0,0,75" Visibility="{Binding SmallLoadScreen, Converter={StaticResource BoolToVisibilityConverter}}">
