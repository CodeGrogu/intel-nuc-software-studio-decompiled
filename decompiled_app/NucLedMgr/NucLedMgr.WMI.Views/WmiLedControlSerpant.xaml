<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NucLedMgr.WMI.Views.WmiLedControlSerpant" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local_converters="clr-namespace:NucLedMgr.WMI.Converters" xmlns:enums="clr-namespace:NucLedMgr.WMI.Enums" xmlns:local="clr-namespace:NucLedMgr.WMI.Views" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <local_converters:IndicatorToIsSelectedConverter x:Key="IndicatorToIsSelectedConverter" />
      <local_converters:IndicatorToVisibilityConverter x:Key="IndicatorToVisibilityConverter" />
      <local_converters:ClassToIndicatorConverter x:Key="ClassToIndicatorConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="{StaticResource TabSelectedBackgroundBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="20" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="30" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height=".2*" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Viewbox Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Left" VerticalAlignment="Center" MinWidth="540" MaxWidth="1440" Margin="0,0,10,0">
      <Grid>
        <local:WiFiControlView Visibility="{Binding SelectedIndicator, FallbackValue=Hidden, Converter={StaticResource IndicatorToVisibilityConverter}, ConverterParameter={x:Static enums:IndicatorType.Wifi}}" />
        <local:EthernetControlView Visibility="{Binding SelectedIndicator, FallbackValue=Hidden, Converter={StaticResource IndicatorToVisibilityConverter}, ConverterParameter={x:Static enums:IndicatorType.Ethernet}}" />
        <local:HDDControlSerpantView Visibility="{Binding SelectedIndicator, FallbackValue=Hidden, Converter={StaticResource IndicatorToVisibilityConverter}, ConverterParameter={x:Static enums:IndicatorType.HddActivity}}" />
        <local:PowerLimitControlView Visibility="{Binding SelectedIndicator, FallbackValue=Hidden, Converter={StaticResource IndicatorToVisibilityConverter}, ConverterParameter={x:Static enums:IndicatorType.PowerLimit}}" />
        <local:PowerStateControlSerpantView Visibility="{Binding SelectedIndicator, FallbackValue=Hidden, Converter={StaticResource IndicatorToVisibilityConverter}, ConverterParameter={x:Static enums:IndicatorType.PowerState}}" />
        <local:SoftwareControlView Visibility="{Binding SelectedIndicator, FallbackValue=Hidden, Converter={StaticResource IndicatorToVisibilityConverter}, ConverterParameter={x:Static enums:IndicatorType.Software}}" />
        <local:AlexaControlView Visibility="{Binding SelectedIndicator, FallbackValue=Hidden, Converter={StaticResource IndicatorToVisibilityConverter}, ConverterParameter={x:Static enums:IndicatorType.Alexa}}" />
        <Grid Visibility="{Binding SelectedIndicator, FallbackValue=Hidden, Converter={StaticResource IndicatorToVisibilityConverter}, ConverterParameter={x:Static enums:IndicatorType.Disable}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="1" Text="{StaticResource LedOffString}" Foreground="{StaticResource DefaultControlText}" FontSize="30" HorizontalAlignment="Center" />
          <Viewbox Grid.Row="2" Child="{StaticResource BigDisableIcon}" />
        </Grid>
      </Grid>
    </Viewbox>
    <Viewbox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width=".3*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{StaticResource SerpentIndicatorTypeString}" Foreground="{StaticResource MainTextBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" />
        <ComboBox Grid.Column="2" Margin="10,0,4.5,0" Style="{StaticResource ComboBoxStyle}" MinWidth="150" ItemsSource="{Binding SupportedIndicators, UpdateSourceTrigger=PropertyChanged}" SelectedItem="{Binding SelectedIndicator, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.On, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor, AncestorLevel=2}}">
          <i:Interaction.Triggers>
            <i:EventTrigger EventName="MouseLeave">
              <i:InvokeCommandAction Command="{Binding UpdateUI}" />
            </i:EventTrigger>
          </i:Interaction.Triggers>
          <ItemsControl.ItemContainerStyle>
            <Style TargetType="{x:Type ComboBoxItem}">
              <Setter Property="Template" Value="{StaticResource BlueDropDownTemplate}" />
            </Style>
          </ItemsControl.ItemContainerStyle>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="5" />
                  <ColumnDefinition Width="5" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center" Text="{Binding ., Converter={StaticResource ClassToIndicatorConverter}}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ComboBox>
      </Grid>
    </Viewbox>
  </Grid>
</UserControl>