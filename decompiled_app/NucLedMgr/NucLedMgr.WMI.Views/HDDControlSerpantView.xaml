<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NucLedMgr.WMI.Views.HDDControlSerpantView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:enums="clr-namespace:FeatureMgr.Enums;assembly=FeatureMgr" xmlns:models="clr-namespace:NucLedMgr.WMI.Models" xmlns:controls="clr-namespace:NucLedMgr.WMI.Controls" xmlns:local_converters="clr-namespace:NucLedMgr.WMI.Converters" xmlns:views="clr-namespace:NucLedMgr.WMI.Views">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <local_converters:IndicatorBehaviorToBoolConverter x:Key="IndicatorBehaviorToBoolConverter" />
      <local_converters:InverseMatchingObjectToVisibilityConverter x:Key="InverseNucToVisConverter" />
      <local_converters:StandardColorsArrayConverter x:Key="StandardColorsArrayConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid VerticalAlignment="Center">
    <Grid Background="{StaticResource TabSelectedBackgroundBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition MaxWidth="10" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="100" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Viewbox Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-50,-100,0">
        <controls:ColorPickerSerpent DataContext="{Binding SelectedColors[0], FallbackValue={StaticResource DefaultColor}}" SerpentDisplayRecentColors="{Binding DataContext.NucType, Converter={StaticResource InverseNucToVisConverter}, ConverterParameter={x:Static enums:NucType.Panther}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorLevel=3, AncestorType=UserControl}}" SerpentStandardColorsArray="{Binding DataContext, Converter={StaticResource StandardColorsArrayConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorLevel=2, AncestorType=UserControl}}" />
      </Viewbox>
      <StackPanel Orientation="Horizontal" Grid.Row="4" Grid.Column="4" Grid.RowSpan="3" HorizontalAlignment="Right" Margin="-20,-50,150,0">
        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" BorderThickness="1" BorderBrush="{StaticResource SeparatorBrush}" />
      </StackPanel>
      <Grid Row="1" Column="4" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="20,-50,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="20" />
          <RowDefinition Height="*" />
          <RowDefinition Height="30" />
          <RowDefinition Height="*" />
          <RowDefinition Height="10" />
          <RowDefinition Height="*" />
          <RowDefinition Height="10" />
          <RowDefinition Height="*" />
          <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Column="1" Text="{StaticResource LedStyleString}" Style="{StaticResource ColorPickerTitleText}" />
        <RadioButton Grid.Column="1" Grid.Row="4" Style="{StaticResource RadioButtonControlBlue}" IsChecked="{Binding SelectedBehavior, Converter={StaticResource IndicatorBehaviorToBoolConverter}, ConverterParameter={x:Static models:Behaviors.OffToOn}}">
          <TextBlock Text="{StaticResource OffToOnString}" Style="{StaticResource NavBarText}" />
        </RadioButton>
        <RadioButton Grid.Column="1" Grid.Row="6" Style="{StaticResource RadioButtonControlBlue}" IsChecked="{Binding SelectedBehavior, Converter={StaticResource IndicatorBehaviorToBoolConverter}, ConverterParameter={x:Static models:Behaviors.OnToOff}}">
          <TextBlock Text="{StaticResource OnToOffString}" Style="{StaticResource NavBarText}" />
        </RadioButton>
      </Grid>
    </Grid>
    <Grid Background="{StaticResource TabSelectedBackgroundBrush}" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="2*" />
        <RowDefinition Height="*" />
        <RowDefinition Height="0.2*" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Viewbox HorizontalAlignment="Left" VerticalAlignment="Top">
        <TextBlock Style="{StaticResource NavBarText}" Text="{Binding Name}" />
      </Viewbox>
      <Viewbox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Top" HorizontalAlignment="Stretch" Stretch="Uniform">
        <Grid Background="#FFF0F8FF">
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
          </Grid.RowDefinitions>
          <TextBlock Text="{StaticResource AlexaLedString}" Style="{StaticResource NavBarText}" />
        </Grid>
      </Viewbox>
    </Grid>
  </Grid>
</UserControl>