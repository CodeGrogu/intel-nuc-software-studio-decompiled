<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NucLedMgr.WMI.Views.WmiLedSummaryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Infrastructure.Controls;assembly=Infrastructure" xmlns:converters="clr-namespace:Infrastructure.Converters;assembly=Infrastructure" xmlns:local="clr-namespace:NucLedMgr.WMI.Views" xmlns:style="clr-namespace:NucLedMgr.Styles" xmlns:local_converters="clr-namespace:NucLedMgr.WMI.Converters" xmlns:enums="clr-namespace:FeatureMgr.Enums;assembly=FeatureMgr" xmlns:Loader="clr-namespace:Infrastructure.ApplicationLoader;assembly=Infrastructure" xmlns:prism="http://prismlibrary.com/" x:Name="WmiLedSummaryCard" ViewModelLocator.AutoWireViewModel="True">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <local_converters:MatchingObjectToVisibilityConverter x:Key="NucVisibilityConverter" />
      <local_converters:InverseMatchingObjectToVisibilityConverter x:Key="InverseNucVisibilityConverter" />
      <local_converters:MatchingObjectToCollapsedConverter x:Key="NucCollapsedConverter" />
      <local_converters:InverseMatchingObjectToCollapsedConverter x:Key="InverseNucCollapsedConverter" />
      <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
      <converters:InverseVisibilityConverter x:Key="InverseVisibilityConverter" />
      <converters:InverseBooleanConverter x:Key="InverseBool" />
      <local_converters:LedProfileToName x:Key="LedProfileToName" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="{StaticResource CardBackgroundBrush}">
    <ItemsControl Style="{StaticResource DynamicCardGridItemsStyle}" Visibility="{Binding Path=DataContext.NucType, Converter={StaticResource InverseNucCollapsedConverter}, ConverterParameter={x:Static enums:NucType.Serpent}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}">
      <controls:LargeCardTitleBarControl Grid.Row="1" Grid.Column="1" IconCanvas="{StaticResource LedCardIcon}" TitleText="{StaticResource ChassisLedCardTitleString}" OpenDetailView="{Binding Path=DataContext.OpenDetailView, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" Visibility="{Binding Path=DataContext.NucType, Converter={StaticResource InverseNucCollapsedConverter}, ConverterParameter={x:Static enums:NucType.Panther}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
      <controls:CardTitleBarControl Grid.Row="1" Grid.Column="1" IconCanvas="{StaticResource LedCardIcon}" TitleText="{StaticResource ChassisLedCardTitleString}" OpenDetailView="{Binding Path=DataContext.OpenDetailView, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" Visibility="{Binding Path=DataContext.NucType, Converter={StaticResource NucCollapsedConverter}, ConverterParameter={x:Static enums:NucType.Panther}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
      <Grid Row="3" Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="50" />
          <RowDefinition>
            <FrameworkContentElement.Style>
              <Style TargetType="{x:Type RowDefinition}">
                <Setter Property="Height" Value="*" />
                <Style.Triggers>
                  <DataTrigger Value="True">
                    <DataTrigger.Binding>
                      <MultiBinding Converter="{StaticResource FirstIsGreaterOrEqualConverter}">
                        <Binding ElementName="WmiLedSummaryCard" Path="ActualWidth" />
                        <Binding ElementName="WmiLedSummaryCard" Path="ActualHeight" />
                      </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Height" Value="30" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkContentElement.Style>
          </RowDefinition>
        </Grid.RowDefinitions>
        <Viewbox Stretch="Uniform" Grid.Row="0" Visibility="{Binding NucType, Converter={StaticResource InverseNucCollapsedConverter}, ConverterParameter={x:Static enums:NucType.Panther}}">
          <Grid>
            <style:ClickablePhantom VerticalAlignment="Center" Visibility="{Binding NucType, Converter={StaticResource NucVisibilityConverter}, ConverterParameter={x:Static enums:NucType.Phantom}}" />
            <style:ClickableHades VerticalAlignment="Center" Visibility="{Binding NucType, Converter={StaticResource NucVisibilityConverter}, ConverterParameter={x:Static enums:NucType.Hades}}" />
            <TextBlock Name="ErrorMessage" Text="{StaticResource ProductErrorString}" Style="{StaticResource ColorPickerTitleText}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding NucType, Converter={StaticResource NucVisibilityConverter}, ConverterParameter={x:Static enums:NucType.Error}}" />
            <Rectangle Fill="#00FFFFFF" />
          </Grid>
        </Viewbox>
        <Grid Row="0" VerticalAlignment="Top" Visibility="{Binding NucType, Converter={StaticResource NucCollapsedConverter}, ConverterParameter={x:Static enums:NucType.Panther}}">
          <style:ClickablePantherSummary VerticalAlignment="Center" Visibility="{Binding NucType, Converter={StaticResource NucVisibilityConverter}, ConverterParameter={x:Static enums:NucType.Panther}}" />
          <TextBlock Name="ErrorMessage2" Text="{StaticResource ProductErrorString}" Style="{StaticResource ColorPickerTitleText}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding NucType, Converter={StaticResource NucVisibilityConverter}, ConverterParameter={x:Static enums:NucType.Error}}" />
          <Rectangle Fill="#00FFFFFF" />
        </Grid>
        <Viewbox Grid.Row="1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="4*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <ComboBox Style="{StaticResource ComboBoxStyle}" HorizontalAlignment="Left" Width="250" Height="25" ItemsSource="{Binding Profiles, Mode=OneWay}" SelectedValue="{Binding SelectedProfile, Mode=TwoWay}" IsEnabled="{Binding ElementName=ErrorMessage, Path=IsVisible, Converter={StaticResource InverseBool}}">
              <ItemsControl.ItemContainerStyle>
                <Style TargetType="{x:Type ComboBoxItem}">
                  <Setter Property="Template" Value="{StaticResource BlueDropDownTemplate}" />
                </Style>
              </ItemsControl.ItemContainerStyle>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding ., Converter={StaticResource LedProfileToName}}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ComboBox>
            <Separator Grid.Column="1" Background="#00FFFFFF" Width="850" Visibility="{Binding NucType, Converter={StaticResource InverseNucCollapsedConverter}, ConverterParameter={x:Static enums:NucType.Panther}}" />
            <Separator Grid.Column="1" Background="#00FFFFFF" Width="100" Visibility="{Binding NucType, Converter={StaticResource NucCollapsedConverter}, ConverterParameter={x:Static enums:NucType.Panther}}" />
            <TextBlock Text="{StaticResource EffectsString}" Style="{StaticResource AppTitleText}" Margin="0,-5,5,0" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="2" />
            <ToggleButton HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="3" Width="80" Height="25" IsChecked="{Binding On, Mode=TwoWay}" IsEnabled="{Binding ElementName=ErrorMessage, Path=IsVisible, Converter={StaticResource InverseBool}}">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type ToggleButton}">
                  <Setter Property="Template" Value="{StaticResource BasicToggleButton}" />
                  <Style.Triggers>
                    <Trigger Property="ToggleButton.IsChecked" Value="True">
                      <Setter Property="Content" Value="{StaticResource ToggleOnString}" />
                    </Trigger>
                    <Trigger Property="ToggleButton.IsChecked" Value="False">
                      <Setter Property="Content" Value="{StaticResource ToggleOffString}" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </ToggleButton>
          </Grid>
        </Viewbox>
      </Grid>
    </ItemsControl>
    <ItemsControl Style="{StaticResource DynamicCardGridItemsStyle}" Visibility="{Binding Path=DataContext.NucType, Converter={StaticResource NucCollapsedConverter}, ConverterParameter={x:Static enums:NucType.Serpent}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}">
      <controls:LargeCardTitleBarControl Grid.Row="1" Grid.Column="1" IconCanvas="{StaticResource LedCardIcon}" TitleText="{StaticResource ChassisLedCardTitleString}" OpenDetailView="{Binding Path=DataContext.OpenDetailView, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" Visibility="{Binding Path=DataContext.NucType, Converter={StaticResource InverseNucCollapsedConverter}, ConverterParameter={x:Static enums:NucType.Panther}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
      <controls:CardTitleBarControl Grid.Row="1" Grid.Column="1" IconCanvas="{StaticResource LedCardIcon}" TitleText="{StaticResource ChassisLedCardTitleString}" OpenDetailView="{Binding Path=DataContext.OpenDetailView, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" Visibility="{Binding Path=DataContext.NucType, Converter={StaticResource NucCollapsedConverter}, ConverterParameter={x:Static enums:NucType.Panther}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
      <Grid Row="3" Column="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="7.5*" />
          <ColumnDefinition Width=".5*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="*" />
          <RowDefinition Height="*" />
          <RowDefinition Height="*" />
          <RowDefinition Height="*" />
          <RowDefinition Height="*" />
          <RowDefinition Height="*" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Viewbox Grid.Row="0" VerticalAlignment="Top" Grid.Column="0" Grid.RowSpan="2" Margin="0,0,0,25" HorizontalAlignment="Left">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="2*" />
              <RowDefinition Height="3*" />
              <RowDefinition Height="2*" />
              <RowDefinition Height="3*" />
            </Grid.RowDefinitions>
            <TextBlock Text="{StaticResource LedProfileCardTitleString}" Style="{StaticResource AppTitleText}" Margin="0,-5,5,10" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="0" Grid.Row="1" />
            <ComboBox Grid.Row="3" Style="{StaticResource ComboBoxStyle}" HorizontalAlignment="Left" Width="250" Height="35" ItemsSource="{Binding Profiles, Mode=OneWay}" SelectedValue="{Binding SelectedProfile, Mode=TwoWay}" IsEnabled="{Binding ElementName=ErrorMessage, Path=IsVisible, Converter={StaticResource InverseBool}}">
              <ItemsControl.ItemContainerStyle>
                <Style TargetType="{x:Type ComboBoxItem}">
                  <Setter Property="Template" Value="{StaticResource BlueDropDownTemplate}" />
                </Style>
              </ItemsControl.ItemContainerStyle>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock FontSize="20" Text="{Binding ., Converter={StaticResource LedProfileToName}}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ComboBox>
          </Grid>
        </Viewbox>
        <Viewbox Stretch="Uniform" Grid.Row="0" Grid.RowSpan="7" Margin="0,-20,0,0" HorizontalAlignment="Left" Grid.Column="1" VerticalAlignment="Top" Visibility="{Binding NucType, Converter={StaticResource InverseNucCollapsedConverter}, ConverterParameter={x:Static enums:NucType.Panther}}">
          <Grid>
            <style:ClickableSerpent VerticalAlignment="Center" Visibility="{Binding NucType, Converter={StaticResource NucVisibilityConverter}, ConverterParameter={x:Static enums:NucType.Serpent}}" />
            <TextBlock Text="{StaticResource ProductErrorString}" Style="{StaticResource ColorPickerTitleText}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding NucType, Converter={StaticResource NucVisibilityConverter}, ConverterParameter={x:Static enums:NucType.Error}}" />
            <Rectangle Fill="#00FFFFFF" />
          </Grid>
        </Viewbox>
        <Viewbox Grid.Row="7" HorizontalAlignment="Left" Grid.Column="0" Margin="0,0,0,10">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="8*" />
              <RowDefinition Height="2*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{StaticResource EffectsString}" Style="{StaticResource AppTitleText}" Margin="0,-5,10,0" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="0" Grid.Row="1" />
            <ToggleButton HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="2" Width="100" Height="35" Grid.Row="1" IsChecked="{Binding On, Mode=TwoWay}" IsEnabled="{Binding ElementName=ErrorMessage, Path=IsVisible, Converter={StaticResource InverseBool}}">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type ToggleButton}">
                  <Setter Property="Template" Value="{StaticResource BasicToggleButton}" />
                  <Style.Triggers>
                    <Trigger Property="ToggleButton.IsChecked" Value="True">
                      <Setter Property="Content" Value="{StaticResource ToggleOnString}" />
                    </Trigger>
                    <Trigger Property="ToggleButton.IsChecked" Value="False">
                      <Setter Property="Content" Value="{StaticResource ToggleOffString}" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </ToggleButton>
          </Grid>
        </Viewbox>
      </Grid>
    </ItemsControl>
    <Grid Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="1*" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="1*" />
      </Grid.RowDefinitions>
      <Viewbox Child="{StaticResource IntelLogo}" Grid.Row="1" Visibility="{Binding ShowIntelLogo, Converter={StaticResource BoolToVis}}" />
      <Image Grid.Row="1" Source="{Binding AppLogo}" Visibility="{Binding ShowIntelLogo, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
      <Grid Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{StaticResource LoadingString}" Style="{StaticResource AppTitleText}" HorizontalAlignment="Right" Margin="0,20,0,0" />
        <TextBlock Style="{StaticResource AppTitleText}" HorizontalAlignment="Left" Grid.Column="1" Margin="0,20,0,0">
          <FrameworkElement.Triggers>
            <EventTrigger RoutedEvent="Loaded">
              <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                  <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Text">
                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value=" . . ." />
                    <DiscreteObjectKeyFrame KeyTime="0:0:1" Value=" ." />
                    <DiscreteObjectKeyFrame KeyTime="0:0:2" Value=" . ." />
                    <DiscreteObjectKeyFrame KeyTime="0:0:3" Value=" " />
                  </ObjectAnimationUsingKeyFrames>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </FrameworkElement.Triggers>
        </TextBlock>
      </Grid>
    </Grid>
    <Grid Visibility="{Binding LedsAvailable, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="1*" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="1*" />
      </Grid.RowDefinitions>
      <Rectangle Fill="#FF000000" Opacity="0.5" Grid.RowSpan="4" Grid.ColumnSpan="2" />
      <Loader:LoaderAnimation VerticalAlignment="Center" Grid.Row="1" HorizontalAlignment="Center" Height="1" Width="1" />
    </Grid>
  </Grid>
</UserControl>