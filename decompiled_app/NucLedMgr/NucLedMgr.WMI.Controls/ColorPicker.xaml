<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="NucLedMgr.WMI.Controls.ColorPicker" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:prism="http://prismlibrary.com/" ViewModelLocator.AutoWireViewModel="True" xmlns:controls="clr-namespace:NucLedMgr.WMI.Controls;assembly=NucLedMgr">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <DataTemplate x:Key="ColorPickerSquare">
        <Border>
          <Grid>
            <Rectangle Name="ColorRectangle" Width="27" Height="27">
              <Shape.Fill>
                <SolidColorBrush Color="{Binding FallbackValue={StaticResource DefaultColor}}" />
              </Shape.Fill>
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseDown">
                  <i:InvokeCommandAction Command="{Binding DataContext.SelectColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl, AncestorLevel=1}}" CommandParameter="{Binding .}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </Rectangle>
            <Rectangle Width="{Binding ElementName=ColorRectangle, Path=Width}" Height="{Binding ElementName=ColorRectangle, Path=Height}" Margin="{Binding ElementName=ColorRectangle, Path=Margin}">
              <Shape.Fill>
                <SolidColorBrush Color="LightGray" Opacity="{Binding Path=IsEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}, Converter={StaticResource ReverseBoolToOpacityConverter}}" />
              </Shape.Fill>
              <FrameworkElement.Style>
                <Style TargetType="{x:Type Rectangle}">
                  <Style.Triggers>
                    <DataTrigger Value="True" Binding="{Binding Path=IsEnabled, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}}">
                      <Setter Property="Fill" Value="#00FFFFFF" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </Rectangle>
            <i:Interaction.Triggers>
              <i:EventTrigger EventName="MouseDown">
                <i:InvokeCommandAction Command="{Binding DataContext.SelectColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl, AncestorLevel=1}}" CommandParameter="{Binding .}" />
              </i:EventTrigger>
            </i:Interaction.Triggers>
          </Grid>
          <FrameworkElement.Style>
            <Style TargetType="{x:Type Border}">
              <Setter Property="BorderThickness" Value="1" />
              <Setter Property="Margin" Value="4" />
              <Setter Property="BorderBrush" Value="#00FFFFFF" />
              <Style.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="BorderBrush" Value="{StaticResource HoverControlForeground}" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </Border>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Viewbox VerticalAlignment="Top">
      <Grid Name="ColorPickerGrid" VerticalAlignment="Top" IsEnabled="{Binding Enabled}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="30" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="75" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="75" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="25" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="30" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition>
            <FrameworkContentElement.Style>
              <Style TargetType="{x:Type RowDefinition}">
                <Setter Property="Height" Value="Auto" />
                <Style.Triggers>
                  <DataTrigger Value="Hidden" Binding="{Binding Path=Visibility, ElementName=StandardColorsLabel, NotifyOnSourceUpdated=True}">
                    <Setter Property="Height" Value="0" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkContentElement.Style>
          </RowDefinition>
          <RowDefinition>
            <FrameworkContentElement.Style>
              <Style TargetType="{x:Type RowDefinition}">
                <Setter Property="Height" Value="15" />
                <Style.Triggers>
                  <DataTrigger Value="Hidden" Binding="{Binding Path=Visibility, ElementName=StandardColorsLabel, NotifyOnSourceUpdated=True}">
                    <Setter Property="Height" Value="0" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkContentElement.Style>
          </RowDefinition>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="16" />
        </Grid.RowDefinitions>
        <TextBlock Text="{StaticResource LedColorPickerString}" Style="{StaticResource ColorPickerTitleText}" Grid.Column="1" Visibility="{Binding Index, Converter={StaticResource FirstItemVisibleConverter}}" />
        <Rectangle Grid.Row="2" Width="250" Height="30" HorizontalAlignment="Left" Grid.Column="1" Visibility="{Binding Rainbow, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
          <Shape.Fill>
            <SolidColorBrush Color="{Binding SelectedColor, FallbackValue={StaticResource DefaultColor}}" />
          </Shape.Fill>
        </Rectangle>
        <Rectangle Grid.Row="2" Width="250" Height="30" HorizontalAlignment="Left" Grid.Column="1" Visibility="{Binding Rainbow, Converter={StaticResource BoolToHidden}}">
          <Shape.Fill>
            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
              <GradientStop x:Name="GradientStop1" Offset="0.0" Color="{Binding DataContext.SelectedColors[0].SelectedColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl, AncestorLevel=2}}" />
              <GradientStop x:Name="GradientStop2" Offset=".7" Color="{Binding DataContext.SelectedColors[1].SelectedColor, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl, AncestorLevel=2}}" />
            </LinearGradientBrush>
          </Shape.Fill>
        </Rectangle>
        <TextBlock Name="StandardColorsLabel" Grid.Column="3" Text="{StaticResource StandardColorsString}" Style="{StaticResource ColorPickerTitleText}" Visibility="{Binding Index, Converter={StaticResource FirstItemVisibleConverter}}" />
        <ItemsControl Name="StandardColorsList" Grid.Column="3" Grid.Row="2" Margin="-4,0" ItemTemplate="{StaticResource ColorPickerSquare}" ItemsSource="{Binding StandardColors}" Visibility="{Binding StandardColorsArray, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl, AncestorLevel=1}}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <ItemsControl Name="StandardColorsList2" Grid.Column="3" Grid.Row="2" Margin="-4,0" ItemTemplate="{StaticResource ColorPickerSquare}" ItemsSource="{Binding PantherPowerColors}" Visibility="{Binding StandardColorsArray, Converter={StaticResource InverseVisibilityConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl, AncestorLevel=1}}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <TextBlock Grid.Column="5" Text="{StaticResource RecentColorsString}" Style="{StaticResource ColorPickerTitleText}" Visibility="{Binding DisplayRecentColors, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl, AncestorLevel=1}}" />
        <ItemsControl Grid.Column="5" Grid.Row="2" Margin="-4,0" ItemTemplate="{StaticResource ColorPickerSquare}" Width="{Binding ElementName=StandardColorsList, Path=ActualWidth}" ItemsSource="{Binding RecentColors}" Visibility="{Binding DisplayRecentColors, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl, AncestorLevel=1}}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <Grid Column="7" Row="2" IsEnabled="{Binding Enabled}" Visibility="{Binding DisplayRecentColors, Converter={StaticResource BoolToVis}}">
          <Button Style="{StaticResource TransparentButton}" Tag="{StaticResource MoreColorsString}" FontSize="20" Command="{Binding OpenColorPicker}" Visibility="{Binding DisplayRecentColors, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl, AncestorLevel=1}}" />
        </Grid>
      </Grid>
    </Viewbox>
  </Grid>
</UserControl>