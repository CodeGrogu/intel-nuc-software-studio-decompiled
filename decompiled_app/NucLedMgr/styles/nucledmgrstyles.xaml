<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ControlTemplate x:Key="NucLedTabControlItem" TargetType="{x:Type TabItem}">
    <Grid Name="HeaderPanel" Margin="0,0,3,0">
      <Border Name="TabHeaderBorder" BorderThickness="2,2,2,0" BorderBrush="{StaticResource SeparatorBrush}">
        <Grid MinWidth="300" Height="77">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Viewbox Grid.Column="1" Grid.Row="1" StretchDirection="DownOnly">
            <TextBlock Name="ContentSite" Text="{TemplateBinding HeaderedContentControl.Header}" Margin="5,2" FontSize="40" Style="{StaticResource AcDcTabHeaderTextBlock}" />
          </Viewbox>
        </Grid>
      </Border>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="TabItem.IsSelected" Value="True">
        <Setter TargetName="HeaderPanel" Property="Panel.Background" Value="{StaticResource TabSelectedBackgroundBrush}" />
        <Setter Property="Control.Foreground" Value="#FFFFFFFF" />
        <Setter Property="FrameworkElement.Margin" Value="-2,0,0,-4" />
      </Trigger>
      <Trigger Property="TabItem.IsSelected" Value="False">
        <Setter TargetName="HeaderPanel" Property="Panel.Background" Value="{StaticResource TabUnselectedBackgroundBrush}" />
        <Setter Property="Control.Foreground" Value="{StaticResource TransparentButtonDefaultTextBrush}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
</ResourceDictionary>