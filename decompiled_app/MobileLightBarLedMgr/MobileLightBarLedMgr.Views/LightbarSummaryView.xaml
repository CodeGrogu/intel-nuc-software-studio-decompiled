<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="MobileLightBarLedMgr.Views.LightbarSummaryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:controls="clr-namespace:Infrastructure.Controls;assembly=Infrastructure" xmlns:converters="clr-namespace:Infrastructure.Converters;assembly=Infrastructure" xmlns:local_converters="clr-namespace:MobileLightBarLedMgr.Converters;assembly=" xmlns:local="clr-namespace:MobileLightBarLedMgr.Views">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
      <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
      <converters:ColorToBrushConverter x:Key="ColorToBrushConverter" />
      <local_converters:AllTrueToVisibilityMultiConverter x:Key="AllTrueToVisibilityMultiConverter" />
      <DataTemplate x:Key="RainbowLightbarControl">
        <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
          <Grid.RowDefinitions>
            <RowDefinition Height="25" />
            <RowDefinition />
            <RowDefinition Height="25" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="15" />
            <ColumnDefinition />
            <ColumnDefinition Width="15" />
            <ColumnDefinition />
            <ColumnDefinition Width="15" />
            <ColumnDefinition />
            <ColumnDefinition Width="15" />
            <ColumnDefinition />
            <ColumnDefinition Width="15" />
            <ColumnDefinition />
            <ColumnDefinition Width="15" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Rectangle Fill="#FFFF0000" Height="10" Width="25" HorizontalAlignment="Left" Grid.Row="1" />
          <Rectangle Height="12" Width="50" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="2">
            <Shape.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="Red" Offset="0.0" />
                <GradientStop Color="DarkOrange" Offset="1.0" />
              </LinearGradientBrush>
            </Shape.Fill>
          </Rectangle>
          <Rectangle Height="16" Width="100" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="4">
            <Shape.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="DarkOrange" Offset="0.0" />
                <GradientStop Color="Yellow" Offset="1.0" />
              </LinearGradientBrush>
            </Shape.Fill>
          </Rectangle>
          <Rectangle Height="25" Width="400" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="6">
            <Shape.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="Yellow" Offset="0.0" />
                <GradientStop Color="DarkGreen" Offset="0.5" />
                <GradientStop Color="DarkBlue" Offset="1.0" />
              </LinearGradientBrush>
            </Shape.Fill>
          </Rectangle>
          <Rectangle Height="16" Width="100" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="8">
            <Shape.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="DarkBlue" Offset="0.0" />
                <GradientStop Color="Indigo" Offset="0.8" />
              </LinearGradientBrush>
            </Shape.Fill>
          </Rectangle>
          <Rectangle Height="12" Width="50" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="10">
            <Shape.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="Indigo" Offset="0.0" />
                <GradientStop Color="Purple" Offset="1.0" />
              </LinearGradientBrush>
            </Shape.Fill>
          </Rectangle>
          <Rectangle Fill="#FF800080" Height="10" Width="25" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="12" />
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="BreathingLightbarControl">
        <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
          <Grid.RowDefinitions>
            <RowDefinition Height="25" />
            <RowDefinition />
            <RowDefinition Height="25" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="15" />
            <ColumnDefinition />
            <ColumnDefinition Width="15" />
            <ColumnDefinition />
            <ColumnDefinition Width="15" />
            <ColumnDefinition />
            <ColumnDefinition Width="15" />
            <ColumnDefinition />
            <ColumnDefinition Width="15" />
            <ColumnDefinition />
            <ColumnDefinition Width="15" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Border BorderThickness="1" Height="10" Width="25" HorizontalAlignment="Left" Grid.Row="1" BorderBrush="{Binding .}">
            <Rectangle Opacity="0.2" Fill="{Binding .}" />
          </Border>
          <Border BorderThickness="1" Height="12" Width="50" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="2" BorderBrush="{Binding .}">
            <Rectangle Opacity="0.4" Fill="{Binding .}" />
          </Border>
          <Border BorderThickness="1" Height="16" Width="100" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="4" BorderBrush="{Binding .}">
            <Rectangle Opacity="0.6" Fill="{Binding .}" />
          </Border>
          <Border BorderThickness="1" Height="25" Width="400" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="6" BorderBrush="{Binding .}">
            <Rectangle Opacity=".8" Fill="{Binding .}" />
          </Border>
          <Border BorderThickness="1" Height="16" Width="100" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="8" BorderBrush="{Binding .}">
            <Rectangle Opacity="0.6" Fill="{Binding .}" />
          </Border>
          <Border BorderThickness="1" Height="12" Width="50" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="10" BorderBrush="{Binding .}">
            <Rectangle Opacity="0.4" Fill="{Binding .}" />
          </Border>
          <Border BorderThickness="1" Height="10" Width="25" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="12" BorderBrush="{Binding .}">
            <Rectangle Opacity="0.2" Fill="{Binding .}" />
          </Border>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="BreathingRainbowLightbarControl">
        <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
          <Grid.RowDefinitions>
            <RowDefinition Height="25" />
            <RowDefinition />
            <RowDefinition Height="25" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="15" />
            <ColumnDefinition />
            <ColumnDefinition Width="15" />
            <ColumnDefinition />
            <ColumnDefinition Width="15" />
            <ColumnDefinition />
            <ColumnDefinition Width="15" />
            <ColumnDefinition />
            <ColumnDefinition Width="15" />
            <ColumnDefinition />
            <ColumnDefinition Width="15" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Rectangle Fill="#FFFF0000" Height="10" Width="25" HorizontalAlignment="Left" Grid.Row="1" Opacity="0.1" />
          <Rectangle Height="12" Width="50" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="2" Opacity="0.2">
            <Shape.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="Red" Offset="0.0" />
                <GradientStop Color="DarkOrange" Offset="1.0" />
              </LinearGradientBrush>
            </Shape.Fill>
          </Rectangle>
          <Rectangle Height="16" Width="100" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="4" Opacity="0.3">
            <Shape.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="DarkOrange" Offset="0.0" />
                <GradientStop Color="Yellow" Offset="1.0" />
              </LinearGradientBrush>
            </Shape.Fill>
          </Rectangle>
          <Rectangle Height="25" Width="400" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="6" Opacity="0.4">
            <Shape.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="Yellow" Offset="0.0" />
                <GradientStop Color="DarkGreen" Offset="0.5" />
                <GradientStop Color="DarkBlue" Offset="1.0" />
              </LinearGradientBrush>
            </Shape.Fill>
          </Rectangle>
          <Rectangle Height="16" Width="100" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="8" Opacity="0.3">
            <Shape.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="DarkBlue" Offset="0.0" />
                <GradientStop Color="Indigo" Offset="0.8" />
              </LinearGradientBrush>
            </Shape.Fill>
          </Rectangle>
          <Rectangle Height="12" Width="50" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="10" Opacity="0.2">
            <Shape.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="Indigo" Offset="0.0" />
                <GradientStop Color="Purple" Offset="1.0" />
              </LinearGradientBrush>
            </Shape.Fill>
          </Rectangle>
          <Rectangle Fill="#FF800080" Height="10" Width="25" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="12" Opacity="0.1" />
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="SolidLightbarControl">
        <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
          <Grid.RowDefinitions>
            <RowDefinition Height="25" />
            <RowDefinition />
            <RowDefinition Height="25" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="15" />
            <ColumnDefinition />
            <ColumnDefinition Width="15" />
            <ColumnDefinition />
            <ColumnDefinition Width="15" />
            <ColumnDefinition />
            <ColumnDefinition Width="15" />
            <ColumnDefinition />
            <ColumnDefinition Width="15" />
            <ColumnDefinition />
            <ColumnDefinition Width="15" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Rectangle Height="10" Width="25" HorizontalAlignment="Left" Grid.Row="1" Fill="{Binding .}" />
          <Rectangle Height="12" Width="50" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="2" Fill="{Binding .}" />
          <Rectangle Height="16" Width="100" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="4" Fill="{Binding .}" />
          <Rectangle Height="25" Width="400" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="6" Fill="{Binding .}" />
          <Rectangle Height="16" Width="100" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="8" Fill="{Binding .}" />
          <Rectangle Height="12" Width="50" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="10" Fill="{Binding .}" />
          <Rectangle Height="10" Width="25" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="12" Fill="{Binding .}" />
        </Grid>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="{DynamicResource CardBackgroundBrush}">
    <ItemsControl Style="{StaticResource CardGridItemsStyle}">
      <controls:CardTitleBarControl Grid.Row="1" Grid.Column="1" IconCanvas="{StaticResource LightbarCardIcon}" TitleText="{StaticResource LightBarCardTitleString}" CustomIcon="{Binding DataContext.CustomIconSource, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}" OpenDetailView="{Binding Path=DataContext.OpenDetailView, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
      <Viewbox Name="ErrorMessage" Grid.Row="3" Grid.Column="1" Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibilityConverter}}">
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource FanLabelBrush}" Text="{StaticResource ErrorMessageString}" Padding="50" />
      </Viewbox>
      <Viewbox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="{Binding ErrorMessage, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="17" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{StaticResource LightbarLedPluggedInAwakeString}" Style="{StaticResource KcAppTitleText}" FontSize="11" />
          <Viewbox Grid.Row="1" Stretch="Fill">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Viewbox}">
                <Style.Triggers>
                  <DataTrigger Value="Visible" Binding="{Binding ElementName=AcRainbowBar, Path=Visibility}">
                    <Setter Property="Visibility" Value="Hidden" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <ContentControl ContentTemplate="{StaticResource SolidLightbarControl}" Content="{Binding Path=AcColor, Converter={StaticResource ColorToBrushConverter}}" />
          </Viewbox>
          <Viewbox Name="AcRainbowBar" Grid.Row="1" Stretch="Fill">
            <UIElement.Visibility>
              <MultiBinding Converter="{StaticResource AllTrueToVisibilityMultiConverter}">
                <Binding Path="LightbarEnabled" />
                <Binding Path="AcRainbow" />
              </MultiBinding>
            </UIElement.Visibility>
            <ContentControl ContentTemplate="{StaticResource RainbowLightbarControl}" />
          </Viewbox>
          <TextBlock Grid.Row="2" Text="{StaticResource LightbarLedPluggedInAsleepString}" Style="{StaticResource KcAppTitleText}" FontSize="11" />
          <Viewbox Grid.Row="3" Stretch="Fill">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Viewbox}">
                <Style.Triggers>
                  <DataTrigger Value="Visible" Binding="{Binding ElementName=AcRainbowBar, Path=Visibility}">
                    <Setter Property="Visibility" Value="Hidden" />
                  </DataTrigger>
                  <DataTrigger Value="True" Binding="{Binding BreathingEnabled}">
                    <Setter Property="Visibility" Value="Hidden" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <ContentControl ContentTemplate="{StaticResource SolidLightbarControl}" Content="{Binding Path=AcColor, Converter={StaticResource ColorToBrushConverter}}" />
          </Viewbox>
          <Viewbox Grid.Row="3" Stretch="Fill">
            <UIElement.Visibility>
              <MultiBinding Converter="{StaticResource AllTrueToVisibilityMultiConverter}">
                <Binding Path="LightbarEnabled" />
                <Binding Path="AcRainbow" />
              </MultiBinding>
            </UIElement.Visibility>
            <ContentControl ContentTemplate="{StaticResource RainbowLightbarControl}">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type ContentControl}">
                  <Style.Triggers>
                    <DataTrigger Value="Visible" Binding="{Binding ElementName=AcBreathingRainbowBar, Path=Visibility}">
                      <Setter Property="Visibility" Value="Hidden" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </ContentControl>
          </Viewbox>
          <Viewbox Name="AcBreathingBar" Grid.Row="3" Stretch="Fill">
            <UIElement.Visibility>
              <MultiBinding Converter="{StaticResource AllTrueToVisibilityMultiConverter}">
                <Binding Path="LightbarEnabled" />
                <Binding Path="BreathingEnabled" />
              </MultiBinding>
            </UIElement.Visibility>
            <ContentControl ContentTemplate="{StaticResource BreathingLightbarControl}" Content="{Binding Path=AcColor, Converter={StaticResource ColorToBrushConverter}}">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type ContentControl}">
                  <Style.Triggers>
                    <DataTrigger Value="Visible" Binding="{Binding ElementName=AcBreathingRainbowBar, Path=Visibility}">
                      <Setter Property="Visibility" Value="Hidden" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </ContentControl>
          </Viewbox>
          <Viewbox Name="AcBreathingRainbowBar" Grid.Row="3" Stretch="Fill">
            <UIElement.Visibility>
              <MultiBinding Converter="{StaticResource AllTrueToVisibilityMultiConverter}">
                <Binding Path="LightbarEnabled" />
                <Binding Path="AcRainbow" />
                <Binding Path="BreathingEnabled" />
              </MultiBinding>
            </UIElement.Visibility>
            <ContentControl ContentTemplate="{StaticResource BreathingRainbowLightbarControl}" />
          </Viewbox>
          <TextBlock Grid.Row="4" Text="{StaticResource LightbarLedOnBatteryString}" Style="{StaticResource KcAppTitleText}" FontSize="11" />
          <Viewbox Grid.Row="5" Stretch="Fill">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Viewbox}">
                <Style.Triggers>
                  <DataTrigger Value="Visible" Binding="{Binding ElementName=DcRainbowBar, Path=Visibility}">
                    <Setter Property="Visibility" Value="Hidden" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <ContentControl ContentTemplate="{StaticResource SolidLightbarControl}" Content="{Binding Path=DcColor, Converter={StaticResource ColorToBrushConverter}}" />
          </Viewbox>
          <Viewbox Name="DcRainbowBar" Grid.Row="5" Stretch="Fill">
            <UIElement.Visibility>
              <MultiBinding Converter="{StaticResource AllTrueToVisibilityMultiConverter}">
                <Binding Path="LightbarEnabled" />
                <Binding Path="DcRainbow" />
              </MultiBinding>
            </UIElement.Visibility>
            <ContentControl ContentTemplate="{StaticResource RainbowLightbarControl}" />
          </Viewbox>
          <Grid Row="7" HorizontalAlignment="Right">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="7" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Name="OnOffToggle" Text="{StaticResource LightbarEffectsString}" Foreground="{DynamicResource MainTextBrush}" Style="{StaticResource ToggleButtonLabelText}" FontSize="14" />
            <ToggleButton HorizontalAlignment="Right" VerticalAlignment="Bottom" Grid.Column="2" Width="75" Height="25" IsChecked="{Binding LightbarEnabled, Mode=TwoWay}" IsEnabled="{Binding ElementName=ErrorMessage, Path=IsVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
              <FrameworkElement.Style>
                <Style BasedOn="{StaticResource OnOffToggle}" TargetType="{x:Type ToggleButton}">
                  <Style.Triggers>
                    <Trigger Property="ToggleButton.IsChecked" Value="True">
                      <Setter Property="Content" Value="{StaticResource ToggleOnString}" />
                    </Trigger>
                    <Trigger Property="ToggleButton.IsChecked" Value="False">
                      <Setter Property="Content" Value="{StaticResource ToggleOffString}" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </ToggleButton>
          </Grid>
        </Grid>
      </Viewbox>
    </ItemsControl>
  </Grid>
</UserControl>