<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="SystemPerformanceMgr.RaptorSystemPerformanceMgr.Views.RNPerformanceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Infrastructure.Controls;assembly=Infrastructure" xmlns:prism="http://prismlibrary.com/" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SystemPerformanceMgr.RaptorSystemPerformanceMgr.Views" xmlns:converters="clr-namespace:Infrastructure.Converters;assembly=Infrastructure" xmlns:local_converters="clr-namespace:SystemPerformanceMgr.Converters" xmlns:models="clr-namespace:Infrastructure.Models;assembly=Infrastructure" ViewModelLocator.AutoWireViewModel="True">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="NucListRadioButton" TargetType="{x:Type RadioButton}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="FontFamily" Value="Segoe UI Reg" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type RadioButton}">
              <Border Name="ButtonBorder" CornerRadius="2,0,0,2" BorderThickness="3, 3, 0, 3" BorderBrush="#00FFFFFF">
                <ContentControl Content="{Binding Path=Content, RelativeSource={RelativeSource TemplatedParent}}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                  <Setter TargetName="ButtonBorder" Property="Border.Background" Value="{StaticResource TabSelectedBackgroundBrush}" />
                  <Setter TargetName="ButtonBorder" Property="Border.BorderThickness" Value="3" />
                  <Setter Property="Foreground" Value="{StaticResource MainTextBrush}" />
                </Trigger>
                <Trigger Property="ToggleButton.IsChecked" Value="False">
                  <Setter TargetName="ButtonBorder" Property="Border.Background" Value="#00FFFFFF" />
                  <Setter Property="Foreground" Value="{StaticResource TransparentButtonDefaultTextBrush}" />
                  <Setter TargetName="ButtonBorder" Property="Border.BorderThickness" Value="3" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
      <local_converters:StringUppercaseConvertor x:Key="StringConverter" />
      <local_converters:MatchingObjectToCollapsedConverter x:Key="NucCollapsedConverter" />
      <BooleanToVisibilityConverter x:Key="BooltoVisCollapse" />
      <converters:InverseBoolToCollapsedVisibilityConverter x:Key="InverseBoolToCollapsedVisibilityConverter" />
      <converters:BoolToCollapsedVisibilityConverter x:Key="BoolToCollapsedVisibilityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="{StaticResource CardBackgroundBrush}">
    <ItemsControl Style="{StaticResource DetailCardGridItemsStyle}">
      <controls:DetailCardTitleBarControl Grid.Column="1" Grid.Row="1" IconCanvas="{StaticResource PerformanceCardIcon}" TitleText="{StaticResource PerformanceCardTitleString}" />
      <Viewbox Grid.Column="1" Grid.Row="1" HorizontalAlignment="Right">
        <Button Grid.Row="0" Height="20" Width="70" FontWeight="Bold" FontSize="18" Visibility="Collapsed" Padding="5,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,15,0,0" Command="{Binding Save}" IsEnabled="{Binding SaveButtonEnabled}">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type Button}">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type Button}">
                    <Border Name="ButtonBorder">
                      <Viewbox>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition MinWidth="10" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition MinWidth="10" />
                          </Grid.ColumnDefinitions>
                          <Grid.RowDefinitions>
                            <RowDefinition MinHeight="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition MinHeight="10" />
                          </Grid.RowDefinitions>
                          <ContentControl Grid.Column="1" Grid.Row="1" Content="{StaticResource ApplyString}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                        </Grid>
                      </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="UIElement.IsMouseOver" Value="False">
                        <Setter TargetName="ButtonBorder" Value="{DynamicResource DefaultControlForeground}" Property="Border.Background" />
                        <Setter Value="{DynamicResource DefaultControlBackground}" Property="Foreground" />
                      </Trigger>
                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                        <Setter TargetName="ButtonBorder" Value="{DynamicResource HoverControlForeground}" Property="Border.Background" />
                        <Setter Value="{DynamicResource HoverControlBackground}" Property="Foreground" />
                      </Trigger>
                      <Trigger Property="IsEnabled" Value="True">
                        <Setter Value="{StaticResource ToggleButtonTextBackgroundDefault}" Property="Background" />
                        <Setter Value="{StaticResource ApplyString}" Property="Content" />
                        <Setter Value="{StaticResource ToggleButtonTextBackgroundDefault}" Property="Background" />
                        <Setter Value="{StaticResource ToggleButtonTextDefault}" Property="Foreground" />
                      </Trigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="ButtonBorder" Value="{DynamicResource DisableControlBackground}" Property="Border.Background" />
                        <Setter Value="{DynamicResource DisableControlForeground}" Property="Foreground" />
                        <Setter Value="{StaticResource ApplyString}" Property="Content" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </FrameworkElement.Style>
        </Button>
      </Viewbox>
      <Rectangle Grid.Column="1" Grid.Row="3" Style="{StaticResource HorizontalSeparator}" />
      <Grid Column="1" Row="4" RowSpan="2" Background="{StaticResource SecondaryBackgroundBrush}" Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="4.9*" />
          <ColumnDefinition Width=".2*" />
          <ColumnDefinition Width="4.9*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height=".8*" />
          <RowDefinition Height=".3*" />
          <RowDefinition Height="8.8*" />
        </Grid.RowDefinitions>
        <Viewbox Grid.Row="0" HorizontalAlignment="Left" Margin="10,0,0,0">
          <TextBlock Text="{StaticResource PowerModeRadioButtonTitle}" Style="{StaticResource PerformanceSubTitleText}" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" />
        </Viewbox>
        <Viewbox Grid.Row="0" Grid.Column="2" HorizontalAlignment="Left" Margin="10,0,0,0">
          <TextBlock Text="{StaticResource FanModeRadioButtonTitle}" Style="{StaticResource PerformanceSubTitleText}" Grid.Row="0" Grid.Column="2" VerticalAlignment="Top" />
        </Viewbox>
        <Rectangle Grid.Row="1" Style="{StaticResource HorizontalSeparator}" VerticalAlignment="Top" Margin="10,5,10,0" />
        <Rectangle Grid.Row="1" Grid.Column="2" Style="{StaticResource HorizontalSeparator}" VerticalAlignment="Top" Margin="10,5,10,0" />
        <Rectangle Grid.Row="3" Grid.Column="1" Style="{StaticResource VerticalSeparator}" Grid.RowSpan="2" HorizontalAlignment="Center" Margin="0,2,0,20" />
        <Grid Column="0" Row="5">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4.2*" />
            <ColumnDefinition Width=".1*" />
            <ColumnDefinition Width="7*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="5*" />
            <RowDefinition Height="40" />
            <RowDefinition Height="4*" />
            <RowDefinition Height="1*" />
          </Grid.RowDefinitions>
          <Viewbox Grid.Row="0" Grid.Column="0" StretchDirection="Both" HorizontalAlignment="Center" VerticalAlignment="Top">
            <ListBox Style="{StaticResource RadioButtonListBox}" ItemContainerStyle="{StaticResource RadioButtonItemContainerListBox}" VerticalAlignment="Top" ItemsSource="{Binding CpuPowerModes}" SelectedItem="{Binding SelectedCpuPowerMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Validation.ErrorTemplate="{x:Null}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <RadioButton Height="30" Style="{StaticResource NucListRadioButton}" VerticalAlignment="Top" HorizontalContentAlignment="Center" IsChecked="{Binding Path=IsSelected, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                    <TextBlock FontSize="16" HorizontalAlignment="Left" Margin="10,0,10,2.5" VerticalAlignment="Center" Text="{Binding Name, Converter={StaticResource StringConverter}}" />
                  </RadioButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ListBox>
          </Viewbox>
          <Rectangle Grid.Row="0" Grid.Column="1" Style="{StaticResource VerticalSeparator}" HorizontalAlignment="Center" />
          <Viewbox Grid.Column="2" Grid.Row="0" StretchDirection="Both" VerticalAlignment="Top">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="10" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="10" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="1.2*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="1.5*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Viewbox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*" />
                    <ColumnDefinition Width="4*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{StaticResource CurrentBiosSettings}" IsEnabled="False" VerticalAlignment="Center" Margin="0,10,20,0" HorizontalAlignment="Right" Grid.Column="0" Style="{StaticResource ColorPickerTitleTextPerformance}" FontSize="18" Visibility="{Binding IsCheckboxVisible, Converter={StaticResource BooltoVisCollapse}}" />
                  <CheckBox Grid.Column="1" Style="{StaticResource NucPerformanceCustomCheckBox}" Margin="5,13,20,0" VerticalAlignment="Center" HorizontalAlignment="Right" IsEnabled="{Binding IsSliderEnable}" IsChecked="{Binding DefaultSelected}" Visibility="{Binding IsCheckboxVisible, Converter={StaticResource BooltoVisCollapse}}">
                    <i:Interaction.Triggers>
                      <i:EventTrigger EventName="Checked">
                        <models:SetFocusTrigger TargetName="NameBox" />
                        <i:InvokeCommandAction Command="{Binding Path=DataContext.UpdateSelection, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                      </i:EventTrigger>
                      <i:EventTrigger EventName="Unchecked">
                        <i:InvokeCommandAction Command="{Binding Path=DataContext.UpdateSelection, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                      </i:EventTrigger>
                    </i:Interaction.Triggers>
                  </CheckBox>
                </Grid>
              </Viewbox>
              <Viewbox Grid.Column="1" Grid.Row="3" StretchDirection="DownOnly" HorizontalAlignment="Left">
                <TextBlock Text="{StaticResource PowerLevel1}" Style="{StaticResource ColorPickerTitleTextPerformance}" />
              </Viewbox>
              <Viewbox Grid.Column="1" Grid.Row="4" StretchDirection="DownOnly" HorizontalAlignment="Stretch">
                <Slider Name="PowerLevel1" Width="350" Height="20" Minimum="1" Style="{StaticResource HorizontalSliderStyle}" HorizontalAlignment="Stretch" Maximum="{Binding Max_PL1}" Value="{Binding PL1}" IsEnabled="{Binding IsSliderEnable}">
                  <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseUp">
                      <core:CallMethodAction xmlns:core="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" MethodName="PowerLevel1SelectionChanged" TargetObject="{Binding}" />
                    </i:EventTrigger>
                  </i:Interaction.Triggers>
                </Slider>
              </Viewbox>
              <Viewbox Grid.Column="3" Grid.Row="4" HorizontalAlignment="Center">
                <TextBlock Width="50" Style="{StaticResource ColorPickerTitleTextPerformance}" Text="{Binding PL1, StringFormat='{}{0}W'}" />
              </Viewbox>
              <Viewbox Grid.Column="1" Grid.Row="6" HorizontalAlignment="Left">
                <TextBlock Text="{StaticResource PowerLevel2}" Style="{StaticResource ColorPickerTitleTextPerformance}" />
              </Viewbox>
              <Viewbox Grid.Column="1" Grid.Row="7" HorizontalAlignment="Stretch" StretchDirection="DownOnly">
                <Slider Name="PowerLevel2" Width="350" Height="20" Minimum="1" Style="{StaticResource HorizontalSliderStyle}" HorizontalAlignment="Stretch" IsEnabled="{Binding IsSliderEnable}" Maximum="{Binding Max_PL2}" Value="{Binding PL2}">
                  <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseUp">
                      <CallMethodAction MethodName="PowerLevel2SelectionChanged" TargetObject="{Binding}" xmlns="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" />
                    </i:EventTrigger>
                  </i:Interaction.Triggers>
                </Slider>
              </Viewbox>
              <Viewbox Grid.Column="3" Grid.Row="7" HorizontalAlignment="Center">
                <TextBlock Width="45" Style="{StaticResource ColorPickerTitleTextPerformance}" Text="{Binding PL2, StringFormat='{}{0}W'}" />
              </Viewbox>
              <Viewbox Grid.Column="1" Grid.Row="9" HorizontalAlignment="Left">
                <TextBlock Text="{StaticResource Tau}" Style="{StaticResource ColorPickerTitleTextPerformance}" />
              </Viewbox>
              <Viewbox Grid.Column="1" Grid.Row="10" HorizontalAlignment="Stretch">
                <Slider Name="Tau" Width="350" Height="20" Style="{StaticResource HorizontalSliderStyle}" HorizontalAlignment="Stretch" IsEnabled="{Binding IsSliderEnable}" Maximum="{Binding Max_Tau}" Minimum="{Binding Min_Tau}" Value="{Binding Tau, Mode=TwoWay}" Ticks="{Binding TauValues}">
                  <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseUp">
                      <CallMethodAction MethodName="TauSelectionChanged" TargetObject="{Binding}" xmlns="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" />
                    </i:EventTrigger>
                  </i:Interaction.Triggers>
                </Slider>
              </Viewbox>
              <Viewbox Grid.Column="3" Margin="0,-10,0,0" Grid.Row="10" HorizontalAlignment="Center">
                <TextBlock Width="45" Style="{StaticResource ColorPickerTitleTextPerformance}" Text="{Binding Tau, StringFormat='{}{0}s'}" />
              </Viewbox>
              <Viewbox Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="12" HorizontalAlignment="Right">
                <Button Grid.Row="0" Height="35" Width="150" FontWeight="Bold" FontSize="18" Padding="5,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,15,0,0" Command="{Binding SaveCustomPowerMode}" Visibility="{Binding ShowPowerSaveButton, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding PowerSaveButtonEnable}">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type Button}">
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="{x:Type Button}">
                            <Border Name="ButtonBorder">
                              <Viewbox>
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition MinWidth="10" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition MinWidth="10" />
                                  </Grid.ColumnDefinitions>
                                  <Grid.RowDefinitions>
                                    <RowDefinition MinHeight="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition MinHeight="10" />
                                  </Grid.RowDefinitions>
                                  <ContentControl Grid.Column="1" Grid.Row="1" Content="{StaticResource ApplyString}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                                </Grid>
                              </Viewbox>
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="UIElement.IsMouseOver" Value="False">
                                <Setter TargetName="ButtonBorder" Value="{DynamicResource DefaultControlForeground}" Property="Border.Background" />
                                <Setter Value="{DynamicResource DefaultControlBackground}" Property="Foreground" />
                              </Trigger>
                              <Trigger Property="UIElement.IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Value="{DynamicResource HoverControlForeground}" Property="Border.Background" />
                                <Setter Value="{DynamicResource HoverControlBackground}" Property="Foreground" />
                              </Trigger>
                              <Trigger Property="IsEnabled" Value="True">
                                <Setter Value="{StaticResource ToggleButtonTextBackgroundDefault}" Property="Background" />
                                <Setter Value="{StaticResource ApplyString}" Property="Content" />
                                <Setter Value="{StaticResource ToggleButtonTextBackgroundDefault}" Property="Background" />
                                <Setter Value="{StaticResource ToggleButtonTextDefault}" Property="Foreground" />
                              </Trigger>
                              <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Value="{DynamicResource DisableControlBackground}" Property="Border.Background" />
                                <Setter Value="{DynamicResource DisableControlForeground}" Property="Foreground" />
                                <Setter Value="{StaticResource ApplyString}" Property="Content" />
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </FrameworkElement.Style>
                </Button>
              </Viewbox>
            </Grid>
          </Viewbox>
          <Grid Row="2" Margin="10,0,0,0" Column="0" ColumnSpan="3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="4*" />
              <ColumnDefinition Width="4*" />
              <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ContentControl Grid.Row="0" HorizontalAlignment="Center" Grid.Column="1" VerticalAlignment="Center" prism:RegionManager.RegionName="{Binding CpuUsageRegion}" />
            <ContentControl Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" prism:RegionManager.RegionName="{Binding dGpuUsageRegion}" />
          </Grid>
        </Grid>
        <Grid Column="2" Row="5">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4.1*" />
            <ColumnDefinition Width=".1*" />
            <ColumnDefinition Width="7*" />
            <ColumnDefinition Width=".5*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height=".8*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="7*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="4.8*" />
          </Grid.RowDefinitions>
          <Viewbox Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" HorizontalAlignment="Center">
            <Grid Height="27" Column="0" ColumnSpan="3" Row="0" VerticalAlignment="Top" HorizontalAlignment="Left">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="30" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Viewbox Grid.Column="0" HorizontalAlignment="Center">
                <TextBlock Grid.Column="0" Text="{StaticResource SelectFan}" FontWeight="SemiBold" Style="{StaticResource ColorPickerTitleTextPerformance}" />
              </Viewbox>
              <Viewbox Grid.Column="3">
                <ComboBox HorizontalAlignment="Stretch" Style="{StaticResource ComboBoxStyle}" Width="180" SelectedItem="{Binding SelectedFantype}" ItemsSource="{Binding FanTypes}">
                  <ItemsControl.ItemContainerStyle>
                    <Style TargetType="{x:Type ComboBoxItem}">
                      <Setter Property="Template" Value="{StaticResource BlueDropDownTemplate}" />
                    </Style>
                  </ItemsControl.ItemContainerStyle>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock FontSize="16" Text="{Binding .}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ComboBox>
              </Viewbox>
            </Grid>
          </Viewbox>
          <Viewbox Grid.Row="2" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <ListBox Style="{StaticResource RadioButtonListBox}" ItemContainerStyle="{StaticResource RadioButtonItemContainerListBox}" VerticalAlignment="Top" ItemsSource="{Binding FanModes}" SelectedItem="{Binding SelectedFanMode}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <RadioButton Height="25" Style="{StaticResource NucListRadioButton}" VerticalAlignment="Top" HorizontalContentAlignment="Center" IsChecked="{Binding Path=IsSelected, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                    <TextBlock FontSize="12" HorizontalAlignment="Left" Margin="10,0,10,2.5" VerticalAlignment="Center" Text="{Binding ., Converter={StaticResource StringConverter}}" />
                  </RadioButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ListBox>
          </Viewbox>
          <Rectangle Grid.Row="2" Grid.Column="1" Style="{StaticResource VerticalSeparator}" Margin="0,18,0,10" HorizontalAlignment="Center" />
          <Viewbox Grid.Column="2" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="{Binding IsTempDetailVisible, Converter={StaticResource InverseBoolToCollapsedVisibilityConverter}}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="5" />
                <RowDefinition />
                <RowDefinition Height="10" />
                <RowDefinition />
                <RowDefinition Height="1.5*" />
                <RowDefinition Height="6" />
                <RowDefinition />
                <RowDefinition Height="1.5*" />
                <RowDefinition Height="6" />
                <RowDefinition />
                <RowDefinition Height="1.5*" />
                <RowDefinition Height="6" />
                <RowDefinition />
                <RowDefinition Height="1.5*" />
                <RowDefinition Height="6" />
                <RowDefinition />
                <RowDefinition Height="1.5*" />
                <RowDefinition Height="6" />
                <RowDefinition />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="5" />
              </Grid.ColumnDefinitions>
              <Viewbox Grid.Column="1" Grid.Row="3" VerticalAlignment="Top" HorizontalAlignment="Left">
                <TextBlock Text="{StaticResource FixedDutyCycle}" Style="{StaticResource ColorPickerTitleTextPerformance}" />
              </Viewbox>
              <Viewbox Grid.Column="1" Grid.Row="4" VerticalAlignment="Top" HorizontalAlignment="Left">
                <Slider Name="FixedDutyCycleSlider" Width="350" Height="20" Minimum="0" Maximum="100" Style="{StaticResource HorizontalSliderStyle}" HorizontalAlignment="Stretch" IsEnabled="{Binding IsFanSliderEnable}" Value="{Binding FixedFanDutyCycle}">
                  <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseUp">
                      <CallMethodAction MethodName="FixedFanDutyCycleSliderChange" TargetObject="{Binding}" xmlns="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" />
                    </i:EventTrigger>
                  </i:Interaction.Triggers>
                </Slider>
              </Viewbox>
              <Viewbox Grid.Column="3" Grid.Row="4" VerticalAlignment="Top" HorizontalAlignment="Left">
                <TextBlock Width="50" Style="{StaticResource ColorPickerTitleTextPerformance}" Text="{Binding FixedFanDutyCycle, StringFormat='{}{0}%'}" />
              </Viewbox>
            </Grid>
          </Viewbox>
          <Viewbox Grid.Column="2" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="{Binding IsTempDetailVisible, Converter={StaticResource BoolToCollapsedVisibilityConverter}}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="5" />
                <RowDefinition />
                <RowDefinition Height="10" />
                <RowDefinition />
                <RowDefinition Height="1.5*" />
                <RowDefinition Height="6" />
                <RowDefinition />
                <RowDefinition Height="1.5*" />
                <RowDefinition Height="6" />
                <RowDefinition />
                <RowDefinition Height="1.5*" />
                <RowDefinition Height="6" />
                <RowDefinition />
                <RowDefinition Height="1.5*" />
                <RowDefinition Height="6" />
                <RowDefinition />
                <RowDefinition Height="1.5*" />
                <RowDefinition Height="6" />
                <RowDefinition />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="5" />
              </Grid.ColumnDefinitions>
              <Viewbox Grid.Column="1" Grid.Row="3" VerticalAlignment="Top" HorizontalAlignment="Left">
                <TextBlock Text="{StaticResource FanTurnOnTempString}" Style="{StaticResource ColorPickerTitleTextPerformance}" />
              </Viewbox>
              <Viewbox Grid.Column="1" Grid.Row="4" VerticalAlignment="Top" HorizontalAlignment="Left">
                <Slider Name="MinDutySlider" Width="350" Height="20" Minimum="0" Maximum="100" Style="{StaticResource HorizontalSliderStyle}" HorizontalAlignment="Stretch" IsEnabled="{Binding IsFanSliderEnable}" Value="{Binding FanTurnOnTemp}">
                  <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseUp">
                      <CallMethodAction MethodName="FanTurnOnTemperatureChange" TargetObject="{Binding}" xmlns="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" />
                    </i:EventTrigger>
                  </i:Interaction.Triggers>
                </Slider>
              </Viewbox>
              <Viewbox Grid.Column="3" Grid.Row="4" VerticalAlignment="Top" HorizontalAlignment="Left">
                <TextBlock Width="50" Style="{StaticResource ColorPickerTitleTextPerformance}" Text="{Binding FanTurnOnTemp, StringFormat='{}{0}°C'}" />
              </Viewbox>
              <Viewbox Grid.Column="1" Grid.Row="6" VerticalAlignment="Top" HorizontalAlignment="Left">
                <TextBlock Text="{StaticResource FanTurnOffTempString}" Style="{StaticResource ColorPickerTitleTextPerformance}" />
              </Viewbox>
              <Viewbox Grid.Column="1" Grid.Row="7" VerticalAlignment="Top" HorizontalAlignment="Left">
                <Slider Name="OffTempratureSlider" Width="350" Height="20" Minimum="0" Style="{StaticResource HorizontalSliderStyle}" HorizontalAlignment="Stretch" IsEnabled="{Binding IsFanSliderEnable}" Maximum="{Binding FanOffTempMaxValue}" Value="{Binding FanTurnOffTemp}">
                  <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseUp">
                      <CallMethodAction MethodName="FanTurnOffTemperatureChange" TargetObject="{Binding}" xmlns="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" />
                    </i:EventTrigger>
