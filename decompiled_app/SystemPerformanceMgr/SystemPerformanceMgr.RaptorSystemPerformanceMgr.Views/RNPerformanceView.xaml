              </Viewbox>
              <Viewbox Grid.Column="1" Grid.Row="9" VerticalAlignment="Top" HorizontalAlignment="Left">
                <TextBlock Text="{StaticResource MinDutyCycleString}" Style="{StaticResource ColorPickerTitleTextPerformance}" />
              </Viewbox>
              <Viewbox Grid.Column="1" Grid.Row="10" VerticalAlignment="Top" HorizontalAlignment="Left">
                <Slider Name="MinDutyCycleSlider" Width="350" Height="20" Minimum="0" Maximum="63" Style="{StaticResource HorizontalSliderStyle}" HorizontalAlignment="Stretch" IsEnabled="{Binding IsFanSliderEnable}" Value="{Binding MinFanDutyCycle}">
                  <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseUp">
                      <CallMethodAction MethodName="MinDutyCycleChange" TargetObject="{Binding}" xmlns="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" />
                    </i:EventTrigger>
                  </i:Interaction.Triggers>
                </Slider>
              </Viewbox>
              <Viewbox Grid.Column="3" Grid.Row="10" VerticalAlignment="Top" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource ColorPickerTitleTextPerformance}" Text="{Binding MinFanDutyCycle, StringFormat='{}{0}%'}" />
              </Viewbox>
              <Viewbox Grid.Column="1" Grid.Row="12" VerticalAlignment="Top" HorizontalAlignment="Left">
                <TextBlock Text="{StaticResource DutyCycleIncrementString}" Style="{StaticResource ColorPickerTitleTextPerformance}" />
              </Viewbox>
              <Viewbox Grid.Column="1" Grid.Row="13" VerticalAlignment="Top" HorizontalAlignment="Left">
                <Slider Name="DutyCycleIncrementSlider" Width="350" Height="20" Minimum="0" Maximum="15" Style="{StaticResource HorizontalSliderStyle}" HorizontalAlignment="Stretch" IsEnabled="{Binding IsFanSliderEnable}" Value="{Binding DutyCycleIncrement}">
                  <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseUp">
                      <CallMethodAction MethodName="DutyCycleChange" TargetObject="{Binding}" xmlns="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" />
                    </i:EventTrigger>
                  </i:Interaction.Triggers>
                </Slider>
              </Viewbox>
              <Viewbox Grid.Column="3" Grid.Row="13" VerticalAlignment="Top" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource ColorPickerTitleTextPerformance}" Text="{Binding DutyCycleIncrement}" />
              </Viewbox>
              <Viewbox Grid.Column="1" Grid.Row="15" VerticalAlignment="Top" HorizontalAlignment="Left">
                <TextBlock Text="{StaticResource MaxDutyCycleString}" Style="{StaticResource ColorPickerTitleTextPerformance}" />
              </Viewbox>
              <Viewbox Grid.Column="1" Grid.Row="16" VerticalAlignment="Top" HorizontalAlignment="Left">
                <Slider Name="MaximumDutySlider" Width="350" Height="20" Minimum="0" Maximum="100" Style="{StaticResource HorizontalSliderStyle}" HorizontalAlignment="Stretch" IsEnabled="{Binding IsFanSliderEnable}" Value="{Binding MaxFanDutyCycle}">
                  <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseUp">
                      <CallMethodAction MethodName="MaximumDutySliderChange" TargetObject="{Binding}" xmlns="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" />
                    </i:EventTrigger>
                  </i:Interaction.Triggers>
                </Slider>
              </Viewbox>
              <Viewbox Grid.Column="3" Grid.Row="16" VerticalAlignment="Top" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource ColorPickerTitleTextPerformance}" Text="{Binding MaxFanDutyCycle, StringFormat='{}{0}%'}" />
              </Viewbox>
            </Grid>
          </Viewbox>
          <Viewbox Grid.Row="4" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,20,0">
            <ContentControl VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" prism:RegionManager.RegionName="{Binding PerformanceFanRegionRN}" />
          </Viewbox>
          <Grid Row="3" ShowGridLines="False" VerticalAlignment="Stretch" Column="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition />
            </Grid.RowDefinitions>
            <Viewbox Grid.Column="1" VerticalAlignment="Top" Margin="10,0,0,0" HorizontalAlignment="Right">
              <Button Grid.Row="0" Height="20" Width="80" FontWeight="Bold" FontSize="18" HorizontalAlignment="Right" Command="{Binding Save}" Visibility="{Binding ShowFanSaveButton, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding SaveButtonEnabled}">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type Button}">
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                          <Border Name="ButtonBorder">
                            <Viewbox>
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition MinWidth="10" />
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition MinWidth="10" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                  <RowDefinition MinHeight="10" />
                                  <RowDefinition Height="Auto" />
                                  <RowDefinition MinHeight="10" />
                                </Grid.RowDefinitions>
                                <ContentControl Grid.Column="1" Grid.Row="1" Content="{StaticResource ApplyString}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                              </Grid>
                            </Viewbox>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="UIElement.IsMouseOver" Value="False">
                              <Setter TargetName="ButtonBorder" Value="{DynamicResource DefaultControlForeground}" Property="Border.Background" />
                              <Setter Value="{DynamicResource DefaultControlBackground}" Property="Foreground" />
                            </Trigger>
                            <Trigger Property="UIElement.IsMouseOver" Value="True">
                              <Setter TargetName="ButtonBorder" Value="{DynamicResource HoverControlForeground}" Property="Border.Background" />
                              <Setter Value="{DynamicResource HoverControlBackground}" Property="Foreground" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="True">
                              <Setter Value="{StaticResource ToggleButtonTextBackgroundDefault}" Property="Background" />
                              <Setter Value="{StaticResource ApplyString}" Property="Content" />
                              <Setter Value="{StaticResource ToggleButtonTextBackgroundDefault}" Property="Background" />
                              <Setter Value="{StaticResource ToggleButtonTextDefault}" Property="Foreground" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                              <Setter TargetName="ButtonBorder" Value="{DynamicResource DisableControlBackground}" Property="Border.Background" />
                              <Setter Value="{DynamicResource DisableControlForeground}" Property="Foreground" />
                              <Setter Value="{StaticResource ApplyString}" Property="Content" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </FrameworkElement.Style>
              </Button>
            </Viewbox>
          </Grid>
        </Grid>
      </Grid>
    </ItemsControl>
  </Grid>
</UserControl>