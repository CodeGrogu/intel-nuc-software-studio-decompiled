<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="SystemPerformanceMgr.Views.NucPerformanceSummaryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Infrastructure.Controls;assembly=Infrastructure" xmlns:prism="http://prismlibrary.com/" xmlns:local_converters="clr-namespace:SystemPerformanceMgr.Converters" xmlns:converters="clr-namespace:Infrastructure.Converters;assembly=Infrastructure" x:Name="PerformanceSummaryCard" ViewModelLocator.AutoWireViewModel="True" xmlns:views="clr-namespace:SystemPerformanceMgr.Views">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <local_converters:StringUppercaseConvertor x:Key="StringConverter" />
      <converters:NullHiddenConverter x:Key="NullHiddenConverter" />
      <converters:NullHiddenInverseConverter x:Key="NullHiddenInverseConverter" />
      <converters:BoolToCollapsedVisibilityConverter x:Key="BoolToCollapsedVisibilityConverter" />
      <converters:InverseBoolToCollapsedVisibilityConverter x:Key="InverseBoolToCollapsedVisibilityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="{StaticResource CardBackgroundBrush}">
    <ItemsControl Style="{StaticResource CardGridItemsStyle}" Visibility="{Binding IsSerpentlVisible, Converter={StaticResource InverseBoolToCollapsedVisibilityConverter}}">
      <controls:CardTitleBarControl Grid.Row="1" Grid.Column="1" IconCanvas="{StaticResource PerformanceCardIcon}" TitleText="{StaticResource PerformanceCardTitleString}" OpenDetailView="{Binding Path=DataContext.OpenDetailView, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
      <Grid Row="1" Column="1" Visibility="{Binding PerformanceDriverError, Mode=OneWay, Converter={StaticResource NullHiddenConverter}}">
        <controls:CardTitleBarControlDisable Grid.Row="1" Grid.Column="1" IconCanvas="{StaticResource PerformanceCardIcon}" TitleText="{StaticResource PerformanceCardTitleString}" OpenErrorMessageBox="{Binding Path=DataContext.OpenErrorMessageBox, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" OpenDetailView="{Binding Path=DataContext.OpenDetailView, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
      </Grid>
      <Viewbox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" StretchDirection="DownOnly" Visibility="{Binding PerformanceDriverError, Mode=OneWay, Converter={StaticResource NullHiddenInverseConverter}}">
        <Grid VerticalAlignment="Top" Background="{StaticResource CardBackgroundBrush}">
          <TextBlock Text="{StaticResource PerformanceTuningNotSupported}" Grid.ColumnSpan="3" Style="{StaticResource ColorPickerTitleText}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Supported, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
          <Viewbox HorizontalAlignment="Left" Margin="15" Visibility="{Binding Supported, Converter={StaticResource BoolToVis}}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="30" />
                <RowDefinition Height="170" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="15" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource ColorPickerTitleText}" FontSize="22" Text="{StaticResource CpuModeLabelString}" />
              <TextBlock Grid.Row="2" Style="{StaticResource InfoListItemText}" Text="{Binding Path=CpuMode.Name, Converter={StaticResource StringConverter}}" />
              <TextBlock Grid.Column="2" Style="{StaticResource ColorPickerTitleText}" Foreground="{StaticResource MainTextBrush}" Text="{StaticResource FanModeLabelString}" />
              <TextBlock Grid.Column="2" Grid.Row="2" Style="{StaticResource InfoListItemText}" Text="{Binding Path=FanMode, Converter={StaticResource StringToLocalizedLabelConverter}}" />
              <ContentControl Grid.Row="4" prism:RegionManager.RegionName="{Binding CpuUsageRegion}" />
              <ContentControl Grid.Column="2" Grid.Row="4" HorizontalAlignment="Right" prism:RegionManager.RegionName="{Binding FullFanRegion}" />
            </Grid>
          </Viewbox>
        </Grid>
      </Viewbox>
    </ItemsControl>
    <ItemsControl Style="{StaticResource CardGridItemsStyle}" Visibility="{Binding IsSerpentlVisible, Converter={StaticResource BoolToCollapsedVisibilityConverter}}">
      <controls:CardTitleBarControl Grid.Row="1" Grid.Column="1" IconCanvas="{StaticResource PerformanceCardIcon}" TitleText="{StaticResource PerformanceCardTitleString}" OpenDetailView="{Binding Path=DataContext.OpenDetailView, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
      <Grid Row="1" Column="1" Visibility="{Binding PerformanceDriverError, Mode=OneWay, Converter={StaticResource NullHiddenConverter}}">
        <controls:CardTitleBarControlDisable Grid.Row="1" Grid.Column="1" IconCanvas="{StaticResource PerformanceCardIcon}" TitleText="{StaticResource PerformanceCardTitleString}" OpenErrorMessageBox="{Binding Path=DataContext.OpenErrorMessageBox, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" OpenDetailView="{Binding Path=DataContext.OpenDetailView, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
      </Grid>
      <Grid VerticalAlignment="Top" Background="{StaticResource CardBackgroundBrush}" Row="3" Column="1" HorizontalAlignment="Left" Visibility="{Binding PerformanceDriverError, Mode=OneWay, Converter={StaticResource NullHiddenInverseConverter}}">
        <TextBlock Text="{StaticResource PerformanceTuningNotSupported}" Grid.ColumnSpan="3" Style="{StaticResource ColorPickerTitleText}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Supported, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
        <Viewbox HorizontalAlignment="Left" Visibility="{Binding Supported, Converter={StaticResource BoolToVis}}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="10" />
              <RowDefinition Height="*" />
              <RowDefinition Height="10" />
              <RowDefinition Height="200" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="150" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{StaticResource PowerModeRadioButtonTitle}" Style="{StaticResource PerformanceSubTitleText}" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Rectangle Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource HorizontalSeparator}" VerticalAlignment="Center" Margin="0,0,20,0" />
            <TextBlock Grid.Row="2" Style="{StaticResource InfoListItemText}" FontSize="22" Margin="0,10,0,0" Text="{Binding Path=CpuMode.Name, Converter={StaticResource StringConverter}}" />
            <TextBlock Grid.Column="2" Style="{StaticResource ColorPickerTitleText}" Foreground="{StaticResource MainTextBrush}" Text="{StaticResource FanModeRadioButtonTitle}" Margin="50,0,0,0" />
            <Rectangle Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="1" Style="{StaticResource HorizontalSeparator}" VerticalAlignment="Center" Margin="50,0,30,0" />
            <TextBlock Grid.Column="2" Grid.Row="2" Style="{StaticResource InfoListItemText}" FontSize="22" Margin="50,10,0,0" Text="{Binding Path=FanMode, Converter={StaticResource StringToLocalizedLabelConverter}}" />
            <StackPanel Orientation="Horizontal" Grid.Row="4" Margin="0,20,0,0">
              <ContentControl Grid.Row="4" prism:RegionManager.RegionName="{Binding CpuUsageRegion}" />
              <ContentControl Grid.Row="4" prism:RegionManager.RegionName="{Binding dGpuUsageRegion}" />
            </StackPanel>
            <ContentControl Grid.Column="2" Grid.Row="4" Margin="0,20,50,0" HorizontalAlignment="Left" VerticalAlignment="Bottom" prism:RegionManager.RegionName="{Binding PerformanceFanRegionPH}" />
          </Grid>
        </Viewbox>
      </Grid>
    </ItemsControl>
  </Grid>
</UserControl>