            </Grid>
          </Viewbox>
          <Viewbox Grid.Row="0" Grid.Column="3" Margin="0,10,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="{Binding IsTempDetailVisible, Converter={StaticResource InverseBoolToCollapsedVisibilityConverter}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="170" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" Grid.Column="1">
                <CheckBox Margin="0,4,0,0" Style="{StaticResource NucPerformanceCustomCheckBox}" VerticalAlignment="Top" HorizontalAlignment="Left" IsChecked="{Binding IsFanOff}">
                  <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Checked">
                      <models:SetFocusTrigger TargetName="NameBox" />
                      <i:InvokeCommandAction Command="{Binding Path=DataContext.UpdateFanOff, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                    </i:EventTrigger>
                    <i:EventTrigger EventName="Unchecked">
                      <i:InvokeCommandAction Command="{Binding Path=DataContext.UpdateFanOff, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                    </i:EventTrigger>
                  </i:Interaction.Triggers>
                </CheckBox>
                <TextBlock Margin="5,0,0,0" Text="{StaticResource FanOff}" IsEnabled="False" VerticalAlignment="Top" HorizontalAlignment="Right" Grid.Column="0" Style="{StaticResource ColorPickerTitleTextPerformance}" />
              </StackPanel>
            </Grid>
          </Viewbox>
          <ContentControl Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="7" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" prism:RegionManager.RegionName="{Binding PerformanceFanRegion}" />
        </Grid>
        <Grid Column="2" Row="5" Visibility="{Binding IsPhantomFanGrid, Converter={StaticResource BoolToCollapsedVisibilityConverter}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4.2*" />
            <ColumnDefinition Width=".1*" />
            <ColumnDefinition Width="7*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="5*" />
            <RowDefinition Height="1.5*" />
            <RowDefinition Height="5*" />
          </Grid.RowDefinitions>
          <Viewbox Grid.Row="0" Grid.Column="0" StretchDirection="Both" HorizontalAlignment="Center" VerticalAlignment="Top">
            <ListBox Style="{StaticResource RadioButtonListBox}" ItemContainerStyle="{StaticResource RadioButtonItemContainerListBox}" VerticalAlignment="Top" ItemsSource="{Binding FanModes}" SelectedItem="{Binding SelectedFanMode}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <RadioButton Height="25" Style="{StaticResource NucListRadioButton}" VerticalAlignment="Top" HorizontalContentAlignment="Center" IsChecked="{Binding Path=IsSelected, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                    <TextBlock HorizontalAlignment="Left" Margin="10,0,10,2.5" VerticalAlignment="Center" Text="{Binding ., Converter={StaticResource StringConverter}}" />
                  </RadioButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ListBox>
          </Viewbox>
          <Rectangle Grid.Row="0" Grid.Column="1" Style="{StaticResource VerticalSeparator}" HorizontalAlignment="Center" />
          <Viewbox Grid.Row="0" Grid.Column="3" Margin="0,10,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="{Binding IsTempDetailVisible, Converter={StaticResource InverseBoolToCollapsedVisibilityConverter}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="25" />
                <ColumnDefinition Width="170" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="0" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="1*" />
              </Grid.RowDefinitions>
              <TextBlock FontSize="22" Grid.Row="1" Text="{StaticResource FanOff}" IsEnabled="False" VerticalAlignment="Top" HorizontalAlignment="Left" Grid.Column="1" Style="{StaticResource ColorPickerTitleTextPerformance}" />
              <Viewbox Grid.Column="2" Grid.Row="1" VerticalAlignment="Center" Margin="-3,0,0,0">
                <Viewbox.Child>
                  <Border Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0">
                    <ContentPresenter Content="{StaticResource InfoIcon}" />
                  </Border>
                </Viewbox.Child>
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type Viewbox}">
                    <Style.Triggers>
                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                        <Setter Property="UIElement.BitmapEffect">
                          <Setter.Value>
                            <DropShadowBitmapEffect Color="White" Direction="360" ShadowDepth="1" Softness="0.7" Opacity="1" />
                          </Setter.Value>
                        </Setter>
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <FrameworkElement.ToolTip>
                  <TextBlock Style="{StaticResource ToolTipText}" Text="{Binding FanOffInfoText, UpdateSourceTrigger=PropertyChanged}" />
                </FrameworkElement.ToolTip>
              </Viewbox>
              <ToggleButton Grid.Column="1" Grid.Row="3" Margin="0,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Width="150" Height="30" IsChecked="{Binding IsFanOff, Mode=TwoWay}" IsEnabled="{Binding IsFanOffEnable, Mode=TwoWay}">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type ToggleButton}">
                    <Setter Property="Template" Value="{StaticResource BasicToggleButton}" />
                    <Style.Triggers>
                      <Trigger Property="ToggleButton.IsChecked" Value="True">
                        <Setter Property="Content" Value="{StaticResource ToggleEnableString}" />
                      </Trigger>
                      <Trigger Property="ToggleButton.IsChecked" Value="False">
                        <Setter Property="Content" Value="{StaticResource ToggleDisableString}" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </ToggleButton>
            </Grid>
          </Viewbox>
          <Viewbox Grid.Row="0" Grid.Column="3" Margin="0,10,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="{Binding IsTempDetailVisible, Converter={StaticResource BoolToCollapsedVisibilityConverter}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="30" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="0" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" />
              </Grid.RowDefinitions>
              <Viewbox Grid.Column="1" Grid.Row="1" StretchDirection="DownOnly" HorizontalAlignment="Left">
                <TextBlock Text="{StaticResource FixedDutyCycle}" Style="{StaticResource ColorPickerTitleTextPerformance}" />
              </Viewbox>
              <Viewbox Grid.Column="1" Grid.Row="3" StretchDirection="DownOnly" HorizontalAlignment="Stretch">
                <Slider Name="FixedFanSlider" Width="350" Height="20" Maximum="100" Minimum="1" IsEnabled="True" Style="{StaticResource HorizontalSliderStyle}" HorizontalAlignment="Stretch" Value="{Binding FixedFanDutyCycle}">
                  <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseUp">
                      <CallMethodAction MethodName="FixedDutyCycleSelectionChanged" TargetObject="{Binding}" xmlns="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" />
                    </i:EventTrigger>
                  </i:Interaction.Triggers>
                </Slider>
              </Viewbox>
              <Viewbox Grid.Column="3" Grid.Row="3" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource ColorPickerTitleTextPerformance}" Text="{Binding FixedFanDutyCycle, StringFormat='{}{0}%'}" />
              </Viewbox>
            </Grid>
          </Viewbox>
          <ContentControl Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="7" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" prism:RegionManager.RegionName="{Binding PerformanceFanRegionPH}" />
        </Grid>
      </Grid>
    </ItemsControl>
  </Grid>
</UserControl>