              </Viewbox>
              <Viewbox Grid.Column="3" Grid.Row="9" VerticalAlignment="Top" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource ColorPickerTitleTextPerformance}" Text="{Binding DutyIncrement}" />
              </Viewbox>
              <Viewbox Grid.Column="1" Grid.Row="11" VerticalAlignment="Top" HorizontalAlignment="Left">
                <TextBlock Text="{StaticResource FanOffTemp}" Style="{StaticResource ColorPickerTitleTextPerformance}" />
              </Viewbox>
              <Viewbox Grid.Column="1" Grid.Row="12" VerticalAlignment="Top" HorizontalAlignment="Left">
                <Slider Name="OffTempratureSlider" Width="350" Height="20" Style="{StaticResource HorizontalSliderStyle}" HorizontalAlignment="Stretch" IsEnabled="{Binding IsFanSliderEnable}" Minimum="{Binding FanOffTempMinValue}" Maximum="{Binding FanOffTempMaxValue}" Value="{Binding OffTemperature}">
                  <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseUp">
                      <CallMethodAction MethodName="FanOffTemperatureSelectionChanged" TargetObject="{Binding}" xmlns="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" />
                    </i:EventTrigger>
                  </i:Interaction.Triggers>
                </Slider>
              </Viewbox>
              <Viewbox Grid.Column="3" Grid.Row="12" VerticalAlignment="Top" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource ColorPickerTitleTextPerformance}" Text="{Binding OffTemperature, StringFormat='{}{0}°C'}" />
