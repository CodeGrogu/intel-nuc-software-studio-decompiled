                  <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseUp">
                      <CallMethodAction MethodName="MinimumDutySelectionChanged" TargetObject="{Binding}" xmlns="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" />
                    </i:EventTrigger>
                  </i:Interaction.Triggers>
                </Slider>
              </Viewbox>
              <Viewbox Grid.Column="3" Grid.Row="6" VerticalAlignment="Top" HorizontalAlignment="Left">
                <TextBlock Width="50" Style="{StaticResource ColorPickerTitleTextPerformance}" Text="{Binding MinDuty, StringFormat='{}{0}°C'}" />
              </Viewbox>
              <Viewbox Grid.Column="1" Grid.Row="8" VerticalAlignment="Top" HorizontalAlignment="Left">
                <TextBlock Text="{StaticResource DutyIncrement}" Style="{StaticResource ColorPickerTitleTextPerformance}" />
              </Viewbox>
              <Viewbox Grid.Column="1" Grid.Row="9" VerticalAlignment="Top" HorizontalAlignment="Left">
