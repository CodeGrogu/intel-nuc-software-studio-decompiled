<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="AlexaLightBarMgr.Views.AlexaLightbarView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:Infrastructure.Converters;assembly=Infrastructure" xmlns:controls="clr-namespace:Infrastructure.Controls;assembly=Infrastructure" xmlns:prism="http://prismlibrary.com/" ViewModelLocator.AutoWireViewModel="True" xmlns:views="clr-namespace:AlexaLightBarMgr.Views;assembly=AlexaLightBarMgr">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <converters:BoolToCollapsedVisibilityConverter x:Key="BoolToCollapsedVisibilityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="{StaticResource CardBackgroundBrush}">
    <ItemsControl Style="{StaticResource CardGridItemsStyle}">
      <controls:CardTitleBarControl Grid.Row="1" Grid.Column="1" IconCanvas="{StaticResource LightbarCardIcon}" TitleText="{StaticResource LightbarLedCardTitleString}" CustomIcon="{Binding DataContext.CustomIconSource, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}" />
      <Viewbox Grid.Row="3" Grid.Column="1" VerticalAlignment="Top" StretchDirection="DownOnly">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="500" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="32" />
            <RowDefinition Height="20" />
            <RowDefinition Height="32" />
            <RowDefinition Height="32" />
          </Grid.RowDefinitions>
          <TextBlock Text="{StaticResource AlexaLedString}" TextWrapping="Wrap" Style="{StaticResource ColorPickerTitleText}" />
          <Rectangle Grid.Row="2" Visibility="{Binding On, Converter={StaticResource BoolToVis}}">
            <Shape.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="Blue" Offset="0.0" />
                <GradientStop Color="Cyan" Offset="0.5" />
                <GradientStop Color="Blue" Offset="1.0" />
              </LinearGradientBrush>
            </Shape.Fill>
          </Rectangle>
          <Rectangle Grid.Row="2" Height="32" Fill="{StaticResource DisableControlBackground}" Visibility="{Binding On, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
          <Viewbox Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right">
            <ToggleButton Grid.Column="2" HorizontalAlignment="Right" IsChecked="{Binding On}">
              <FrameworkElement.Style>
                <Style BasedOn="{StaticResource OnOffToggle}" TargetType="{x:Type ToggleButton}">
                  <Setter Property="IsEnabled" Value="True" />
                  <Style.Triggers>
                    <Trigger Property="ToggleButton.IsChecked" Value="True">
                      <Setter Property="Content" Value="{StaticResource ToggleOnString}" />
                    </Trigger>
                    <Trigger Property="ToggleButton.IsChecked" Value="False">
                      <Setter Property="Content" Value="{StaticResource ToggleOffString}" />
                    </Trigger>
                    <DataTrigger Value="True" Binding="{Binding AlexaSettingHostNotPresent}">
                      <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                    <DataTrigger Value="True" Binding="{Binding A4pcDownloadNeeded}">
                      <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </ToggleButton>
          </Viewbox>
          <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Text="{StaticResource AlexaErrorMessageString}" Style="{StaticResource ColorPickerTitleText}" Visibility="{Binding AlexaSettingHostNotPresent, Converter={StaticResource BoolToCollapsedVisibilityConverter}}" />
          <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Orientation="Horizontal">
            <TextBlock Text="{StaticResource AlexaNotPresentString}" Style="{StaticResource ColorPickerTitleText}" Visibility="{Binding A4pcDownloadNeeded, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text=" " />
            <TextBlock Text=" " />
            <Button Content="{StaticResource HereString}" Style="{StaticResource HyperlinkButton}" Command="{Binding OpenMicrosoftLink}" Visibility="{Binding A4pcDownloadNeeded, Converter={StaticResource BoolToVis}}" />
          </StackPanel>
        </Grid>
      </Viewbox>
    </ItemsControl>
  </Grid>
</UserControl>