<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="SystemMonitorMgr.Views.SystemMonitorSummaryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Infrastructure.Controls;assembly=Infrastructure" xmlns:local_converters="clr-namespace:SystemMonitorMgr.Converters;assembly=" xmlns:local="clr-namespace:SystemMonitorMgr.Views" xmlns:prism="http://prismlibrary.com/" x:Name="SystemMonitorSummaryCard" ViewModelLocator.AutoWireViewModel="True">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/SystemMonitorMgr;component/Style/SystemMonitorStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <local_converters:ClientStateToConnectedConverter x:Key="ClientStateToConnectedConverter" />
      <local_converters:ClientStateToMessageConverter x:Key="ClientStateToMessageConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="{DynamicResource CardBackgroundBrush}">
    <ItemsControl Style="{StaticResource CardGridItemsStyle}">
      <controls:CardTitleBarControl Grid.Row="1" Grid.Column="1" IconCanvas="{StaticResource SystemMonitorCardIcon}" TitleText="{StaticResource SystemMonitorTitleString}" CustomIcon="{Binding DataContext.CustomIconSource, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}" OpenDetailView="{Binding Path=DataContext.OpenDetailView, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
      <Grid Row="1" Column="1" Visibility="{Binding IsConnected, Converter={StaticResource ClientStateToConnectedConverter}}">
        <controls:CardTitleBarControlDisable Grid.Row="1" Grid.Column="1" IconCanvas="{StaticResource SystemMonitorCardIcon}" TitleText="{StaticResource SystemMonitorTitleString}" OpenErrorMessageBox="{Binding Path=DataContext.OpenErrorMessageBox, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" OpenDetailView="{Binding Path=DataContext.OpenDetailView, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
      </Grid>
      <Grid Row="3" Column="1" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Grid.RowDefinitions>
          <RowDefinition />
          <RowDefinition>
            <FrameworkContentElement.Style>
              <Style TargetType="{x:Type RowDefinition}">
                <Setter Property="Height" Value="10" />
                <Style.Triggers>
                  <DataTrigger Value="True">
                    <DataTrigger.Binding>
                      <MultiBinding Converter="{StaticResource FirstIsGreaterOrEqualConverter}">
                        <Binding ElementName="SystemMonitorSummaryCard" Path="ActualWidth" />
                        <Binding ElementName="SystemMonitorSummaryCard" Path="ActualHeight" />
                      </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Height" Value="0" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkContentElement.Style>
          </RowDefinition>
          <RowDefinition>
            <FrameworkContentElement.Style>
              <Style TargetType="{x:Type RowDefinition}">
                <Setter Property="Height" Value="1*" />
                <Style.Triggers>
                  <DataTrigger Value="True">
                    <DataTrigger.Binding>
                      <MultiBinding Converter="{StaticResource FirstIsGreaterOrEqualConverter}">
                        <Binding ElementName="SystemMonitorSummaryCard" Path="ActualWidth" />
                        <Binding ElementName="SystemMonitorSummaryCard" Path="ActualHeight" />
                      </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Height" Value="0" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkContentElement.Style>
          </RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition>
            <FrameworkContentElement.Style>
              <Style TargetType="{x:Type ColumnDefinition}">
                <Setter Property="Width" Value="1*" />
                <Style.Triggers>
                  <DataTrigger Value="False">
                    <DataTrigger.Binding>
                      <MultiBinding Converter="{StaticResource FirstIsGreaterOrEqualConverter}">
                        <Binding ElementName="SystemMonitorSummaryCard" Path="ActualWidth" />
                        <Binding ElementName="SystemMonitorSummaryCard" Path="ActualHeight" />
                      </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Width" Value="0" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkContentElement.Style>
          </ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Viewbox HorizontalAlignment="Left" VerticalAlignment="Center">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ContentControl ContentTemplate="{StaticResource SystemMonitorSummaryData}" Content="{Binding DataSummary, UpdateSourceTrigger=PropertyChanged}" />
          </Grid>
        </Viewbox>
        <Viewbox VerticalAlignment="Top">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type Viewbox}">
              <Setter Property="Grid.Row" Value="2" />
              <Setter Property="Grid.Column" Value="0" />
              <Style.Triggers>
                <DataTrigger Value="True">
                  <DataTrigger.Binding>
                    <MultiBinding Converter="{StaticResource FirstIsGreaterOrEqualConverter}">
                      <Binding ElementName="SystemMonitorSummaryCard" Path="ActualWidth" />
                      <Binding ElementName="SystemMonitorSummaryCard" Path="ActualHeight" />
                    </MultiBinding>
                  </DataTrigger.Binding>
                  <Setter Property="Grid.Row" Value="0" />
                  <Setter Property="Grid.Column" Value="1" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
          <ItemsControl ItemsSource="{Binding Gauges, UpdateSourceTrigger=PropertyChanged}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <local:UsageGaugeControl Margin="25" DataContext="{Binding .}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Viewbox>
      </Grid>
      <Grid Row="3" Column="1" Background="{DynamicResource CardBackgroundBrush}" Visibility="{Binding IsConnected, Converter={StaticResource ClientStateToConnectedConverter}}">
        <Grid.RowDefinitions>
          <RowDefinition MinHeight="5" />
          <RowDefinition />
          <RowDefinition MinHeight="5" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition MinWidth="5" />
          <ColumnDefinition Width="5*" />
          <ColumnDefinition MinWidth="5" />
        </Grid.ColumnDefinitions>
        <Viewbox Grid.Row="1" Grid.Column="1">
          <TextBlock Style="{StaticResource ColorPickerTitleText}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Text="{Binding IsConnected, Converter={StaticResource ClientStateToMessageConverter}}" />
        </Viewbox>
      </Grid>
    </ItemsControl>
  </Grid>
</UserControl>