<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="SystemMonitorMgr.Views.RightSideUsageGaugeControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:prism="http://prismlibrary.com/" xmlns:local="clr-namespace:SystemMonitorMgr.Views" ViewModelLocator.AutoWireViewModel="True" Background="{Binding Background, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/SystemMonitorMgr;component/Style/SystemMonitorStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Viewbox Visibility="{Binding DisplayGauge, Converter={StaticResource BoolToVis}}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition MinWidth="200" Width="200" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="5" />
        <RowDefinition />
      </Grid.RowDefinitions>
      <Grid Column="1" Row="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="10" />
        </Grid.RowDefinitions>
        <Viewbox VerticalAlignment="Top" HorizontalAlignment="Left" StretchDirection="DownOnly">
          <TextBlock Foreground="{DynamicResource TitleBarLogoBrush}" FontSize="50" FontWeight="Bold" TextAlignment="Right" Text="{Binding Label}" />
        </Viewbox>
        <Grid Row="3" Visibility="{Binding Temp, Converter={StaticResource NotNullVisibleConverter}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="2" VerticalAlignment="Bottom" Foreground="{DynamicResource TitleBarLogoBrush}" FontSize="40" FontWeight="Bold" Text="{Binding TempString}" />
          <Viewbox Child="{StaticResource ThermostatIcon}" />
        </Grid>
      </Grid>
      <local:GaugeControl Grid.Row="2" />
    </Grid>
  </Viewbox>
</UserControl>