  <DataTemplate x:Key="SystemMonitorData">
    <Grid Visibility="{Binding Data.Count, Converter={StaticResource ZeroHiddenOtherVisibleConverter}}">
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <CollectionViewSource x:Key="DataList" Source="{Binding Data}">
            <CollectionViewSource.SortDescriptions>
              <componentmodel:SortDescription PropertyName="Order" Direction="Ascending" />
            </CollectionViewSource.SortDescriptions>
          </CollectionViewSource>
        </ResourceDictionary>
      </FrameworkElement.Resources>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="500" />
        <ColumnDefinition Width="50" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <controls:UsageGaugeControl VerticalAlignment="Top" Margin="0, -45, 0, 0" DataContext="{Binding Gauge}" Visibility="{Binding ., Converter={StaticResource NullHiddenConverter}}" />
      <Grid Column="2" VerticalAlignment="Top" Margin="0,-20,0,-40">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition />
          <RowDefinition />
        </Grid.RowDefinitions>
        <ItemsControl HorizontalAlignment="Left" ItemsSource="{Binding UpdateSourceTrigger=PropertyChanged, Source={StaticResource DataList}}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Vertical" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid HorizontalAlignment="Left" Margin="0,-15" Visibility="{Binding Path=Value, Converter={StaticResource StringNotEmptyConverter}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition>
                    <FrameworkContentElement.Style>
                      <Style TargetType="{x:Type ColumnDefinition}">
                        <Setter Property="Width" Value="10" />
                        <Style.Triggers>
                          <DataTrigger Value="true" Binding="{Binding ElementName=Label, Path=Text, Converter={StaticResource StringNotEmptyConverter}}">
                            <Setter Property="Width" Value="10" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkContentElement.Style>
                  </ColumnDefinition>
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Name="Label" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,18" Style="{StaticResource ColorPickerTitleText}" Text="{Binding Path=Key}" />
                <Viewbox Grid.Column="2" StretchDirection="DownOnly" VerticalAlignment="Bottom">
                  <TextBlock FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,18" Style="{StaticResource ColorPickerTitleText}" Text="{Binding Path=Value}" />
                </Viewbox>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="SystemMonitorHwData">
    <Grid Visibility="{Binding Data.Count, Converter={StaticResource ZeroHiddenOtherVisibleConverter}}">
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <CollectionViewSource x:Key="DataList" Source="{Binding Data}">
            <CollectionViewSource.SortDescriptions>
              <componentmodel:SortDescription PropertyName="Order" Direction="Ascending" />
            </CollectionViewSource.SortDescriptions>
          </CollectionViewSource>
        </ResourceDictionary>
      </FrameworkElement.Resources>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="10" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ItemsControl HorizontalAlignment="Left" ItemsSource="{Binding UpdateSourceTrigger=PropertyChanged, Source={StaticResource DataList}}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid HorizontalAlignment="Left" Margin="0,-30,30,0" Visibility="{Binding Path=Value, Converter={StaticResource StringNotEmptyConverter}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="5" />
                  <ColumnDefinition>
                    <FrameworkContentElement.Style>
                      <Style TargetType="{x:Type ColumnDefinition}">
                        <Setter Property="Width" Value="0" />
                        <Style.Triggers>
                          <DataTrigger Value="true" Binding="{Binding ElementName=Label, Path=Text, Converter={StaticResource StringNotEmptyConverter}}">
                            <Setter Property="Width" Value="10" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkContentElement.Style>
                  </ColumnDefinition>
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Name="Label" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,18" Style="{StaticResource ColorPickerTitleText}" Text="{Binding Path=Key}" />
                <TextBlock Grid.Column="1" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,18" Style="{StaticResource ColorPickerTitleText}" Text="{StaticResource TextSeparatorString}" />
                <TextBlock Grid.Column="3" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,18" Style="{StaticResource ColorPickerTitleText}" Text="{Binding Path=Value}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="SystemMonitorSummaryData">
    <Grid Visibility="{Binding Count, Converter={StaticResource ZeroHiddenOtherVisibleConverter}}">
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <CollectionViewSource x:Key="DataList" Source="{Binding}">
            <CollectionViewSource.SortDescriptions>
              <componentmodel:SortDescription PropertyName="Order" Direction="Ascending" />
            </CollectionViewSource.SortDescriptions>
          </CollectionViewSource>
        </ResourceDictionary>
      </FrameworkElement.Resources>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="500" />
        <ColumnDefinition Width="50" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition Height="30" />
      </Grid.RowDefinitions>
      <ItemsControl HorizontalAlignment="Left" ItemsSource="{Binding UpdateSourceTrigger=PropertyChanged, Source={StaticResource DataList}}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Vertical" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid HorizontalAlignment="Left" Margin="0,-15" Visibility="{Binding Path=Value, Converter={StaticResource StringNotEmptyConverter}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition>
                  <FrameworkContentElement.Style>
                    <Style TargetType="{x:Type ColumnDefinition}">
                      <Setter Property="Width" Value="0" />
                      <Style.Triggers>
                        <DataTrigger Value="true" Binding="{Binding ElementName=Label, Path=Text, Converter={StaticResource StringNotEmptyConverter}}">
                          <Setter Property="Width" Value="20" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkContentElement.Style>
                </ColumnDefinition>
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <TextBlock Name="Label" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,18" Style="{StaticResource ColorPickerTitleText}" Text="{Binding Path=Key}" />
              <TextBlock Grid.Column="2" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,18" Style="{StaticResource ColorPickerTitleText}" Text="{StaticResource TextSeparatorString}" />
              <TextBlock Grid.Column="3" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,18" Style="{StaticResource ColorPickerTitleText}" Text="{Binding Path=Value}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="SystemMonitorDataSection">
    <Viewbox StretchDirection="DownOnly" VerticalAlignment="Top">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="40" />
          <RowDefinition Height="15" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="40" />
        </Grid.RowDefinitions>
        <TextBlock Name="TitleText" Margin="210,0" Style="{StaticResource RadioButtonTitleText}" Text="{Binding Type, Converter={StaticResource SystemDataTypeToLabelConverter}}" />
        <ContentControl Grid.Row="2" ContentTemplate="{StaticResource SystemMonitorData}" Content="{Binding ., UpdateSourceTrigger=PropertyChanged}" />
      </Grid>
    </Viewbox>
  </DataTemplate>
  <DataTemplate x:Key="SystemMonitorHwDataSection">
    <Viewbox StretchDirection="DownOnly" MaxHeight="250" VerticalAlignment="Bottom">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="40" />
          <RowDefinition Height="15" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Name="TitleText" Style="{StaticResource RadioButtonTitleText}" Text="{Binding Type, Converter={StaticResource SystemDataTypeToLabelConverter}}" />
        <ContentControl Grid.Row="2" ContentTemplate="{StaticResource SystemMonitorHwData}" Content="{Binding ., UpdateSourceTrigger=PropertyChanged}" />
      </Grid>
    </Viewbox>
  </DataTemplate>
</ResourceDictionary>