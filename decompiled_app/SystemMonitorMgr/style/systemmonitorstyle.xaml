  <Style x:Key="SystemMonitorButton" TargetType="{x:Type Button}" BasedOn="{StaticResource GeneralButton}">
    <Setter Property="FrameworkElement.Tag" Value="" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="ButtonBorder">
            <Viewbox>
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="10" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Viewbox Child="{StaticResource SystemMonitorIcon}">
                  <FrameworkElement.Style>
                    <Style>
                      <Style.Triggers>
                        <DataTrigger Value="Visible" Binding="{Binding ElementName=CustomIconViewbox, Path=Visibility}">
                          <Setter Property="UIElement.Visibility" Value="Hidden" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                </Viewbox>
                <Viewbox Name="CustomIconViewbox" VerticalAlignment="Center" Visibility="{Binding CustomIcon, Converter={StaticResource NotNullVisibleConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}">
                  <Viewbox.Child>
                    <Image Source="{Binding CustomIcon, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                  </Viewbox.Child>
                </Viewbox>
                <ContentControl Grid.Row="2" FontSize="20" Content="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
              </Grid>
            </Viewbox>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="False">
              <Setter TargetName="ButtonBorder" Property="Border.Background" Value="#00FFFFFF" />
              <Setter Property="Foreground" Value="{StaticResource TransparentButtonDefaultTextBrush}" />
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="ButtonBorder" Property="Border.Background" Value="#00FFFFFF" />
              <Setter Property="Foreground" Value="{StaticResource TransparentButtonHoverTextBrush}" />
              <Setter Property="UIElement.Effect">
                <Setter.Value>
                  <DropShadowEffect ShadowDepth="0" Color="{DynamicResource SecondaryColor}" Opacity="1" BlurRadius="20" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ButtonBorder" Property="Border.Background" Value="#00FFFFFF" />
              <Setter Property="Foreground" Value="{StaticResource TransparentButtonDisabledTextBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
