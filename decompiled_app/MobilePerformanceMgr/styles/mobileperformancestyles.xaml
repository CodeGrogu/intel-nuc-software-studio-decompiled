<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local_converters="clr-namespace:MobilePerformanceMgr.Converters" xmlns:converters="clr-namespace:Infrastructure.Converters;assembly=Infrastructure" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity">
  <local_converters:ProfileIndexToNameConverter x:Key="ProfileIndexToNameConverter" />
  <local_converters:SelectedProfileConverter x:Key="SelectedProfileConverter" />
  <local_converters:IntToCpuStringConverter x:Key="IntToCpuStringConverter" />
  <local_converters:IntToFanStringConverter x:Key="IntToFanStringConverter" />
  <local_converters:QuietModeOptionEnabledConverter x:Key="QuietModeOptionEnabledConverter" />
  <local_converters:ModeToggleToEnabledBoolMultiConverter x:Key="ModeToggleToEnabledBoolMultiConverter" />
  <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
  <Style x:Key="HeaderText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ColorPickerTitleText}">
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="FontSize" Value="28" />
  </Style>
  <Style x:Key="SubheaderText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ColorPickerTitleText}">
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="FontSize" Value="24" />
  </Style>
  <Style x:Key="FirstHeaderOnlyText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource HeaderText}">
    <Setter Property="Visibility" Value="Collapsed" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=PreviousData}}" Value="{x:Null}">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="FirstSubheaderOnlyText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SubheaderText}">
    <Setter Property="Visibility" Value="Collapsed" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=PreviousData}}" Value="{x:Null}">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="SeperatorStyle" TargetType="{x:Type Rectangle}" BasedOn="{StaticResource HorizontalSeparator}">
    <Setter Property="Visibility" Value="Visible" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=PreviousData}}" Value="{x:Null}">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <DataTemplate x:Key="PerformanceProfileTemplate">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="10" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="10" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="20" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="50" />
        <ColumnDefinition Width="225" />
        <ColumnDefinition Width="50" />
        <ColumnDefinition Width="225" />
        <ColumnDefinition Width="30" />
        <ColumnDefinition Width="225" />
        <ColumnDefinition Width="100" />
        <ColumnDefinition Width="225" />
        <ColumnDefinition Width="30" />
        <ColumnDefinition Width="225" />
      </Grid.ColumnDefinitions>
      <Rectangle Name="Separator" Grid.Column="1" Grid.ColumnSpan="10" VerticalAlignment="Center" Style="{StaticResource SeperatorStyle}" />
      <TextBlock Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" Text="{StaticResource PluggedInString}" Style="{StaticResource FirstHeaderOnlyText}" />
      <TextBlock Grid.Row="1" Grid.Column="7" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" Text="{StaticResource OnBatteryString}" Style="{StaticResource FirstHeaderOnlyText}" />
      <Viewbox Grid.Row="2" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Bottom" StretchDirection="DownOnly">
        <TextBlock Text="{StaticResource PowerModeString}" Style="{StaticResource FirstSubheaderOnlyText}" />
      </Viewbox>
      <Viewbox Grid.Row="2" Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Bottom" StretchDirection="DownOnly">
        <TextBlock Text="{StaticResource FanModeString}" Style="{StaticResource FirstSubheaderOnlyText}" />
      </Viewbox>
      <Viewbox Grid.Row="2" Grid.Column="7" HorizontalAlignment="Center" VerticalAlignment="Bottom" StretchDirection="DownOnly">
        <TextBlock Text="{StaticResource PowerModeString}" Style="{StaticResource FirstSubheaderOnlyText}" />
      </Viewbox>
      <Viewbox Grid.Row="2" Grid.Column="9" HorizontalAlignment="Center" VerticalAlignment="Bottom" StretchDirection="DownOnly">
        <TextBlock Text="{StaticResource FanModeString}" Style="{StaticResource FirstSubheaderOnlyText}" />
      </Viewbox>
      <RadioButton Name="ProfileIndexRadioButton" GroupName="PerformanceProfile" Grid.Row="6" Grid.Column="1" Command="{Binding DataContext.SelectedProfileChanged, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}" CommandParameter="{Binding .}">
        <Viewbox StretchDirection="DownOnly">
          <TextBlock Name="ProfileName" Style="{StaticResource HeaderText}" Text="{Binding Index, Converter={StaticResource ProfileIndexToNameConverter}}" />
        </Viewbox>
        <FrameworkElement.Style>
          <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource RadioButtonControlBlue}">
            <Setter Property="ToggleButton.IsChecked">
              <Setter.Value>
                <MultiBinding Converter="{StaticResource SelectedProfileConverter}">
                  <Binding Path="." />
                  <Binding Path="DataContext.SelectedProfile" RelativeSource="{RelativeSource AncestorType=UserControl, Mode=FindAncestor}" />
                </MultiBinding>
              </Setter.Value>
            </Setter>
          </Style>
        </FrameworkElement.Style>
        <UIElement.IsEnabled>
          <MultiBinding Converter="{StaticResource ModeToggleToEnabledBoolMultiConverter}">
            <Binding Path="DataContext.BenchmarkMode" RelativeSource="{RelativeSource AncestorType=UserControl, Mode=FindAncestor}" />
            <Binding Path="DataContext.WhisperMode" RelativeSource="{RelativeSource AncestorType=UserControl, Mode=FindAncestor}" />
          </MultiBinding>
        </UIElement.IsEnabled>
      </RadioButton>
      <ComboBox Grid.Column="3" Grid.Row="6" HorizontalAlignment="Stretch" Height="43" FontSize="20" Foreground="{DynamicResource TextBlockForegroundBrush}" Background="{DynamicResource TextBlockBackgroundBrush}" Style="{StaticResource ComboBoxStyle}" ItemsSource="{Binding DataContext.ProfileOptions, RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=1}}" SelectedValue="{Binding Ac.CpuMode}">
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Template" Value="{StaticResource BlueDropDownTemplate}" />
          </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Viewbox>
              <TextBlock Padding="2" Text="{Binding ., Converter={StaticResource IntToCpuStringConverter}}" />
            </Viewbox>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
        <UIElement.IsEnabled>
          <MultiBinding Converter="{StaticResource ModeToggleToEnabledBoolMultiConverter}">
            <Binding Path="DataContext.BenchmarkMode" RelativeSource="{RelativeSource AncestorType=UserControl, Mode=FindAncestor}" />
            <Binding Path="DataContext.WhisperMode" RelativeSource="{RelativeSource AncestorType=UserControl, Mode=FindAncestor}" />
          </MultiBinding>
        </UIElement.IsEnabled>
        <i:Interaction.Triggers>
          <i:EventTrigger EventName="SelectionChanged">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.UpdateProfiles, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding .}" />
          </i:EventTrigger>
        </i:Interaction.Triggers>
      </ComboBox>
      <ComboBox Name="AcFanComboBox" Grid.Column="5" Grid.Row="6" HorizontalAlignment="Stretch" Height="43" FontSize="20" Foreground="{DynamicResource TextBlockForegroundBrush}" Background="{DynamicResource TextBlockBackgroundBrush}" SelectedValue="{Binding Ac.FanMode}">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource ComboBoxStyle}">
            <Setter Property="ItemsSource" Value="{Binding DataContext.ProfileOptions, RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=1}}" />
            <Style.Triggers>
              <DataTrigger Value="False" Binding="{Binding Path=DataContext.Ac.CpuMode, ElementName=ProfileIndexRadioButton, Converter={StaticResource QuietModeOptionEnabledConverter}}">
                <Setter Property="ItemsSource" Value="{Binding DataContext.PerformanceLimitedFanOptions, RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=1}}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Template" Value="{StaticResource BlueDropDownTemplate}" />
          </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Viewbox>
              <TextBlock Name="AcFanMode" Padding="2" Text="{Binding ., Converter={StaticResource IntToFanStringConverter}}" />
            </Viewbox>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
        <UIElement.IsEnabled>
          <MultiBinding Converter="{StaticResource ModeToggleToEnabledBoolMultiConverter}">
            <Binding Path="DataContext.BenchmarkMode" RelativeSource="{RelativeSource AncestorType=UserControl, Mode=FindAncestor}" />
            <Binding Path="DataContext.WhisperMode" RelativeSource="{RelativeSource AncestorType=UserControl, Mode=FindAncestor}" />
          </MultiBinding>
        </UIElement.IsEnabled>
        <i:Interaction.Triggers>
          <i:EventTrigger EventName="SelectionChanged">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.UpdateProfiles, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding .}" />
          </i:EventTrigger>
        </i:Interaction.Triggers>
      </ComboBox>
      <ComboBox Grid.Column="7" Grid.Row="6" HorizontalAlignment="Stretch" Height="43" FontSize="20" Foreground="{DynamicResource TextBlockForegroundBrush}" Background="{DynamicResource TextBlockBackgroundBrush}" Style="{StaticResource ComboBoxStyle}" ItemsSource="{Binding DataContext.ProfileOptions, RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=1}}" SelectedValue="{Binding Dc.CpuMode}">
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Template" Value="{StaticResource BlueDropDownTemplate}" />
          </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Viewbox>
              <TextBlock Padding="2" Text="{Binding ., Converter={StaticResource IntToCpuStringConverter}}" />
            </Viewbox>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
        <UIElement.IsEnabled>
          <MultiBinding Converter="{StaticResource ModeToggleToEnabledBoolMultiConverter}">
            <Binding Path="DataContext.BenchmarkMode" RelativeSource="{RelativeSource AncestorType=UserControl, Mode=FindAncestor}" />
            <Binding Path="DataContext.WhisperMode" RelativeSource="{RelativeSource AncestorType=UserControl, Mode=FindAncestor}" />
          </MultiBinding>
        </UIElement.IsEnabled>
        <i:Interaction.Triggers>
          <i:EventTrigger EventName="SelectionChanged">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.UpdateProfiles, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding .}" />
          </i:EventTrigger>
        </i:Interaction.Triggers>
      </ComboBox>
      <ComboBox Name="DcFanComboBox" Grid.Column="9" Grid.Row="6" HorizontalAlignment="Stretch" Height="43" FontSize="20" Foreground="{DynamicResource TextBlockForegroundBrush}" Background="{DynamicResource TextBlockBackgroundBrush}" SelectedValue="{Binding Dc.FanMode}">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource ComboBoxStyle}">
            <Setter Property="ItemsSource" Value="{Binding DataContext.ProfileOptions, RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=1}}" />
            <Style.Triggers>
              <DataTrigger Value="False" Binding="{Binding Path=DataContext.Dc.CpuMode, ElementName=ProfileIndexRadioButton, Converter={StaticResource QuietModeOptionEnabledConverter}}">
                <Setter Property="ItemsSource" Value="{Binding DataContext.PerformanceLimitedFanOptions, RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=1}}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Template" Value="{StaticResource BlueDropDownTemplate}" />
          </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Viewbox>
              <TextBlock Name="DcFanMode" Padding="2" Text="{Binding ., Converter={StaticResource IntToFanStringConverter}}" />
            </Viewbox>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
        <UIElement.IsEnabled>
          <MultiBinding Converter="{StaticResource ModeToggleToEnabledBoolMultiConverter}">
            <Binding Path="DataContext.BenchmarkMode" RelativeSource="{RelativeSource AncestorType=UserControl, Mode=FindAncestor}" />
            <Binding Path="DataContext.WhisperMode" RelativeSource="{RelativeSource AncestorType=UserControl, Mode=FindAncestor}" />
          </MultiBinding>
        </UIElement.IsEnabled>
        <i:Interaction.Triggers>
          <i:EventTrigger EventName="SelectionChanged">
            <i:InvokeCommandAction Command="{Binding Path=DataContext.UpdateProfiles, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding .}" />
          </i:EventTrigger>
        </i:Interaction.Triggers>
      </ComboBox>
    </Grid>
  </DataTemplate>
</ResourceDictionary>