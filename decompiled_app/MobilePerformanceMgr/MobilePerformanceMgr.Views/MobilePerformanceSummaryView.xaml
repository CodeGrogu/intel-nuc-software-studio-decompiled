<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="MobilePerformanceMgr.Views.MobilePerformanceSummaryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:controls="clr-namespace:Infrastructure.Controls;assembly=Infrastructure" xmlns:converters="clr-namespace:Infrastructure.Converters;assembly=Infrastructure" xmlns:local_converters="clr-namespace:MobilePerformanceMgr.Converters" xmlns:prism="http://prismlibrary.com/" xmlns:views="clr-namespace:MobilePerformanceMgr.Views">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <local_converters:PerformanceModeToCpuStringMultiConverter x:Key="PerformanceModeToCpuStringMultiConverter" />
      <local_converters:PerformanceModetoFanStringMultiConverter x:Key="PerformanceModetoFanStringMultiConverter" />
      <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
      <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="BigGrid" Background="{DynamicResource CardBackgroundBrush}">
    <ItemsControl Style="{StaticResource CardGridItemsStyle}">
      <controls:CardTitleBarControl Grid.Row="1" Grid.Column="1" IconCanvas="{StaticResource PerformanceCardIcon}" TitleText="{StaticResource PerformanceCardTitleString}" CustomIcon="{Binding DataContext.CustomIconSource, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}" OpenDetailView="{Binding Path=DataContext.OpenDetailView, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
      <Viewbox Grid.Row="3" Grid.Column="1" Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibilityConverter}}">
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource FanLabelBrush}" Text="{StaticResource ErrorMessageString}" Padding="50" />
      </Viewbox>
      <Viewbox Grid.Row="3" Grid.Column="1" StretchDirection="DownOnly" VerticalAlignment="Top" HorizontalAlignment="Left" Stretch="Uniform" Visibility="{Binding ErrorMessage, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
        <Grid Height="355" Width="835">
          <Grid.RowDefinitions>
            <RowDefinition Height="35" />
            <RowDefinition MinHeight="10" Height="Auto" />
            <RowDefinition />
            <RowDefinition MinHeight="10" />
            <RowDefinition Height="180" />
            <RowDefinition MaxHeight="25" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="225" />
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="225" />
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="225" />
          </Grid.ColumnDefinitions>
          <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.ColumnSpan="2" Stretch="Uniform">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Viewbox}">
                <Setter Property="Grid.Row" Value="0" />
                <Setter Property="Grid.RowSpan" Value="2" />
                <Style.Triggers>
                  <Trigger Property="TextBlock.LineHeight" Value="1">
                    <Setter Property="Grid.Row" Value="1" />
                    <Setter Property="Grid.RowSpan" Value="1" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <TextBlock Style="{StaticResource KcAppTitleText}" Text="{StaticResource PowerModeRadioButtonTitle}" MaxWidth="250" OverridesDefaultStyle="True" TextWrapping="WrapWithOverflow" />
          </Viewbox>
          <Viewbox Grid.Column="2" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.ColumnSpan="2">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Viewbox}">
                <Setter Property="Grid.Row" Value="0" />
                <Setter Property="Grid.RowSpan" Value="2" />
                <Style.Triggers>
                  <Trigger Property="TextBlock.LineHeight" Value="1">
                    <Setter Property="Grid.Row" Value="1" />
                    <Setter Property="Grid.RowSpan" Value="1" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <TextBlock Style="{StaticResource KcAppTitleText}" Text="{StaticResource FanModeRadioButtonTitle}" MaxWidth="250" OverridesDefaultStyle="True" TextWrapping="WrapWithOverflow" />
          </Viewbox>
          <Viewbox Grid.Column="4" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type Viewbox}">
                <Setter Property="Grid.Row" Value="0" />
                <Setter Property="Grid.RowSpan" Value="2" />
                <Style.Triggers>
                  <Trigger Property="TextBlock.LineHeight" Value="1">
                    <Setter Property="Grid.Row" Value="1" />
                    <Setter Property="Grid.RowSpan" Value="1" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
            <TextBlock Style="{StaticResource KcAppTitleText}" Text="{StaticResource FanSpeedString}" MaxWidth="250" OverridesDefaultStyle="True" TextWrapping="WrapWithOverflow" />
          </Viewbox>
          <Viewbox HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Row="2" Grid.RowSpan="2" Grid.ColumnSpan="2" StretchDirection="DownOnly" Stretch="Uniform">
            <Grid Width="350">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition MinHeight="2" Height="2" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition MaxWidth="150" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="150" />
              </Grid.ColumnDefinitions>
              <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type Viewbox}">
                    <Setter Property="Grid.Row" Value="0" />
                    <Setter Property="Grid.RowSpan" Value="2" />
                    <Style.Triggers>
                      <Trigger Property="TextBlock.LineHeight" Value="1">
                        <Setter Property="Grid.Row" Value="1" />
                        <Setter Property="Grid.RowSpan" Value="1" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <TextBlock Style="{StaticResource KcCardSubHeaderText}" Text="{StaticResource PluggedTitleString}" FontSize="26" MaxWidth="250" OverridesDefaultStyle="True" TextWrapping="WrapWithOverflow" />
              </Viewbox>
              <Viewbox Grid.Column="2" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type Viewbox}">
                    <Setter Property="Grid.Row" Value="0" />
                    <Setter Property="Grid.RowSpan" Value="2" />
                    <Style.Triggers>
                      <Trigger Property="TextBlock.LineHeight" Value="1">
                        <Setter Property="Grid.Row" Value="1" />
                        <Setter Property="Grid.RowSpan" Value="1" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <TextBlock Style="{StaticResource KcCardSubHeaderText}" FontSize="26" MaxWidth="250" OverridesDefaultStyle="True" TextWrapping="WrapWithOverflow">
                  <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource PerformanceModeToCpuStringMultiConverter}">
                      <Binding Path="SelectedProfile.Ac" />
                      <Binding Path="BenchmarkMode" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
              </Viewbox>
              <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type Viewbox}">
                    <Setter Property="Grid.Row" Value="2" />
                    <Setter Property="Grid.RowSpan" Value="2" />
                    <Style.Triggers>
                      <Trigger Property="TextBlock.LineHeight" Value="1">
                        <Setter Property="Grid.Row" Value="3" />
                        <Setter Property="Grid.RowSpan" Value="1" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <TextBlock Style="{StaticResource KcCardSubHeaderText}" FontSize="26" Text="{StaticResource BatteryString}" MaxWidth="250" OverridesDefaultStyle="True" TextWrapping="WrapWithOverflow" />
              </Viewbox>
              <Viewbox Grid.Column="2" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type Viewbox}">
                    <Setter Property="Grid.Row" Value="2" />
                    <Setter Property="Grid.RowSpan" Value="2" />
                    <Style.Triggers>
                      <Trigger Property="TextBlock.LineHeight" Value="1">
                        <Setter Property="Grid.Row" Value="3" />
                        <Setter Property="Grid.RowSpan" Value="1" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <TextBlock Style="{StaticResource KcCardSubHeaderText}" FontSize="26" MaxWidth="250" OverridesDefaultStyle="True" TextWrapping="WrapWithOverflow">
                  <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource PerformanceModeToCpuStringMultiConverter}">
                      <Binding Path="SelectedProfile.Dc" />
                      <Binding Path="BenchmarkMode" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
              </Viewbox>
            </Grid>
          </Viewbox>
          <Viewbox HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Row="2" Grid.RowSpan="2" Grid.Column="2" Grid.ColumnSpan="2" StretchDirection="DownOnly" Stretch="Uniform">
            <Grid Width="350">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition MinHeight="2" Height="2" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition MaxWidth="150" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="150" />
              </Grid.ColumnDefinitions>
              <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type Viewbox}">
                    <Setter Property="Grid.Row" Value="0" />
                    <Setter Property="Grid.RowSpan" Value="2" />
                    <Style.Triggers>
                      <Trigger Property="TextBlock.LineHeight" Value="1">
                        <Setter Property="Grid.Row" Value="1" />
                        <Setter Property="Grid.RowSpan" Value="1" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <TextBlock Style="{StaticResource KcCardSubHeaderText}" Text="{StaticResource PluggedTitleString}" FontSize="26" MaxWidth="250" OverridesDefaultStyle="True" TextWrapping="WrapWithOverflow" />
              </Viewbox>
              <Viewbox Grid.Column="2" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type Viewbox}">
                    <Setter Property="Grid.Row" Value="0" />
                    <Setter Property="Grid.RowSpan" Value="2" />
                    <Style.Triggers>
                      <Trigger Property="TextBlock.LineHeight" Value="1">
                        <Setter Property="Grid.Row" Value="1" />
                        <Setter Property="Grid.RowSpan" Value="1" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <TextBlock Style="{StaticResource KcCardSubHeaderText}" FontSize="26" MaxWidth="250" OverridesDefaultStyle="True" TextWrapping="WrapWithOverflow">
                  <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource PerformanceModetoFanStringMultiConverter}">
                      <Binding Path="SelectedProfile.Ac" />
                      <Binding Path="BenchmarkMode" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
              </Viewbox>
              <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type Viewbox}">
                    <Setter Property="Grid.Row" Value="2" />
                    <Setter Property="Grid.RowSpan" Value="2" />
                    <Style.Triggers>
                      <Trigger Property="TextBlock.LineHeight" Value="1">
                        <Setter Property="Grid.Row" Value="3" />
                        <Setter Property="Grid.RowSpan" Value="1" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <TextBlock Style="{StaticResource KcCardSubHeaderText}" Text="{StaticResource BatteryString}" FontSize="26" MaxWidth="250" OverridesDefaultStyle="True" TextWrapping="WrapWithOverflow" />
              </Viewbox>
              <Viewbox Grid.Column="2" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type Viewbox}">
                    <Setter Property="Grid.Row" Value="2" />
                    <Setter Property="Grid.RowSpan" Value="2" />
                    <Style.Triggers>
                      <Trigger Property="TextBlock.LineHeight" Value="1">
                        <Setter Property="Grid.Row" Value="3" />
                        <Setter Property="Grid.RowSpan" Value="1" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <TextBlock Style="{StaticResource KcCardSubHeaderText}" FontSize="26" MaxWidth="250" OverridesDefaultStyle="True" TextWrapping="WrapWithOverflow">
                  <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource PerformanceModetoFanStringMultiConverter}">
                      <Binding Path="SelectedProfile.Dc" />
                      <Binding Path="BenchmarkMode" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
              </Viewbox>
            </Grid>
          </Viewbox>
          <ContentControl HorizontalAlignment="Left" VerticalAlignment="Bottom" Grid.Row="4" Grid.ColumnSpan="2" prism:RegionManager.RegionName="{Binding CpuUsageRegion}" />
          <ContentControl HorizontalAlignment="Left" VerticalAlignment="Bottom" Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2" prism:RegionManager.RegionName="{Binding dGpuUsageRegion}" />
          <Viewbox Grid.Row="4" Grid.RowSpan="2" Grid.Column="4" HorizontalAlignment="Left" Stretch="Uniform">
            <ContentControl prism:RegionManager.RegionName="{Binding PerfTuningFanRegion}" />
          </Viewbox>
        </Grid>
      </Viewbox>
    </ItemsControl>
  </Grid>
</UserControl>