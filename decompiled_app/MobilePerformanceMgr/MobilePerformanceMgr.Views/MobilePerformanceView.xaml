<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="MobilePerformanceMgr.Views.MobilePerformanceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Infrastructure.Controls;assembly=Infrastructure" xmlns:local_converters="clr-namespace:MobilePerformanceMgr.Converters" xmlns:prism="http://prismlibrary.com/" xmlns:views="clr-namespace:MobilePerformanceMgr.Views">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <local_converters:WhisperModeIntToTypeStringConverter x:Key="WhisperModeIntToTypeStringConverter" />
      <local_converters:ModeToggleToEnabledBoolMultiConverter x:Key="ModeToggleToEnabledBoolMultiConverter" />
      <local_converters:WhisperModeToggleEnabledBoolMultiConverter x:Key="WhisperModeToggleEnabledBoolMultiConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="{DynamicResource CardBackgroundBrush}">
    <ItemsControl Style="{StaticResource DetailCardGridItemsStyle}">
      <Viewbox Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left" StretchDirection="DownOnly">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="1260" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <controls:DetailCardTitleBarControl IconCanvas="{StaticResource PerformanceCardIcon}" TitleText="{StaticResource PerformanceCardTitleString}" HorizontalAlignment="Left" CustomIcon="{Binding DataContext.CustomIconSource, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor}}" />
          <TextBlock Text="{StaticResource RestoreDefaultsString}" Foreground="{DynamicResource TransparentButtonDefaultTextBrush}" FontSize="28" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
            <UIElement.InputBindings>
              <MouseBinding MouseAction="LeftClick" Command="{Binding RestoreDefaultCommand}" />
            </UIElement.InputBindings>
            <FrameworkElement.Style>
              <Style TargetType="{x:Type TextBlock}">
                <Style.Triggers>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter Property="UIElement.BitmapEffect">
                      <Setter.Value>
                        <DropShadowBitmapEffect Color="White" Direction="360" ShadowDepth="1" Softness="0.7" Opacity="1" />
                      </Setter.Value>
                    </Setter>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </TextBlock>
        </Grid>
      </Viewbox>
      <Rectangle Name="Separator" Grid.Column="1" Grid.Row="3" Style="{StaticResource HorizontalSeparator}" />
      <Viewbox Grid.Column="1" Grid.Row="5" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Uniform">
        <Grid Height="800" Width="2075">
          <Grid.RowDefinitions>
            <RowDefinition MinHeight="315" />
            <RowDefinition Height="30" />
            <RowDefinition Height="300" />
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="50" />
              <ColumnDefinition Width="325" />
            </Grid.ColumnDefinitions>
            <Viewbox HorizontalAlignment="Left" VerticalAlignment="Top">
              <ItemsControl Name="Profiles" ItemTemplate="{StaticResource PerformanceProfileTemplate}" ItemsSource="{Binding CurrentProfiles, UpdateSourceTrigger=PropertyChanged}" />
            </Viewbox>
            <Grid Column="2" VerticalAlignment="Center" HorizontalAlignment="Left">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="15" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="15" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Style="{StaticResource SubheaderText}" MaxWidth="300" FontSize="24" Text="{StaticResource BenchmarkModeString}" TextWrapping="WrapWithOverflow" />
              <ToggleButton Width="115" Height="40" Grid.Row="1" HorizontalAlignment="Left" Margin="0,10" IsChecked="{Binding BenchmarkMode}" IsEnabled="{Binding WhisperMode, Converter={StaticResource InverseBooleanConverter}}">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type ToggleButton}">
                    <Setter Property="Template" Value="{StaticResource BasicToggleButton}" />
                    <Style.Triggers>
                      <Trigger Property="ToggleButton.IsChecked" Value="True">
                        <Setter Property="Content" Value="{StaticResource ToggleOnString}" />
                      </Trigger>
                      <Trigger Property="ToggleButton.IsChecked" Value="False">
                        <Setter Property="Content" Value="{StaticResource ToggleOffString}" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </ToggleButton>
              <TextBlock Style="{StaticResource SubheaderText}" MaxWidth="300" FontSize="24" Text="{StaticResource PassiveCoolingModeString}" TextWrapping="WrapWithOverflow" Grid.Row="3" />
              <ToggleButton Width="115" Height="40" Grid.Row="4" HorizontalAlignment="Left" Margin="0,10" IsChecked="{Binding PassiveCoolingMode}">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type ToggleButton}">
                    <Setter Property="Template" Value="{StaticResource BasicToggleButton}" />
                    <Style.Triggers>
                      <Trigger Property="ToggleButton.IsChecked" Value="True">
                        <Setter Property="Content" Value="{StaticResource ToggleOnString}" />
                      </Trigger>
                      <Trigger Property="ToggleButton.IsChecked" Value="False">
                        <Setter Property="Content" Value="{StaticResource ToggleOffString}" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <UIElement.IsEnabled>
                  <MultiBinding Converter="{StaticResource ModeToggleToEnabledBoolMultiConverter}">
                    <Binding Path="BenchmarkMode" />
                    <Binding Path="WhisperMode" />
                  </MultiBinding>
                </UIElement.IsEnabled>
              </ToggleButton>
              <TextBlock Style="{StaticResource SubheaderText}" MaxWidth="300" FontSize="24" Text="{StaticResource WhisperModeString}" TextWrapping="WrapWithOverflow" Grid.Row="6" />
              <Grid HorizontalAlignment="Left" Row="7" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                  <RowDefinition Height="10" />
                  <RowDefinition Height="40" />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="115" />
                  <ColumnDefinition Width="20" />
                  <ColumnDefinition Width="50" />
                  <ColumnDefinition Width="50" />
                </Grid.ColumnDefinitions>
                <ToggleButton Width="115" Height="40" Grid.Row="1" HorizontalAlignment="Left" IsChecked="{Binding WhisperMode}">
                  <UIElement.IsEnabled>
                    <MultiBinding Converter="{StaticResource WhisperModeToggleEnabledBoolMultiConverter}">
                      <Binding Path="BenchmarkMode" />
                      <Binding Path="WhisperModeSupported" />
                    </MultiBinding>
                  </UIElement.IsEnabled>
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type ToggleButton}">
                      <Setter Property="Template" Value="{StaticResource BasicToggleButton}" />
                      <Style.Triggers>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                          <Setter Property="Content" Value="{StaticResource ToggleOnString}" />
                        </Trigger>
                        <Trigger Property="ToggleButton.IsChecked" Value="False">
                          <Setter Property="Content" Value="{StaticResource ToggleOffString}" />
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                </ToggleButton>
                <Viewbox Grid.Column="2" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                  <Viewbox.Child>
                    <Border Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0">
                      <ContentPresenter Content="{StaticResource InfoIcon}" />
                    </Border>
                  </Viewbox.Child>
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type Viewbox}">
                      <Style.Triggers>
                        <Trigger Property="UIElement.IsMouseOver" Value="True">
                          <Setter Property="UIElement.BitmapEffect">
                            <Setter.Value>
                              <DropShadowBitmapEffect Color="White" Direction="360" ShadowDepth="1" Softness="0.7" Opacity="1" />
                            </Setter.Value>
                          </Setter>
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                  <FrameworkElement.ToolTip>
                    <TextBlock Style="{StaticResource ToolTipText}" Text="{StaticResource WhisperModeInfoString}" />
                  </FrameworkElement.ToolTip>
                </Viewbox>
                <Viewbox Grid.Column="3" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="{Binding WhisperModeSupported, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                  <Viewbox.Child>
                    <Border Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0">
                      <ContentPresenter Content="{StaticResource AlertIcon}" />
                    </Border>
                  </Viewbox.Child>
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type Viewbox}">
                      <Style.Triggers>
                        <Trigger Property="UIElement.IsMouseOver" Value="True">
                          <Setter Property="UIElement.BitmapEffect">
                            <Setter.Value>
                              <DropShadowBitmapEffect Color="White" Direction="360" ShadowDepth="1" Softness="0.7" Opacity="1" />
                            </Setter.Value>
                          </Setter>
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                  <FrameworkElement.ToolTip>
                    <TextBlock Style="{StaticResource ToolTipText}" Text="{StaticResource WhisperModeAlertString}" />
                  </FrameworkElement.ToolTip>
                  <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDown">
                      <i:InvokeCommandAction Command="{Binding WhisperModeErrorAction}" />
                    </i:EventTrigger>
                  </i:Interaction.Triggers>
                </Viewbox>
              </Grid>
              <TextBlock Style="{StaticResource SubheaderText}" MaxWidth="250" FontSize="20" Text="{StaticResource WhisperModeFanVolumeString}" TextWrapping="WrapWithOverflow" Grid.Row="9" VerticalAlignment="Center" />
              <Grid HorizontalAlignment="Left" Row="10">
                <Grid.RowDefinitions>
                  <RowDefinition />
                  <RowDefinition Height="35" />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="135" />
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>
                <Slider Style="{StaticResource MainKCSliderStyle}" Grid.Row="1" VerticalAlignment="Center" Minimum="1" Maximum="3" Value="{Binding WhisperModeSetting, Mode=TwoWay}" IsEnabled="{Binding WhisperMode}">
                  <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseUp">
                      <i:InvokeCommandAction Command="{Binding ApplyWhisperModeType}" />
                    </i:EventTrigger>
                  </i:Interaction.Triggers>
                </Slider>
                <TextBlock Style="{StaticResource ColorPickerTitleText}" FontWeight="Light" FontSize="20" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Text="{Binding WhisperModeSetting, Converter={StaticResource WhisperModeIntToTypeStringConverter}}" />
              </Grid>
              <TextBlock Style="{StaticResource SubheaderText}" MaxWidth="250" FontSize="20" Text="{StaticResource WhisperModeMinimumFpsString}" TextWrapping="WrapWithOverflow" Grid.Row="12" />
              <Grid HorizontalAlignment="Left" Row="13">
                <Grid.RowDefinitions>
                  <RowDefinition />
                  <RowDefinition Height="35" />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="135" />
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>
                <Slider Style="{StaticResource MainKCSliderStyle}" Grid.Row="1" VerticalAlignment="Center" Minimum="30" Maximum="60" IsSnapToTickEnabled="True" TickFrequency="5" Value="{Binding WhisperModeFps, Mode=TwoWay}" IsEnabled="{Binding WhisperMode}">
                  <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseUp">
                      <i:InvokeCommandAction Command="{Binding ApplyWhisperModeFps}" />
                    </i:EventTrigger>
                  </i:Interaction.Triggers>
                </Slider>
                <TextBlock Style="{StaticResource ColorPickerTitleText}" FontWeight="Light" FontSize="20" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center">
                  <Run Text="{Binding WhisperModeFps}" /> <Run Text="{StaticResource WhisperModeMinimumFpsUnitsString}" /></TextBlock>
              </Grid>
            </Grid>
          </Grid>
          <Grid Background="{DynamicResource SecondaryBackgroundBrush}" Height="300" Width="2075" Row="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="20" />
              <RowDefinition Height="40" />
              <RowDefinition Height="250" />
              <RowDefinition Height="20" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="75" />
              <ColumnDefinition Width="875" />
              <ColumnDefinition Width="75" />
              <ColumnDefinition Width="75" />
              <ColumnDefinition Width="75" />
              <ColumnDefinition Width="850" />
              <ColumnDefinition Width="75" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{StaticResource UsageString}" Grid.Row="1" Grid.Column="1" Style="{StaticResource ColorPickerTitleText}" FontSize="28" />
            <Rectangle Style="{StaticResource VerticalSeparator}" Grid.Row="0" Grid.RowSpan="3" Grid.Column="3" HorizontalAlignment="Center" OverridesDefaultStyle="True" MaxHeight="270" />
            <TextBlock Text="{StaticResource FanSpeedString}" Grid.Row="1" Grid.Column="5" Style="{StaticResource ColorPickerTitleText}" FontSize="28" />
            <Viewbox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="250" />
                  <ColumnDefinition Width="50" />
                  <ColumnDefinition Width="250" />
                </Grid.ColumnDefinitions>
                <ContentControl VerticalAlignment="Top" prism:RegionManager.RegionName="{Binding DetailedCpuUsageRegion}" />
                <ContentControl Grid.Column="2" VerticalAlignment="Top" prism:RegionManager.RegionName="{Binding DetaileddGpuUsageRegion}" />
              </Grid>
            </Viewbox>
            <Viewbox Grid.Row="2" Grid.Column="5" Width="750" VerticalAlignment="Center" HorizontalAlignment="Center" Height="250">
              <ContentControl prism:RegionManager.RegionName="{Binding HorizontalFanRegion}" />
            </Viewbox>
          </Grid>
        </Grid>
      </Viewbox>
    </ItemsControl>
  </Grid>
</UserControl>