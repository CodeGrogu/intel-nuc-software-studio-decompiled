<Window x:Class="NucControl.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NUC Control">
  <Grid x:Name="Shell">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TitleBar x:Name="AppTitleBar" Title="NUC Control" Subtitle="Phantom Canyon">
      <TitleBar.RightHeader><Button x:Name="SettingsButton" AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings" Background="Transparent" BorderThickness="0"><FontIcon Glyph="&#xE713;" FontSize="16"/></Button></TitleBar.RightHeader>
    </TitleBar>
    <ScrollViewer x:Name="Scroller" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
      <StackPanel x:Name="Root" Padding="16,8,16,12" Spacing="6" MaxWidth="620" HorizontalAlignment="Stretch">
        <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Severity="Informational"/>
        <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel Spacing="2"><TextBlock Text="CPU" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="CpuReading" Text="Unavailable" FontSize="14"/></StackPanel>
          <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="GPU" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="GpuReading" Text="Unavailable" FontSize="14"/></StackPanel>
        </Grid>
        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,2,0,2"/>
        <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="Power" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Grid x:Name="PowerButtons" Grid.Column="1" ColumnSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions></Grid>
          <Button x:Name="CustomPowerButton" Grid.Column="2" Padding="6,4,6,4" MinWidth="32" MinHeight="32" AutomationProperties.Name="Custom power limits" ToolTipService.ToolTip="Custom power limits"><FontIcon Glyph="&#xE713;" FontSize="14"/></Button>
        </Grid>
        <TextBlock x:Name="PowerDetail" Text="Reading limits..." FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Grid ColumnSpacing="6" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="Cooling" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Grid x:Name="FanButtons" Grid.Column="1" ColumnSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions></Grid>
          <DropDownButton Grid.Column="2" Padding="6,4,6,4" MinHeight="32" AutomationProperties.Name="More cooling controls"><DropDownButton.Flyout><MenuFlyout><ToggleMenuFlyoutItem x:Name="Fixed70Button" Text="Fixed 70%" ToolTipService.ToolTip="Reviewed shared duty. Select Balanced first. Return with Balanced or Cool."/></MenuFlyout></DropDownButton.Flyout></DropDownButton>
        </Grid>
        <TextBlock x:Name="FanDetail" Text="Reading cooling..." FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,2,0,2"/>
        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Lighting" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox x:Name="Zones" Grid.Column="1" MinWidth="146" MinHeight="30" AutomationProperties.Name="Lighting zone"/></Grid>
        <TextBlock x:Name="LightDetail" Text="Read a light to edit." FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Grid x:Name="LightEditor" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock x:Name="BrightnessLabel" Text="Brightness unavailable" FontSize="12"/><Slider x:Name="Brightness" Visibility="Collapsed" Minimum="0" Maximum="100" StepFrequency="1" AutomationProperties.Name="Brightness percent"/></StackPanel>
          <Button x:Name="ColorButton" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="Choose light color"><StackPanel Orientation="Horizontal" Spacing="6"><Border x:Name="Swatch" Visibility="Collapsed" Width="16" Height="16" BorderThickness="1" BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}" CornerRadius="3"/><TextBlock x:Name="ColorLabel" Text="Unavailable"/></StackPanel></Button>
        </Grid>
        <Grid ColumnSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <DropDownButton Content="Lighting options" HorizontalAlignment="Left" Padding="8,4,8,4"><DropDownButton.Flyout><MenuFlyout><MenuFlyoutItem x:Name="AdvancedLightingButton" Text="Functions and effects..."/><MenuFlyoutItem x:Name="LightingPresetsButton" Text="Local presets..."/></MenuFlyout></DropDownButton.Flyout></DropDownButton>
          <Button x:Name="DiscardButton" Grid.Column="1" Content="Discard" Padding="8,4,8,4"/>
          <Button x:Name="ApplyButton" Grid.Column="2" Content="Apply" Padding="12,4,12,4" Style="{StaticResource AccentButtonStyle}"/>
        </Grid>
        <TextBlock x:Name="DraftLabel" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Grid ColumnSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button x:Name="StatusButton" Content="Connecting..." HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Padding="0,4,0,4" MinHeight="28" AutomationProperties.Name="Connection and operation details"/>
          <Button x:Name="ReconnectButton" Grid.Column="1" AutomationProperties.Name="Refresh connection" ToolTipService.ToolTip="Refresh (F5)" Padding="6,4,6,4" MinHeight="28"><FontIcon Glyph="&#xE72C;" FontSize="14"/></Button>
          <Button x:Name="ExitButton" Grid.Column="2" Content="Exit" Padding="6,4,6,4" MinHeight="28" ToolTipService.ToolTip="Exit NUC Control (Ctrl+Q)"/>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
