<Window x:Class="NucControl.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NUC Control">
  <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <StackPanel x:Name="Root" Padding="24,20,24,24" Spacing="12" MaxWidth="620" HorizontalAlignment="Stretch">
      <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="NUC Control" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="Phantom Canyon" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
        <Button Grid.Column="1" x:Name="SettingsButton" AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings" VerticalAlignment="Center"><FontIcon Glyph="&#xE713;" FontSize="18" /></Button>
      </Grid>
      <InfoBar x:Name="Notice" IsOpen="True" IsClosable="False" Severity="Informational" Message="Connecting to the backend…" />
      <Grid ColumnSpacing="16" RowSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
        <TextBlock Text="CPU" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Grid.Column="1" Text="GPU" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock Grid.Row="1" x:Name="CpuReading" Text="—" FontSize="16" /><TextBlock Grid.Row="1" Grid.Column="1" x:Name="GpuReading" Text="—" FontSize="16" />
      </Grid>
      <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />
      <TextBlock Text="Power" FontSize="16" FontWeight="SemiBold" />
      <Grid x:Name="PowerButtons" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions></Grid>
      <TextBlock x:Name="PowerDetail" Text="Reading firmware presets…" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      <Button x:Name="CustomPowerButton" Content="Custom limits..." HorizontalAlignment="Left" />
      <TextBlock Text="Cooling" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
      <Grid x:Name="FanButtons" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions></Grid>
      <TextBlock x:Name="FanDetail" Text="Firmware Balanced and Cool" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      <Expander Header="Advanced cooling" HorizontalAlignment="Stretch"><StackPanel Spacing="8"><ToggleButton x:Name="Fixed70Button" Content="Fixed 70%" HorizontalAlignment="Left" /><TextBlock Text="Reviewed shared-control command. Select Balanced first; choose Balanced or Cool to return to automatic cooling. Other fixed duties and custom curves are not validated." TextWrapping="Wrap" /></StackPanel></Expander>
      <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />
      <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="Lighting" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
        <ComboBox x:Name="Zones" Grid.Column="1" MinWidth="152" AutomationProperties.Name="Lighting zone" />
      </Grid>
      <TextBlock x:Name="LightDetail" Text="Select a light to inspect its current settings." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="AdvancedLightingButton" Content="Advanced lighting..." /><Button x:Name="LightingPresetsButton" Content="Presets..." /></StackPanel>
      <Grid x:Name="LightEditor" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Spacing="4"><TextBlock x:Name="BrightnessLabel" Text="Brightness unavailable" /><Slider x:Name="Brightness" Visibility="Collapsed" Minimum="0" Maximum="100" StepFrequency="1" AutomationProperties.Name="Brightness percent" /></StackPanel>
        <Button x:Name="ColorButton" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="Choose light color"><StackPanel Orientation="Horizontal" Spacing="8"><Border x:Name="Swatch" Visibility="Collapsed" Width="20" Height="20" BorderThickness="1" BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}" CornerRadius="3" /><TextBlock x:Name="ColorLabel" Text="Color unavailable" /></StackPanel></Button>
      </Grid>
      <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock x:Name="DraftLabel" Text="" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Button x:Name="DiscardButton" Grid.Column="1" Content="Discard" />
        <Button x:Name="ApplyButton" Grid.Column="2" Content="Apply" Style="{StaticResource AccentButtonStyle}" />
      </Grid>
      <Button x:Name="ReconnectButton" Content="Refresh connection" HorizontalAlignment="Left" Margin="0,4,0,0" />
    </StackPanel>
  </ScrollViewer>
</Window>
