<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/NucControl.ico</ApplicationIcon>
    <AssemblyName>NucControl</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Content Update="Assets/NucControl.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="../NucControl.Core/NucControl.Core.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
  </ItemGroup>
  <!-- WinUI copies these to build output for AppX packaging, but this unpackaged
       frontend uses .NET publish. Include the generated payload explicitly. -->
  <Target Name="PublishWinUiResources" AfterTargets="ComputeFilesToPublish" DependsOnTargets="ComputeProcessXamlFiles">
    <ItemGroup>
      <_NucWinUiResources Include="@(GeneratedXamlDest)" />
      <_NucWinUiResources Include="$(ProjectPriFullPath)" />
    </ItemGroup>
    <Error Condition="!Exists('%(_NucWinUiResources.Identity)')" Text="Required WinUI runtime resource is missing: %(_NucWinUiResources.Identity)" />
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_NucWinUiResources)">
        <RelativePath>$([MSBuild]::MakeRelative('$(TargetDir)', '%(_NucWinUiResources.FullPath)'))</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
