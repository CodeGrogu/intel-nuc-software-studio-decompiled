<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>
  <appSettings>
    <add key="SystemMonitorInterval" value="2" />
  </appSettings>
  <system.serviceModel>
    <behaviors>
      <serviceBehaviors>
        <behavior name="mexBehaviour">
          <serviceMetadata httpGetEnabled="true" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <services>
      <service name="NucSoftwareStudioService.FeatureSupport.Services.AppSettingsService" behaviorConfiguration="mexBehaviour">
        <endpoint binding="wsHttpBinding" contract="NucSoftwareStudioService.Wcf.IAppSettingsServiceContract"></endpoint>
      </service>
      <service name="NucSoftwareStudioService.LedControl.Services.AlexaStateService" behaviorConfiguration="mexBehaviour">
        <endpoint binding="wsHttpBinding" contract="NucSoftwareStudioService.Wcf.IAlexaStateServiceContract"></endpoint>
      </service>
      <service name="NucSoftwareStudioService.LedControl.Services.AlexaSettingsService" behaviorConfiguration="mexBehaviour">
        <endpoint binding="wsHttpBinding" contract="NucSoftwareStudioService.Wcf.IAlexaSettingsServiceContract"></endpoint>
      </service>
      <service name="NucSoftwareStudioService.LedControl.Services.NucLedService" behaviorConfiguration="mexBehaviour">
        <endpoint binding="wsHttpBinding" contract="NucSoftwareStudioService.Wcf.INucLedServiceContract"></endpoint>
      </service>
      <service name="NucSoftwareStudioService.SystemMonitor.Services.SystemMonitorService" behaviorConfiguration="mexBehaviour">
        <endpoint binding="wsDualHttpBinding" contract="NucSoftwareStudioService.Wcf.ISystemMonitorServiceContract"></endpoint>
        <endpoint binding="netNamedPipeBinding" contract="NucSoftwareStudioService.Wcf.ISystemMonitorServiceContract" />
      </service>
      <service name="NucSoftwareStudioService.LedControl.Services.ArduinoService" behaviorConfiguration="mexBehaviour">
        <endpoint binding="wsHttpBinding" contract="NucSoftwareStudioService.Wcf.IArduinoServiceContract"></endpoint>
      </service>
      <service name="NucSoftwareStudioService.PerformanceTuning.Services.PerformanceTuningService" behaviorConfiguration="mexBehaviour">
        <endpoint binding="wsHttpBinding" contract="NucSoftwareStudioService.Wcf.IPerformanceTuningServiceContract"></endpoint>
      </service>
      <service name="NucSoftwareStudioService.LedControl.Services.EneService" behaviorConfiguration="mexBehaviour">
        <endpoint binding="wsHttpBinding" contract="NucSoftwareStudioService.Wcf.IEneServiceContract"></endpoint>
      </service>
    </services>
  </system.serviceModel>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Numerics.Vectors" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.1.4.0" newVersion="4.1.4.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>